<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="View Range Helper"
        Height="980" Width="1600"
        WindowStartupLocation="CenterScreen"
        Background="#F7FAFC"
        FontFamily="Segoe UI" FontSize="12"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- ===== Shared text styles (matches AlignViews / View Templates Manager) ===== -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A202C"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A5568"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>

        <Style x:Key="HelperText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#718096"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="MonoText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#2D3748"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="26"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2B6CB0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>

        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <Style x:Key="WarnButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="#FEFCBF"/>
            <Setter Property="BorderBrush" Value="#D69E2E"/>
            <Setter Property="Foreground" Value="#744210"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>

        <!-- Color swatch for the per-plane row -->
        <Style x:Key="PlaneSwatch" TargetType="Border">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ===================== HEADER (dbHMS branded) ===================== -->
        <Border DockPanel.Dock="Top" Background="#2D3748" Padding="20,14">
            <Grid>
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="View Range Helper" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Visualize and edit the active plan view's view range &#x2014; live, with a real-model section preview."
                               Foreground="#CBD5E0" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Opacity="0.85">
                    <TextBlock Text="db" Foreground="#00BFFF" FontSize="32"
                               FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <TextBlock Text=" | " Foreground="#7A8FA6" FontSize="32"
                               FontWeight="Light" VerticalAlignment="Center"/>
                    <TextBlock Text="HMS" Foreground="#00BFFF" FontSize="32"
                               FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== TEMPLATE-LOCK BANNER (hidden unless locked) ===================== -->
        <Border x:Name="bnr_template_lock" DockPanel.Dock="Top"
                Background="#FFFBEA" BorderBrush="#D69E2E" BorderThickness="0,0,0,1"
                Padding="16,10" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="txt_lock_title" Text="View range is controlled by a view template"
                               FontWeight="SemiBold" Foreground="#744210"/>
                    <TextBlock x:Name="txt_lock_detail"
                               Text="Editing is disabled. Detach this view's view range from the template, or open the template to edit it there."
                               Foreground="#744210" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btn_detach_view_range" Content="Detach view range from template"
                            Style="{StaticResource WarnButton}" Padding="10,4" Margin="0,0,6,0"/>
                    <Button x:Name="btn_edit_template_vr" Content="Edit template's view range"
                            Style="{StaticResource WarnButton}" Padding="10,4" Margin="0,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== FOOTER ===================== -->
        <Border DockPanel.Dock="Bottom" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock x:Name="txt_status" Text="" Foreground="#4A5568"
                               VerticalAlignment="Center" FontStyle="Italic"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btn_revert" Content="Revert" Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="btn_close" Content="Close" Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="btn_apply" Content="Apply to View" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== MAIN CONTENT ===================== -->
        <Grid Margin="20,16,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============== LEFT: Numeric editor (Revit-native style) ============== -->
            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Active View" Style="{StaticResource SectionHeader}"/>
                        <TextBlock x:Name="txt_view_name" Text="-" FontWeight="SemiBold"
                                   Foreground="#2D3748" FontSize="13"/>
                        <TextBlock x:Name="txt_view_meta" Text="" Style="{StaticResource HelperText}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}">
                    <StackPanel x:Name="pnl_editor">
                        <TextBlock Text="View Range" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Drag the lines on the section to the right, or type values here. Both stay in sync."
                                   Style="{StaticResource HelperText}"/>

                        <!-- Column headers -->
                        <Grid Margin="0,12,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="76"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="78"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="Plane"   Style="{StaticResource FieldLabel}" Margin="0,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="Level"   Style="{StaticResource FieldLabel}" Margin="0,0,0,0"/>
                            <TextBlock Grid.Column="3" Text="Offset"  Style="{StaticResource FieldLabel}" Margin="0,0,0,0"/>
                        </Grid>

                        <!-- TOP -->
                        <Grid Margin="0,2,0,2" x:Name="row_top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="76"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="78"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#38A169" Style="{StaticResource PlaneSwatch}"/>
                            <TextBlock Grid.Column="1" Text="Top"        VerticalAlignment="Center" Foreground="#2D3748"/>
                            <ComboBox  Grid.Column="2" x:Name="cmb_top_level"   Margin="0,0,6,0"/>
                            <TextBox   Grid.Column="3" x:Name="txt_top_offset"  ToolTip="Offset (feet, decimal or feet/inches like 7'-6&quot;)"/>
                        </Grid>

                        <!-- CUT PLANE -->
                        <Grid Margin="0,2,0,2" x:Name="row_cut">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="76"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="78"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#E53E3E" Style="{StaticResource PlaneSwatch}"/>
                            <TextBlock Grid.Column="1" Text="Cut Plane"  VerticalAlignment="Center" Foreground="#2D3748" FontWeight="SemiBold"/>
                            <ComboBox  Grid.Column="2" x:Name="cmb_cut_level"   Margin="0,0,6,0"/>
                            <TextBox   Grid.Column="3" x:Name="txt_cut_offset"/>
                        </Grid>

                        <!-- BOTTOM -->
                        <Grid Margin="0,2,0,2" x:Name="row_bot">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="76"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="78"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#3182CE" Style="{StaticResource PlaneSwatch}"/>
                            <TextBlock Grid.Column="1" Text="Bottom"     VerticalAlignment="Center" Foreground="#2D3748"/>
                            <ComboBox  Grid.Column="2" x:Name="cmb_bot_level"   Margin="0,0,6,0"/>
                            <TextBox   Grid.Column="3" x:Name="txt_bot_offset"/>
                        </Grid>

                        <!-- VIEW DEPTH -->
                        <Grid Margin="0,2,0,2" x:Name="row_vd">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="76"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="78"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#805AD5" Style="{StaticResource PlaneSwatch}"/>
                            <TextBlock Grid.Column="1" Text="View Depth" VerticalAlignment="Center" Foreground="#2D3748"/>
                            <ComboBox  Grid.Column="2" x:Name="cmb_vd_level"    Margin="0,0,6,0"/>
                            <TextBox   Grid.Column="3" x:Name="txt_vd_offset"/>
                        </Grid>

                        <!-- Validation message -->
                        <Border Background="#FFF5F5" BorderBrush="#FC8181" BorderThickness="1"
                                CornerRadius="3" Padding="8" Margin="0,10,0,0"
                                x:Name="bnr_validation" Visibility="Collapsed">
                            <TextBlock x:Name="txt_validation" Foreground="#742A2A" TextWrapping="Wrap" FontSize="11"/>
                        </Border>

                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Top"
                        Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="4" Padding="10,4" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="72"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="chk_snap" Grid.Column="0" Content="Snap to nearest"
                                  IsChecked="True" VerticalAlignment="Center"/>
                        <TextBox  x:Name="txt_snap_distance" Grid.Column="2"
                                  Height="22" VerticalAlignment="Center"
                                  ToolTip="Snap distance for plane drags, far clip, and section extent. Accepts feet/inches (6&quot;, 1'-0&quot;, 0.5)."/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Tips" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Style="{StaticResource HelperText}" Margin="0,0,0,4">
                            &#x2022; Drag the colored lines in the section view to raise / lower each plane.
                        </TextBlock>
                        <TextBlock Style="{StaticResource HelperText}" Margin="0,0,0,4">
                            &#x2022; Drag the red section line on the plan to slide it; drag an endpoint to rotate or extend.
                        </TextBlock>
                        <TextBlock Style="{StaticResource HelperText}" Margin="0,0,0,4">
                            &#x2022; Drag the gray handle on the far-clip line to change how far ahead the section sees.
                        </TextBlock>
                        <TextBlock Style="{StaticResource HelperText}" Margin="0,0,0,4">
                            &#x2022; Drag the gray triangles on the section's right edge to control how much above / below shows.
                        </TextBlock>
                        <TextBlock Style="{StaticResource HelperText}" Margin="0,0,0,4">
                            &#x2022; Offsets accept decimal feet (7.5) or feet/inches (7'-6&quot; or 7' 6&quot;).
                        </TextBlock>
                        <TextBlock Style="{StaticResource HelperText}">
                            &#x2022; Hit Apply to write changes to the view, or Revert to discard.
                        </TextBlock>
                    </StackPanel>
                </Border>
            </DockPanel>

            <!-- ============== RIGHT: Plan + Section side-by-side canvases ============== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- PLAN -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Plan (Active View)" Style="{StaticResource SectionHeader}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="btn_reset_zoom" Content="Reset zoom"
                                        Style="{StaticResource MiniButton}" ToolTip="Reset plan zoom and pan to default"/>
                                <Button x:Name="btn_recenter_section"  Content="Recenter section line"
                                        Style="{StaticResource MiniButton}" ToolTip="Reset section line to span the crop region"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="txt_plan_hint" DockPanel.Dock="Bottom"
                                   Style="{StaticResource HelperText}" Margin="0,6,0,0"
                                   Text="Mouse wheel = zoom. Middle-click drag = pan. Drag the red section line / bubbles / far-clip handle as usual."/>
                        <Border BorderBrush="#CBD5E0" BorderThickness="1" Background="White" CornerRadius="3"
                                ClipToBounds="True">
                            <Grid x:Name="grd_plan">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform     x:Name="trf_plan_scale" ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform x:Name="trf_plan_pan"   X="0" Y="0"/>
                                    </TransformGroup>
                                </Grid.RenderTransform>
                                <Image  x:Name="img_plan" Stretch="Uniform"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                <Canvas x:Name="cnv_plan" Background="Transparent" ClipToBounds="False"/>
                            </Grid>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- SECTION -->
                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Section" Style="{StaticResource SectionHeader}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="btn_reset_section_zoom" Content="Reset zoom"
                                        Style="{StaticResource MiniButton}"
                                        ToolTip="Reset section zoom and pan to default"/>
                                <Button x:Name="btn_refresh_render" Content="&#x21BB; Refresh"
                                        Style="{StaticResource MiniButton}"
                                        ToolTip="Re-render the Revit section now (also auto-refreshes after section line / far clip drags)"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="txt_section_hint" DockPanel.Dock="Bottom"
                                   Style="{StaticResource HelperText}" Margin="0,6,0,0"
                                   Text="Drag the colored lines to move each view-range plane. Mouse wheel zoom, middle-click to pan."/>
                        <Border BorderBrush="#CBD5E0" BorderThickness="1" Background="White" CornerRadius="3"
                                ClipToBounds="True">
                            <Grid>
                                <!-- Inner grid: image + content overlay, transformed together so
                                     model-anchored elements (plane lines, A/B chips, levels)
                                     scale + pan with the rendered image. -->
                                <Grid x:Name="grd_section">
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform     x:Name="trf_sec_scale" ScaleX="1" ScaleY="1"/>
                                            <TranslateTransform x:Name="trf_sec_pan"   X="0" Y="0"/>
                                        </TransformGroup>
                                    </Grid.RenderTransform>
                                    <Image  x:Name="img_section" Stretch="Uniform"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                    <Canvas x:Name="cnv_section" Background="Transparent" ClipToBounds="False"/>
                                </Grid>
                                <!-- Outer overlay canvas: NOT transformed. Holds plane labels
                                     ("Top -7'-6\"" etc.) so they stay glued to the right edge
                                     of the visible card no matter how the user zooms / pans. -->
                                <Canvas x:Name="cnv_section_screen" Background="Transparent"
                                        IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
