<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="V/G Overrides &#x2014; Filters"
        Height="700" Width="980"
        MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        Background="#F7FAFC"
        FontFamily="Segoe UI" FontSize="12"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A202C"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A5568"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style x:Key="HelperText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#718096"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="26"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2B6CB0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="ColorSwatch" TargetType="Border">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="BorderBrush" Value="#A0AEC0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2D3748" Padding="20,12">
            <StackPanel>
                <TextBlock Text="V/G Overrides &#x2014; Filters"
                           Foreground="White" FontSize="16" FontWeight="Bold"/>
                <TextBlock Foreground="#CBD5E0" FontSize="11" Margin="0,2,0,0"
                           Text="Add, remove, toggle, and override graphics for filters applied to this template."/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="txt_flt_status"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Foreground="#4A5568" FontStyle="Italic"
                           Margin="0,0,12,0" TextTrimming="CharacterEllipsis"
                           Text=""/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btn_flt_cancel" Content="Cancel" Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="btn_flt_ok" Content="OK" Style="{StaticResource PrimaryButton}"
                            IsEnabled="False" ToolTip="Wiring coming in iteration 3"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="320"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: filter list applied to template -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Applied Filters" Style="{StaticResource SectionHeader}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="btn_flt_add"    Content="Add&#x2026;"   Style="{StaticResource MiniButton}"/>
                            <Button x:Name="btn_flt_remove" Content="Remove"        Style="{StaticResource MiniButton}"/>
                            <Button x:Name="btn_flt_up"     Content="&#x2191;"      Style="{StaticResource MiniButton}"
                                    ToolTip="Move filter up (priority)"/>
                            <Button x:Name="btn_flt_down"   Content="&#x2193;"      Style="{StaticResource MiniButton}"
                                    ToolTip="Move filter down"/>
                        </StackPanel>
                    </Grid>
                    <Border DockPanel.Dock="Top" Background="#F7FAFC" BorderBrush="#E2E8F0"
                            BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Legend: " Style="{StaticResource HelperText}"
                                       VerticalAlignment="Center"/>
                            <CheckBox IsChecked="True" IsHitTestVisible="False" Focusable="False"
                                      VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="on every selected template" Style="{StaticResource HelperText}"
                                       VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <CheckBox IsChecked="False" IsHitTestVisible="False" Focusable="False"
                                      VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="on none" Style="{StaticResource HelperText}"
                                       VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <CheckBox x:Name="chk_legend_mixed" IsThreeState="True"
                                      IsHitTestVisible="False" Focusable="False"
                                      VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="mixed (some but not all)" Style="{StaticResource HelperText}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Grid DockPanel.Dock="Top" Background="#EDF2F7" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Filter name" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#2D3748" Padding="6,4"/>
                        <TextBlock Grid.Column="1" Text="Enabled" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#2D3748" Padding="6,4" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="Visible" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#2D3748" Padding="6,4" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="Override" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#2D3748" Padding="6,4" HorizontalAlignment="Center"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="pnl_filters"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- RIGHT: filter override editor -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="txt_flt_selected" Text="Select a filter"
                                   Style="{StaticResource SectionHeader}" TextWrapping="Wrap"/>
                        <StackPanel x:Name="pnl_flt_selected_names" Margin="0,2,0,0"/>
                        <TextBlock Style="{StaticResource HelperText}"
                                   Text="Click a filter row to edit its graphic overrides on this template. Shift- or ctrl-click to multi-select."/>

                        <Border Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="3" Padding="10" Margin="0,10,0,12">
                            <StackPanel>
                                <CheckBox x:Name="chk_flt_visible"  Content="Visible"  IsChecked="True"/>
                                <CheckBox x:Name="chk_flt_enabled"  Content="Enabled"  IsChecked="True"/>
                                <CheckBox x:Name="chk_flt_halftone" Content="Halftone"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Transparency"
                                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" x:Name="sld_flt_transparency" Minimum="0" Maximum="100"
                                                Value="0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="txt_flt_transparency_val" Text="0%"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Lines" Style="{StaticResource SectionHeader}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Weight"
                                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="cmb_flt_weight"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Color"
                                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <Button    Grid.Row="1" Grid.Column="1" x:Name="btn_flt_color" Height="26"
                                               HorizontalContentAlignment="Left" Padding="6,2">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource ColorSwatch}" Background="Black"/>
                                            <TextBlock x:Name="txt_flt_color" Text="Black" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Pattern"
                                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <ComboBox  Grid.Row="2" Grid.Column="1" x:Name="cmb_flt_pattern"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Patterns" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="Surface Foreground" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" x:Name="cmb_flt_surf_pattern" Margin="0,0,8,0"/>
                                    <Button   Grid.Column="1" x:Name="btn_flt_surf_color" Height="26"
                                              HorizontalContentAlignment="Left" Padding="6,2">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource ColorSwatch}" Background="#888"/>
                                            <TextBlock Text="Color" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="Cut Foreground" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" x:Name="cmb_flt_cut_pattern" Margin="0,0,8,0"/>
                                    <Button   Grid.Column="1" x:Name="btn_flt_cut_color" Height="26"
                                              HorizontalContentAlignment="Left" Padding="6,2">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource ColorSwatch}" Background="#888"/>
                                            <TextBlock Text="Color" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="3" Padding="8">
                            <StackPanel>
                                <Button x:Name="btn_flt_reset" Content="Reset Overrides"
                                        Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                        MinWidth="160"/>
                                <TextBlock Style="{StaticResource HelperText}" Margin="0,6,0,0"
                                           Text="Clears graphic overrides for the selected filter but leaves it applied."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
