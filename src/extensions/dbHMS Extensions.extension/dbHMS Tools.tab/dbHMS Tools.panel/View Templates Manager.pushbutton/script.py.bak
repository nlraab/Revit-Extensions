# -*- coding: utf-8 -*-
"""View Templates Manager — All-in-one view template management for Revit.

Features:
  - List all view templates with type, scale, and usage count
  - Rename, duplicate, and delete view templates
  - Apply view templates to views in the project
  - Properties tab: edit scale, detail level, discipline, parts visibility
  - VG Overrides tab: show/hide model and annotation categories per template
  - Revit Links tab: view and set per-link display type (By Host View / By Linked View)
  - Bulk Edit tab: apply setting changes across ALL selected templates at once
      * Scale, detail level
      * Hide/show specific categories
      * Set Revit links to By Host View (inheriting host VG settings)
  - Usage tab: see which views use each template
"""
__title__ = "View Templates\nManager"
__doc__ = "Manage view templates: edit, duplicate, apply, and bulk-modify across the project."

import clr
import re
import sys
import traceback

clr.AddReference("RevitAPI")
