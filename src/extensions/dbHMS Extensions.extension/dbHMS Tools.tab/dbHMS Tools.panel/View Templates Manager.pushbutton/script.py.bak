class TemplateItem(INotifyPropertyChanged):
    def __init__(self, view, usage_count=0):
        self._view         = view
        self._is_selected  = False
        self._usage_count  = usage_count
        self._handlers     = []

    # INotifyPropertyChanged
    def add_PropertyChanged(self, handler):
        self._handlers.append(handler)
    def remove_PropertyChanged(self, handler):
        if handler in self._handlers:
            self._handlers.remove(handler)
    def _notify(self, prop):
        args = PropertyChangedEventArgs(prop)
        for h in self._handlers:
            h(self, args)

    @property
    def View(self):
        return self._view

    @property
    def Id(self):
        return self._view.Id

    @property
    def Name(self):
        return self._view.Name

    @property
    def ViewTypeName(self):
        try:
            return viewtype_label(self._view.ViewType)
        except Exception:
            return "-"

    @property
    def Scale(self):
        try:
            s = self._view.Scale
            return scale_label(s)
        except Exception:
            return "-"

    @property
    def UsedBy(self):
        return self._usage_count

    @property
    def IsSelected(self):
        return self._is_selected

    @IsSelected.setter
    def IsSelected(self, value):
        if self._is_selected != value:
            self._is_selected = value
            self._notify("IsSelected")


class CategoryVisItem(INotifyPropertyChanged):
    def __init__(self, name, cat_id, is_hidden):
        self._name      = name
        self._cat_id    = cat_id
        self._is_hidden = is_hidden
        self._handlers  = []

    def add_PropertyChanged(self, handler):
        self._handlers.append(handler)
    def remove_PropertyChanged(self, handler):
        if handler in self._handlers:
            self._handlers.remove(handler)
    def _notify(self, prop):
        args = PropertyChangedEventArgs(prop)
        for h in self._handlers:
            h(self, args)

    @property
    def Name(self):   return self._name
    @property
    def CatId(self):  return self._cat_id
    @property
    def IsHidden(self): return self._is_hidden
    @IsHidden.setter
    def IsHidden(self, v):
        if self._is_hidden != v:
            self._is_hidden = v
            self._notify("IsHidden")
    @property
    def IsVisible(self): return not self._is_hidden
    @IsVisible.setter
    def IsVisible(self, v):
        self.IsHidden = not v


class LinkDisplayItem(INotifyPropertyChanged):
    def __init__(self, link_name, link_id, display_type):
        self._link_name    = link_name
        self._link_id      = link_id
        self._display_type = display_type
        self._handlers     = []

    def add_PropertyChanged(self, handler):
        self._handlers.append(handler)
    def remove_PropertyChanged(self, handler):
        if handler in self._handlers:
            self._handlers.remove(handler)
    def _notify(self, prop):
        args = PropertyChangedEventArgs(prop)
        for h in self._handlers:
            h(self, args)

    @property
    def LinkName(self):    return self._link_name
    @property
    def LinkId(self):      return self._link_id
    @property
    def DisplayType(self): return self._display_type


class BulkCatItem(INotifyPropertyChanged):
    """Represents one category override row in the Bulk Edit panel."""
    def __init__(self, name, cat_id, hide=True):
        self._name     = name
        self._cat_id   = cat_id
        self._hide     = hide
        self._handlers = []

    def add_PropertyChanged(self, handler):
        self._handlers.append(handler)
    def remove_PropertyChanged(self, handler):
        if handler in self._handlers:
            self._handlers.remove(handler)
    def _notify(self, prop):
        args = PropertyChangedEventArgs(prop)
        for h in self._handlers:
            h(self, args)

    @property
    def Name(self):  return self._name
    @property
    def CatId(self): return self._cat_id
    @property
    def Hide(self):  return self._hide
    @Hide.setter
    def Hide(self, v):
        if self._hide != v:
            self._hide = v
            self._notify("Hide")
    @property
    def ActionLabel(self): return "Hide" if self._hide else "Show"


class BulkLinkItem(INotifyPropertyChanged):
    """Represents one Revit Link in the bulk-edit link panel."""
    def __init__(self, name, link_id, apply=False):
        self._name     = name
        self._link_id  = link_id
        self._apply    = apply
        self._handlers = []

    def add_PropertyChanged(self, handler):
        self._handlers.append(handler)
    def remove_PropertyChanged(self, handler):
        if handler in self._handlers:
            self._handlers.remove(handler)
    def _notify(self, prop):
        args = PropertyChangedEventArgs(prop)
        for h in self._handlers:
            h(self, args)

    @property
    def Name(self):   return self._name
    @property
    def LinkId(self): return self._link_id
    @property
    def Apply(self):  return self._apply
    @Apply.setter
    def Apply(self, v):
        if self._apply != v:
            self._apply = v
            self._notify("Apply")


