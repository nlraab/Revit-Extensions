# ═══════════════════════════════════════════════════════════════
# USAGE ROW  (plain object for usage DataGrid)
# ═══════════════════════════════════════════════════════════════

class UsageRow(object):
    def __init__(self, view_name, view_type, sheet_ref):
        self.ViewName  = view_name
        self.ViewType  = view_type
        self.SheetRef  = sheet_ref


class ApplyViewRow(INotifyPropertyChanged):
    def __init__(self, view, current_template_name):
        self._view             = view
        self._is_checked       = False
        self._current_template = current_template_name
        self._handlers         = []

    def add_PropertyChanged(self, handler):
        self._handlers.append(handler)
    def remove_PropertyChanged(self, handler):
        if handler in self._handlers:
            self._handlers.remove(handler)
    def _notify(self, prop):
        args = PropertyChangedEventArgs(prop)
        for h in self._handlers:
            h(self, args)

    @property
    def View(self):  return self._view
    @property
    def ViewName(self): return self._view.Name
    @property
    def TypeLabel(self): return viewtype_label(self._view.ViewType)
    @property
    def CurrentTemplate(self): return self._current_template
    @property
    def IsChecked(self): return self._is_checked
    @IsChecked.setter
    def IsChecked(self, v):
        if self._is_checked != v:
            self._is_checked = v
            self._notify("IsChecked")


# ═══════════════════════════════════════════════════════════════
# MAIN WINDOW CLASS
# ═══════════════════════════════════════════════════════════════

class ViewTemplateManagerWindow(Window):

    def __init__(self):
        # Parse XAML
        self._root = Markup.XamlReader.Parse(MAIN_XAML)
        self.Content         = self._root.Content
        self.Width           = self._root.Width
        self.Height          = self._root.Height
        self.Title           = self._root.Title
        self.WindowStartupLocation = self._root.WindowStartupLocation
        self.Background      = self._root.Background
        self.FontFamily      = self._root.FontFamily
        self.FontSize        = self._root.FontSize
        self.ResizeMode      = self._root.ResizeMode

        # Bind to Revit window
        try:
            helper = WindowInteropHelper(self)
            helper.Owner = System.Diagnostics.Process.GetCurrentProcess().MainWindowHandle
        except Exception:
            pass

        # Find controls
        def F(name): return self._root.FindName(name)

        self.txt_search          = F("txt_search")
        self.ph_search           = F("ph_search")
        self.cmb_type_filter     = F("cmb_type_filter")
        self.btn_new             = F("btn_new")
        self.btn_rename          = F("btn_rename")
        self.btn_dup             = F("btn_dup")
        self.btn_delete          = F("btn_delete")
        self.btn_apply           = F("btn_apply")
        self.btn_sel_all         = F("btn_sel_all")
        self.btn_sel_none        = F("btn_sel_none")
        self.dg_templates        = F("dg_templates")
        self.lbl_selected_header = F("lbl_selected_header")
        self.tab_main            = F("tab_main")
        # Properties
        self.txt_prop_name       = F("txt_prop_name")
        self.btn_prop_rename     = F("btn_prop_rename")
        self.lbl_prop_type       = F("lbl_prop_type")
        self.cmb_prop_scale      = F("cmb_prop_scale")
        self.cmb_prop_detail     = F("cmb_prop_detail")
        self.cmb_prop_parts      = F("cmb_prop_parts")
        self.cmb_prop_discipline = F("cmb_prop_discipline")
        self.btn_prop_save       = F("btn_prop_save")
        self.lbl_prop_status     = F("lbl_prop_status")
        # VG
        self.rb_vg_model         = F("rb_vg_model")
        self.rb_vg_ann           = F("rb_vg_ann")
        self.btn_vg_reload       = F("btn_vg_reload")
        self.lbl_vg_info         = F("lbl_vg_info")
        self.txt_vg_search       = F("txt_vg_search")
        self.btn_vg_show_all     = F("btn_vg_show_all")
        self.btn_vg_hide_all     = F("btn_vg_hide_all")
        self.dg_vg_cats          = F("dg_vg_cats")
        # Links
        self.dg_links            = F("dg_links")
        self.btn_link_set_host   = F("btn_link_set_host")
        self.btn_links_reload    = F("btn_links_reload")
        self.lbl_links_status    = F("lbl_links_status")
        # Bulk
        self.lbl_bulk_header     = F("lbl_bulk_header")
        self.lbl_bulk_count      = F("lbl_bulk_count")
        self.chk_bulk_scale      = F("chk_bulk_scale")
        self.cmb_bulk_scale      = F("cmb_bulk_scale")
        self.chk_bulk_detail     = F("chk_bulk_detail")
        self.cmb_bulk_detail     = F("cmb_bulk_detail")
        self.chk_bulk_parts      = F("chk_bulk_parts")
        self.cmb_bulk_parts      = F("cmb_bulk_parts")
        self.dg_bulk_cats        = F("dg_bulk_cats")
        self.btn_bulk_add_hide_cat  = F("btn_bulk_add_hide_cat")
        self.btn_bulk_add_show_cat  = F("btn_bulk_add_show_cat")
        self.btn_bulk_remove_cat    = F("btn_bulk_remove_cat")
        self.dg_bulk_links       = F("dg_bulk_links")
        self.btn_bulk_apply      = F("btn_bulk_apply")
        self.lbl_bulk_status     = F("lbl_bulk_status")
        # Usage
        self.lbl_usage_header    = F("lbl_usage_header")
        self.dg_usage            = F("dg_usage")
        self.lbl_status          = F("lbl_status")

        # Collections
        self._all_items      = ObservableCollection[object]()
        self._filtered_items = ObservableCollection[object]()
        self._vg_items       = ObservableCollection[object]()
        self._vg_all         = []   # full unfiltered list
        self._link_items     = ObservableCollection[object]()
        self._bulk_cat_items = ObservableCollection[object]()
        self._bulk_link_items= ObservableCollection[object]()
        self._usage_items    = ObservableCollection[object]()
        self._av_items       = ObservableCollection[object]()

        # State
        self._usage_map      = {}
        self._all_templates  = []
        self._link_instances = []
        self._model_cats     = []
        self._ann_cats       = []
        self._current_template = None   # single-selected
        self._suppress_vg_changes = False
        self._scales = [
            ("1:1",1),("1:2",2),("1:5",5),("1:10",10),("1:20",20),
            ("1:25",25),("1:30",30),("1:40",40),("1:50",50),("1:60",60),
            ("1:75",75),("1:100",100),("1:120",120),("1:150",150),
            ("1:200",200),("1:240",240),("1:250",250),("1:300",300),
            ("1:400",400),("1:500",500),("1:600",600),("1:800",800),
            ("1:1000",1000),("1:1250",1250),("1:2000",2000),
        ]

        # Wire events
        self.dg_templates.SelectionChanged += self._on_template_selection_changed
        self.txt_search.TextChanged        += self._on_search_changed
        self.txt_search.GotFocus           += lambda s, e: setattr(self.ph_search, 'Visibility', Visibility.Collapsed)
        self.txt_search.LostFocus          += lambda s, e: self._toggle_placeholder()
        self.cmb_type_filter.SelectionChanged += self._on_type_filter_changed

        self.btn_new.Click           += self._on_new_click
        self.btn_rename.Click        += self._on_rename_click
        self.btn_dup.Click           += self._on_dup_click
        self.btn_delete.Click        += self._on_delete_click
        self.btn_apply.Click         += self._on_apply_to_views_click
        self.btn_sel_all.Click       += lambda s, e: self._select_all(True)
        self.btn_sel_none.Click      += lambda s, e: self._select_all(False)
        self.tab_main.SelectionChanged += self._on_tab_changed

        # Properties tab
        self.btn_prop_rename.Click   += self._on_rename_click
        self.btn_prop_save.Click     += self._on_prop_save_click

        # VG tab
        self.btn_vg_reload.Click     += self._on_vg_reload_click
        self.rb_vg_model.Checked     += lambda s, e: self._reload_vg_list()
        self.rb_vg_ann.Checked       += lambda s, e: self._reload_vg_list()
        self.txt_vg_search.TextChanged += self._on_vg_search_changed
        self.btn_vg_show_all.Click   += lambda s, e: self._vg_set_all(visible=True)
        self.btn_vg_hide_all.Click   += lambda s, e: self._vg_set_all(visible=False)

        # Links tab
        self.btn_link_set_host.Click += self._on_link_set_host_click
        self.btn_links_reload.Click  += lambda s, e: self._load_links_tab()

        # Bulk tab
        self.btn_bulk_add_hide_cat.Click += lambda s, e: self._bulk_add_cat(hide=True)
        self.btn_bulk_add_show_cat.Click += lambda s, e: self._bulk_add_cat(hide=False)
        self.btn_bulk_remove_cat.Click   += self._bulk_remove_cat
        self.btn_bulk_apply.Click        += self._on_bulk_apply_click

        # Bind collections
        self.dg_templates.ItemsSource = self._filtered_items
        self.dg_vg_cats.ItemsSource   = self._vg_items
        self.dg_links.ItemsSource     = self._link_items
        self.dg_bulk_cats.ItemsSource = self._bulk_cat_items
        self.dg_bulk_links.ItemsSource= self._bulk_link_items
        self.dg_usage.ItemsSource     = self._usage_items

        # Populate scale combo for properties + bulk
        for lbl, val in self._scales:
            item = ComboBoxItem()
            item.Content = lbl
            item.Tag     = val
            self.cmb_prop_scale.Items.Add(item)
        for lbl, val in self._scales:
            item = ComboBoxItem()
            item.Content = lbl
            item.Tag     = val
            self.cmb_bulk_scale.Items.Add(item)

        # Load data
        self._load_all()

    # ─────────────────────────────────────────────
    # DATA LOADING
    # ─────────────────────────────────────────────

    def _load_all(self):
        self._usage_map      = build_usage_map(doc)
        self._all_templates  = get_all_templates(doc)
        self._link_instances = get_link_instances(doc)
        self._model_cats     = get_mech_categories(doc)
        self._ann_cats       = get_annotation_categories(doc)

        # Rebuild all_items
        self._all_items.Clear()
        for vt in self._all_templates:
            usage = self._usage_map.get(eid_int(vt.Id), 0)
            self._all_items.Add(TemplateItem(vt, usage))

        # Populate type filter
        types_seen = sorted(set(viewtype_label(v.ViewType) for v in self._all_templates))
        self.cmb_type_filter.Items.Clear()
        all_item = ComboBoxItem()
        all_item.Content = "All Types"
        all_item.Tag     = None
        self.cmb_type_filter.Items.Add(all_item)
        for t in types_seen:
            ci = ComboBoxItem()
            ci.Content = t
            ci.Tag     = t
            self.cmb_type_filter.Items.Add(ci)
        self.cmb_type_filter.SelectedIndex = 0

        # Populate bulk link list
        self._bulk_link_items.Clear()
        for li in self._link_instances:
            name = get_link_name(li)
            self._bulk_link_items.Add(BulkLinkItem(name, li.Id, apply=False))

        self._apply_filter()
        self._update_status()

    def _apply_filter(self):
        search = (self.txt_search.Text or "").strip().lower()
        type_filter = None
        if self.cmb_type_filter.SelectedItem:
            ci = self.cmb_type_filter.SelectedItem
            type_filter = ci.Tag if hasattr(ci, 'Tag') else None

        self._filtered_items.Clear()
        for item in self._all_items:
            if search and search not in item.Name.lower():
                continue
            if type_filter and item.ViewTypeName != type_filter:
                continue
            self._filtered_items.Add(item)
        self._update_status()

    def _update_status(self):
        total    = self._all_items.Count
        filtered = self._filtered_items.Count
        checked  = sum(1 for i in self._all_items if i.IsSelected)
        if filtered == total:
            self.lbl_status.Text = "{}  templates  |  {} selected".format(total, checked)
        else:
            self.lbl_status.Text = "Showing {}  of {}  templates  |  {} selected".format(
                filtered, total, checked)
        # Update bulk count label
        if checked == 0:
            self.lbl_bulk_count.Text = (
                "No templates selected — use the checkboxes on the left to choose which templates to modify.")
        else:
            self.lbl_bulk_count.Text = (
                "{} template{} selected and will be modified.".format(
                    checked, "s" if checked != 1 else ""))

    # ─────────────────────────────────────────────
    # EVENT HANDLERS — LIST
    # ─────────────────────────────────────────────

    def _toggle_placeholder(self):
        if not self.txt_search.Text:
            self.ph_search.Visibility = Visibility.Visible

    def _on_search_changed(self, sender, e):
        self.ph_search.Visibility = (Visibility.Collapsed if self.txt_search.Text
                                     else Visibility.Visible)
        self._apply_filter()

    def _on_type_filter_changed(self, sender, e):
        self._apply_filter()

    def _on_template_selection_changed(self, sender, e):
        item = self.dg_templates.SelectedItem
        if item is None:
            self.lbl_selected_header.Text = "Select a template on the left to view or edit its settings."
            self._current_template = None
            return
        self._current_template = item.View
        self.lbl_selected_header.Text = "Editing:  {}  ({})".format(
            item.Name, item.ViewTypeName)
        # Refresh the active tab
        self._refresh_active_tab()

    def _on_tab_changed(self, sender, e):
        self._refresh_active_tab()

    def _refresh_active_tab(self):
        if self._current_template is None:
            return
        idx = self.tab_main.SelectedIndex
        if idx == 0:
            self._load_properties_tab()
        elif idx == 1:
            pass  # VG tab is loaded on demand via "Reload"
        elif idx == 2:
            self._load_links_tab()
        elif idx == 3:
            pass  # Bulk edit has its own data loaded at startup
        elif idx == 4:
            self._load_usage_tab()

    def _select_all(self, state):
        for item in self._filtered_items:
            item.IsSelected = state
        self._update_status()

    # ─────────────────────────────────────────────
    # EVENT HANDLERS — TOOLBAR ACTIONS
    # ─────────────────────────────────────────────

    def _on_new_click(self, sender, e):
        """Create a new blank template by duplicating the selected one (or first available)."""
        base = self._current_template
        if base is None and self._all_templates:
            base = self._all_templates[0]
        if base is None:
            MessageBox.Show("No view templates found to base the new template on.",
                            "No Templates", MessageBoxButton.OK, MessageBoxImage.Warning)
            return
        new_name = self._prompt_rename("New Template Name", base.Name + " Copy")
        if new_name is None:
            return
        try:
            t = Transaction(doc, "VTM: New Template")
            t.Start()
            new_id  = base.Duplicate(ViewDuplicateOption.Duplicate if hasattr(
                base, 'Duplicate') else 0)
            # Templates are not duplicated via Duplicate() — use ElementTransformUtils
            # Instead: copy the view element
            ids = List[ElementId]([base.Id])
            import Autodesk.Revit.DB as DB
            new_ids = DB.ElementTransformUtils.CopyElement(
                doc, base.Id, DB.XYZ(0, 0, 0))
            if new_ids and new_ids.Count > 0:
                new_elem = doc.GetElement(new_ids[0])
                if new_elem:
                    new_elem.Name = new_name
                    t.Commit()
                    self._load_all()
                    self._set_status("Created template: " + new_name)
                    return
            t.RollBack()
        except Exception as ex:
            try:
                t.RollBack()
            except Exception:
                pass
            MessageBox.Show("Could not create template:\n" + str(ex),
                            "Error", MessageBoxButton.OK, MessageBoxImage.Error)

    def _on_rename_click(self, sender=None, e=None):
        item = self.dg_templates.SelectedItem
        if item is None:
            MessageBox.Show("Select a template first.", "No Selection",
                            MessageBoxButton.OK, MessageBoxImage.Information)
            return
        new_name = self._prompt_rename("Rename Template", item.Name)
        if new_name is None or new_name == item.Name:
            return
        try:
            t = Transaction(doc, "VTM: Rename Template")
            t.Start()
            item.View.Name = new_name
            t.Commit()
            # Refresh
            self._usage_map     = build_usage_map(doc)
            self._all_templates = get_all_templates(doc)
            # Update in-place in _all_items
            for i in self._all_items:
                if eid_int(i.Id) == eid_int(item.Id):
                    break
            self._apply_filter()
            self._set_status("Renamed to: " + new_name)
        except Exception as ex:
            try:
                t.RollBack()
            except Exception:
                pass
            MessageBox.Show("Rename failed:\n" + str(ex),
                            "Error", MessageBoxButton.OK, MessageBoxImage.Error)

    def _on_dup_click(self, sender, e):
        item = self.dg_templates.SelectedItem
        if item is None:
            MessageBox.Show("Select a template to duplicate.", "No Selection",
                            MessageBoxButton.OK, MessageBoxImage.Information)
            return
        new_name = self._prompt_rename("Duplicate Template", item.Name + " Copy")
        if new_name is None:
            return
        try:
            import Autodesk.Revit.DB as DB
            t = Transaction(doc, "VTM: Duplicate Template")
            t.Start()
            new_ids = DB.ElementTransformUtils.CopyElement(
                doc, item.Id, DB.XYZ(0, 0, 0))
            if new_ids and new_ids.Count > 0:
                new_elem = doc.GetElement(new_ids[0])
                if new_elem:
                    new_elem.Name = new_name
                    t.Commit()
                    self._load_all()
                    self._set_status("Duplicated as: " + new_name)
                    return
            t.RollBack()
            MessageBox.Show("Could not duplicate — no element returned.",
                            "Error", MessageBoxButton.OK, MessageBoxImage.Error)
        except Exception as ex:
            try:
                t.RollBack()
            except Exception:
                pass
            MessageBox.Show("Duplicate failed:\n" + str(ex),
                            "Error", MessageBoxButton.OK, MessageBoxImage.Error)

    def _on_delete_click(self, sender, e):
        selected = [i for i in self._all_items if i.IsSelected]
        if not selected:
            item = self.dg_templates.SelectedItem
            if item:
                selected = [item]
        if not selected:
            MessageBox.Show("Select at least one template to delete.", "No Selection",
                            MessageBoxButton.OK, MessageBoxImage.Information)
            return
        names = "\n".join("  • " + i.Name for i in selected[:10])
        if len(selected) > 10:
            names += "\n  … and {} more".format(len(selected) - 10)
        res = MessageBox.Show(
            "Delete {} template{}?\n\n{}".format(
                len(selected), "s" if len(selected) != 1 else "", names),
            "Confirm Delete",
            MessageBoxButton.YesNo, MessageBoxImage.Warning)
        if res != MessageBoxResult.Yes:
            return
        deleted = 0
        errors  = []
        try:
            t = Transaction(doc, "VTM: Delete Templates")
            t.Start()
            for item in selected:
                try:
                    if item.UsedBy > 0:
                        errors.append("{} (used by {} views)".format(item.Name, item.UsedBy))
                        continue
                    doc.Delete(item.Id)
                    deleted += 1
                except Exception as ex:
                    errors.append("{}: {}".format(item.Name, str(ex)))
            t.Commit()
        except Exception as ex:
            try:
                t.RollBack()
            except Exception:
                pass
            MessageBox.Show("Delete failed:\n" + str(ex),
                            "Error", MessageBoxButton.OK, MessageBoxImage.Error)
            return
        self._load_all()
        msg = "Deleted {} template{}.".format(deleted, "s" if deleted != 1 else "")
        if errors:
            msg += "\n\nSkipped:\n" + "\n".join(errors)
        self._set_status(msg)

    def _on_apply_to_views_click(self, sender, e):
        item = self.dg_templates.SelectedItem
        if item is None:
            # Look for a single checked item
            checked = [i for i in self._all_items if i.IsSelected]
            if len(checked) == 1:
                item = checked[0]
            elif len(checked) > 1:
                MessageBox.Show(
                    "Please select a single template in the list (click on it, not just check it).",
                    "Multiple Templates", MessageBoxButton.OK, MessageBoxImage.Information)
                return
            else:
                MessageBox.Show("Select a template first.", "No Selection",
                                MessageBoxButton.OK, MessageBoxImage.Information)
                return
        self._show_apply_to_views_dialog(item)

    # ─────────────────────────────────────────────
    # PROPERTIES TAB
    # ─────────────────────────────────────────────

    def _load_properties_tab(self):
        vt = self._current_template
        if vt is None:
            return
        self.txt_prop_name.Text = vt.Name
        # View type
        try:
            self.lbl_prop_type.Text = viewtype_label(vt.ViewType)
        except Exception:
            self.lbl_prop_type.Text = "-"
        # Scale
        try:
            sc = vt.Scale
            for i in range(self.cmb_prop_scale.Items.Count):
                ci = self.cmb_prop_scale.Items[i]
                if hasattr(ci, 'Tag') and ci.Tag == sc:
                    self.cmb_prop_scale.SelectedIndex = i
                    break
        except Exception:
            pass
        # Detail level
        try:
            dl_param = vt.get_Parameter(BuiltInParameter.VIEW_DETAIL_LEVEL)
            if dl_param:
                dl = dl_param.AsInteger()
                for i in range(self.cmb_prop_detail.Items.Count):
                    ci = self.cmb_prop_detail.Items[i]
                    if hasattr(ci, 'Tag') and ci.Tag == dl:
                        self.cmb_prop_detail.SelectedIndex = i
                        break
        except Exception:
            pass
        # Parts visibility
        try:
            pv_param = vt.get_Parameter(BuiltInParameter.VIEW_PARTS_VISIBILITY)
            if pv_param:
                pv = pv_param.AsInteger()
                for i in range(self.cmb_prop_parts.Items.Count):
                    ci = self.cmb_prop_parts.Items[i]
                    if hasattr(ci, 'Tag') and ci.Tag == pv:
                        self.cmb_prop_parts.SelectedIndex = i
                        break
        except Exception:
            pass
        # Discipline
        try:
            disc = int(vt.Discipline)
            for i in range(self.cmb_prop_discipline.Items.Count):
                ci = self.cmb_prop_discipline.Items[i]
                if hasattr(ci, 'Tag') and ci.Tag == disc:
                    self.cmb_prop_discipline.SelectedIndex = i
                    break
        except Exception:
            pass
        self.lbl_prop_status.Text = ""

    def _on_prop_save_click(self, sender, e):
        vt = self._current_template
        if vt is None:
            return
        errors = []
        try:
            t = Transaction(doc, "VTM: Save Template Properties")
            t.Start()
            # Scale
            if self.cmb_prop_scale.SelectedItem:
                ci = self.cmb_prop_scale.SelectedItem
                if hasattr(ci, 'Tag') and ci.Tag:
                    try:
                        vt.Scale = int(ci.Tag)
                    except Exception as ex:
                        errors.append("Scale: " + str(ex))
            # Detail level
            if self.cmb_prop_detail.SelectedItem:
                ci = self.cmb_prop_detail.SelectedItem
                if hasattr(ci, 'Tag'):
                    try:
                        p = vt.get_Parameter(BuiltInParameter.VIEW_DETAIL_LEVEL)
                        if p and not p.IsReadOnly:
                            p.Set(int(ci.Tag))
                    except Exception as ex:
                        errors.append("Detail level: " + str(ex))
            # Parts visibility
            if self.cmb_prop_parts.SelectedItem:
                ci = self.cmb_prop_parts.SelectedItem
                if hasattr(ci, 'Tag'):
                    try:
                        p = vt.get_Parameter(BuiltInParameter.VIEW_PARTS_VISIBILITY)
                        if p and not p.IsReadOnly:
                            p.Set(int(ci.Tag))
                    except Exception as ex:
                        errors.append("Parts visibility: " + str(ex))
            t.Commit()
        except Exception as ex:
            try:
                t.RollBack()
            except Exception:
                pass
            self.lbl_prop_status.Foreground = SolidColorBrush(Color.FromRgb(197, 48, 48))
            self.lbl_prop_status.Text = "Save failed: " + str(ex)
            return

        # Refresh the template item in list
        self._usage_map     = build_usage_map(doc)
        self._all_templates = get_all_templates(doc)
        self._apply_filter()

        if errors:
            self.lbl_prop_status.Foreground = SolidColorBrush(Color.FromRgb(197, 48, 48))
            self.lbl_prop_status.Text = "Partial save. Issues: " + "; ".join(errors)
        else:
            self.lbl_prop_status.Foreground = SolidColorBrush(Color.FromRgb(72, 187, 120))
            self.lbl_prop_status.Text = "✓ Saved"
        self._set_status("Properties saved for: " + vt.Name)

    # ─────────────────────────────────────────────
    # VG OVERRIDES TAB
    # ─────────────────────────────────────────────

    def _on_vg_reload_click(self, sender, e):
        self._reload_vg_list()

    def _reload_vg_list(self):
        vt = self._current_template
        if vt is None:
            self.lbl_vg_info.Text = "  Select a template first."
            return
        use_model = self.rb_vg_model.IsChecked
        cats = self._model_cats if use_model else self._ann_cats
        self._vg_all = []
        search = (self.txt_vg_search.Text or "").strip().lower()

        # Temporarily suppress change events
        self._suppress_vg_changes = True
        self._vg_items.Clear()
        for name, cat_id in cats:
            try:
                if not category_can_be_hidden(vt, cat_id):
                    continue
                is_hidden = vt.GetCategoryHidden(cat_id)
                item = CategoryVisItem(name, cat_id, is_hidden)
                # Wire change handler
                item.add_PropertyChanged(self._on_vg_item_changed)
                self._vg_all.append(item)
                if not search or search in name.lower():
                    self._vg_items.Add(item)
            except Exception:
                pass
        self._suppress_vg_changes = False

        cat_type = "Model" if use_model else "Annotation"
        self.lbl_vg_info.Text = "  {} categories loaded for this template.".format(
            len(self._vg_all))
        self._set_status("Loaded {} {} categories for '{}'.".format(
            len(self._vg_all), cat_type, vt.Name))

    def _on_vg_search_changed(self, sender, e):
        search = (self.txt_vg_search.Text or "").strip().lower()
        self._vg_items.Clear()
        for item in self._vg_all:
            if not search or search in item.Name.lower():
                self._vg_items.Add(item)

    def _on_vg_item_changed(self, sender, e):
        if self._suppress_vg_changes:
            return
        if e.PropertyName != "IsVisible" and e.PropertyName != "IsHidden":
            return
        vt = self._current_template
        if vt is None:
            return
        item = sender
        try:
            t = Transaction(doc, "VTM: VG Category Visibility")
            t.Start()
            vt.SetCategoryHidden(item.CatId, item.IsHidden)
            t.Commit()
        except Exception as ex:
            try:
                t.RollBack()
            except Exception:
                pass
            # Revert the UI
            self._suppress_vg_changes = True
            item.IsHidden = not item.IsHidden
            self._suppress_vg_changes = False

    def _vg_set_all(self, visible):
        vt = self._current_template
        if vt is None:
            return
        hide = not visible
        changed = 0
        try:
            t = Transaction(doc, "VTM: VG Set All {}".format("Visible" if visible else "Hidden"))
            t.Start()
            self._suppress_vg_changes = True
            for item in self._vg_all:
                try:
                    vt.SetCategoryHidden(item.CatId, hide)
                    item.IsHidden = hide
                    changed += 1
                except Exception:
                    pass
            self._suppress_vg_changes = False
            t.Commit()
        except Exception as ex:
            self._suppress_vg_changes = False
            try:
                t.RollBack()
            except Exception:
                pass
        self._set_status("{} categories set to {} in '{}'.".format(
            changed, "visible" if visible else "hidden", vt.Name))

    # ─────────────────────────────────────────────
    # REVIT LINKS TAB
    # ─────────────────────────────────────────────

    def _load_links_tab(self):
        vt = self._current_template
        self._link_items.Clear()
        if not self._link_instances:
            self.lbl_links_status.Text = "  No linked Revit models found in this project."
            return
        for link in self._link_instances:
            name         = get_link_name(link)
            display_type = get_link_display_type(vt, link.Id) if vt else "N/A"
            self._link_items.Add(LinkDisplayItem(name, link.Id, display_type))
        self.lbl_links_status.Text = ""

    def _on_link_set_host_click(self, sender, e):
        vt = self._current_template
        if vt is None:
            return
        sel_row = self.dg_links.SelectedItem
        if sel_row is None:
            MessageBox.Show("Select a link row first.", "No Selection",
                            MessageBoxButton.OK, MessageBoxImage.Information)
            return
        if not _HAS_LINK_GRAPHICS:
            MessageBox.Show("RevitLinkGraphicsSettings is not available in this Revit version.",
                            "Not Supported", MessageBoxButton.OK, MessageBoxImage.Warning)
            return
        try:
            t = Transaction(doc, "VTM: Set Link to By Host View")
            t.Start()
            settings = RevitLinkGraphicsSettings()
            # Default constructor sets to ByHostView
            vt.SetLinkOverrides(sel_row.LinkId, settings)
            t.Commit()
            self._load_links_tab()
            self.lbl_links_status.Text = "✓ '{}' set to By Host View.".format(sel_row.LinkName)
            self._set_status("Link '{}' set to By Host View in '{}'.".format(
                sel_row.LinkName, vt.Name))
        except Exception as ex:
            try:
                t.RollBack()
            except Exception:
                pass
            MessageBox.Show("Could not set link override:\n" + str(ex),
                            "Error", MessageBoxButton.OK, MessageBoxImage.Error)

    # ─────────────────────────────────────────────
    # BULK EDIT TAB
    # ─────────────────────────────────────────────

    def _bulk_add_cat(self, hide=True):
        result = self._show_pick_category_dialog()
        if result is None:
            return
        name, cat_id = result
        # Avoid duplicates
        for existing in self._bulk_cat_items:
            if eid_int(existing.CatId) == eid_int(cat_id):
                existing.Hide = hide
                return
        self._bulk_cat_items.Add(BulkCatItem(name, cat_id, hide=hide))

    def _bulk_remove_cat(self, sender, e):
        sel = self.dg_bulk_cats.SelectedItem
        if sel is not None:
            self._bulk_cat_items.Remove(sel)

    def _on_bulk_apply_click(self, sender, e):
        selected_templates = [i for i in self._all_items if i.IsSelected]
        if not selected_templates:
            MessageBox.Show(
                "No templates selected. Use the checkboxes in the template list to choose which templates to modify.",
                "No Templates Selected", MessageBoxButton.OK, MessageBoxImage.Information)
            return

        # Gather what to apply
        apply_scale  = self.chk_bulk_scale.IsChecked  and self.cmb_bulk_scale.SelectedItem
        apply_detail = self.chk_bulk_detail.IsChecked and self.cmb_bulk_detail.SelectedItem
        apply_parts  = self.chk_bulk_parts.IsChecked  and self.cmb_bulk_parts.SelectedItem
        cat_overrides = list(self._bulk_cat_items)
        link_overrides= [li for li in self._bulk_link_items if li.Apply]

        if not apply_scale and not apply_detail and not apply_parts \
                and not cat_overrides and not link_overrides:
            MessageBox.Show("Nothing to apply — configure at least one setting above.",
                            "Nothing Configured", MessageBoxButton.OK, MessageBoxImage.Information)
            return

        # Build summary
        lines = ["Apply to {} template{}:".format(
            len(selected_templates), "s" if len(selected_templates) != 1 else "")]
        if apply_scale:
            lines.append("  • Scale → " + self.cmb_bulk_scale.SelectedItem.Content)
        if apply_detail:
            lines.append("  • Detail Level → " + self.cmb_bulk_detail.SelectedItem.Content)
        if apply_parts:
            lines.append("  • Parts Visibility → " + self.cmb_bulk_parts.SelectedItem.Content)
        for co in cat_overrides:
            lines.append("  • {} → {}".format(co.Name, co.ActionLabel))
        for lo in link_overrides:
            lines.append("  • Link '{}' → By Host View".format(lo.Name))
        lines.append("\nProceed?")

        res = MessageBox.Show("\n".join(lines), "Confirm Bulk Apply",
                              MessageBoxButton.YesNo, MessageBoxImage.Question)
        if res != MessageBoxResult.Yes:
            return

        applied  = 0
        errors   = []
        new_scale = int(self.cmb_bulk_scale.SelectedItem.Tag)  if apply_scale  else None
        new_detail= int(self.cmb_bulk_detail.SelectedItem.Tag) if apply_detail else None
        new_parts = int(self.cmb_bulk_parts.SelectedItem.Tag)  if apply_parts  else None

        try:
            tg = TransactionGroup(doc, "VTM: Bulk Edit Templates")
            tg.Start()
            for tmpl_item in selected_templates:
                vt = tmpl_item.View
                try:
                    t = Transaction(doc, "VTM: Bulk Edit - " + vt.Name)
                    t.Start()
                    # Scale
                    if new_scale is not None:
                        try:
                            vt.Scale = new_scale
                        except Exception as ex:
                            errors.append("{}/Scale: {}".format(vt.Name, ex))
                    # Detail level
                    if new_detail is not None:
                        try:
                            p = vt.get_Parameter(BuiltInParameter.VIEW_DETAIL_LEVEL)
                            if p and not p.IsReadOnly:
                                p.Set(new_detail)
                        except Exception as ex:
                            errors.append("{}/DetailLevel: {}".format(vt.Name, ex))
                    # Parts visibility
                    if new_parts is not None:
                        try:
                            p = vt.get_Parameter(BuiltInParameter.VIEW_PARTS_VISIBILITY)
                            if p and not p.IsReadOnly:
                                p.Set(new_parts)
                        except Exception as ex:
                            errors.append("{}/PartsVis: {}".format(vt.Name, ex))
                    # Category visibility
                    for co in cat_overrides:
                        try:
                            if category_can_be_hidden(vt, co.CatId):
                                vt.SetCategoryHidden(co.CatId, co.Hide)
                        except Exception as ex:
                            errors.append("{}/{}: {}".format(vt.Name, co.Name, ex))
                    # Revit link overrides
                    if link_overrides and _HAS_LINK_GRAPHICS:
                        for lo in link_overrides:
                            try:
                                settings = RevitLinkGraphicsSettings()
                                vt.SetLinkOverrides(lo.LinkId, settings)
                            except Exception as ex:
                                errors.append("{}/Link {}: {}".format(vt.Name, lo.Name, ex))
                    t.Commit()
                    applied += 1
                except Exception as ex:
                    try:
                        t.RollBack()
                    except Exception:
                        pass
                    errors.append(vt.Name + ": " + str(ex))
            tg.Assimilate()
        except Exception as ex:
            try:
                tg.RollBack()
            except Exception:
                pass
            MessageBox.Show("Bulk apply failed:\n" + str(ex),
                            "Error", MessageBoxButton.OK, MessageBoxImage.Error)
            return

        self._load_all()
        if self._current_template:
            self._refresh_active_tab()

        msg = "✓ Applied to {} template{}.".format(applied, "s" if applied != 1 else "")
        if errors:
            msg += " ({} issue{})".format(len(errors), "s" if len(errors) != 1 else "")
        self.lbl_bulk_status.Text = msg
        self._set_status(msg)

        if errors and len(errors) <= 10:
            MessageBox.Show("Completed with issues:\n" + "\n".join(errors),
                            "Partial Success", MessageBoxButton.OK, MessageBoxImage.Warning)

    # ─────────────────────────────────────────────
    # USAGE TAB
    # ─────────────────────────────────────────────

    def _load_usage_tab(self):
        vt = self._current_template
        self._usage_items.Clear()
        if vt is None:
            return
        # Build a sheet map: view id → sheet ref string
        sheet_map = {}
        for sheet in FilteredElementCollector(doc).OfClass(ViewSheet):
            try:
                for vp_id in sheet.GetAllViewports():
                    vp = doc.GetElement(vp_id)
                    if vp:
                        vid = eid_int(vp.ViewId)
                        ref_str = "{} - {}".format(
                            sheet.get_Parameter(BuiltInParameter.SHEET_NUMBER).AsString(),
                            sheet.get_Parameter(BuiltInParameter.SHEET_NAME).AsString())
                        sheet_map[vid] = ref_str
            except Exception:
                pass

        count = 0
        for v in FilteredElementCollector(doc).OfClass(View):
            if v.IsTemplate:
                continue
            try:
                if eid_int(v.ViewTemplateId) == eid_int(vt.Id):
                    sheet_ref = sheet_map.get(eid_int(v.Id), "-")
                    self._usage_items.Add(
                        UsageRow(v.Name, viewtype_label(v.ViewType), sheet_ref))
                    count += 1
            except Exception:
                pass
        self.lbl_usage_header.Text = "{} view{} use template '{}'.".format(
            count, "s" if count != 1 else "", vt.Name)

    # ─────────────────────────────────────────────
    # DIALOGS
    # ─────────────────────────────────────────────

    def _prompt_rename(self, title, default_name=""):
        """Show rename dialog, return new name or None if cancelled."""
        try:
            win = Markup.XamlReader.Parse(RENAME_XAML)
            win.Title = title
            win.Owner = self
            txt  = win.FindName("txt_new_name")
            ok   = win.FindName("btn_ok")
            canc = win.FindName("btn_cancel")
            txt.Text = default_name
            txt.SelectAll()
            result = [None]

            def on_ok(s, e):
                result[0] = txt.Text.strip()
                win.DialogResult = True
                win.Close()

            def on_cancel(s, e):
                win.DialogResult = False
                win.Close()

            def on_key(s, e):
                if e.Key == System.Windows.Input.Key.Return:
                    on_ok(s, e)
                elif e.Key == System.Windows.Input.Key.Escape:
                    on_cancel(s, e)

            ok.Click   += on_ok
            canc.Click += on_cancel
            txt.KeyDown += on_key
            win.ShowDialog()
            return result[0]
        except Exception as ex:
            MessageBox.Show("Rename dialog error:\n" + str(ex), "Error",
                            MessageBoxButton.OK, MessageBoxImage.Error)
            return None

    def _show_apply_to_views_dialog(self, template_item):
        """Show dialog to apply template_item to chosen views."""
        try:
            win = Markup.XamlReader.Parse(APPLY_VIEWS_XAML)
            win.Owner = self
            win.FindName("lbl_title").Text = "Apply Template: " + template_item.Name

            dg       = win.FindName("dg_av_views")
            txt_s    = win.FindName("txt_av_search")
            btn_all  = win.FindName("btn_av_all")
            btn_none = win.FindName("btn_av_none")
            btn_appl = win.FindName("btn_av_apply")
            btn_canc = win.FindName("btn_av_cancel")
            lbl_stat = win.FindName("lbl_av_status")

            # Build template name map
            tmpl_map = {}
            for vt in self._all_templates:
                tmpl_map[eid_int(vt.Id)] = vt.Name

            # Collect all non-template views
            rows = ObservableCollection[object]()
            all_rows = []
            for v in FilteredElementCollector(doc).OfClass(View):
                if v.IsTemplate:
                    continue
                if v.ViewType in (ViewType.Schedule, ViewType.Legend,
                                  ViewType.DraftingView, ViewType.Walkthrough):
                    continue
                tid = eid_int(v.ViewTemplateId)
                cur_tmpl = tmpl_map.get(tid, "<None>") if tid != -1 else "<None>"
                row = ApplyViewRow(v, cur_tmpl)
                all_rows.append(row)
                rows.Add(row)
            dg.ItemsSource = rows
            lbl_stat.Text  = "{} views".format(len(all_rows))

            def filter_rows():
                search = (txt_s.Text or "").strip().lower()
                rows.Clear()
                for r in all_rows:
                    if not search or search in r.ViewName.lower():
                        rows.Add(r)
                lbl_stat.Text = "{} of {} views".format(rows.Count, len(all_rows))

            txt_s.TextChanged += lambda s, e: filter_rows()
            btn_all.Click  += lambda s, e: [setattr(r, 'IsChecked', True)  for r in rows]
            btn_none.Click += lambda s, e: [setattr(r, 'IsChecked', False) for r in rows]
            btn_canc.Click += lambda s, e: win.Close()

            def on_apply(s, e):
                to_apply = [r for r in all_rows if r.IsChecked]
                if not to_apply:
                    MessageBox.Show("No views selected.", "Nothing to Do",
                                    MessageBoxButton.OK, MessageBoxImage.Information)
                    return
                applied = 0
                errors  = []
                try:
                    t = Transaction(doc, "VTM: Apply Template to Views")
                    t.Start()
                    for row in to_apply:
                        try:
                            row.View.ViewTemplateId = template_item.Id
                            applied += 1
                        except Exception as ex:
                            errors.append("{}: {}".format(row.ViewName, str(ex)))
                    t.Commit()
                except Exception as ex:
                    try:
                        t.RollBack()
                    except Exception:
                        pass
                    MessageBox.Show("Apply failed:\n" + str(ex), "Error",
                                    MessageBoxButton.OK, MessageBoxImage.Error)
                    return
                self._load_all()
                msg = "Applied to {} view{}.".format(applied, "s" if applied != 1 else "")
                if errors:
                    msg += " ({} errors)".format(len(errors))
                lbl_stat.Text = msg
                self._set_status(msg)
                if not errors:
                    win.Close()

            btn_appl.Click += on_apply
            win.ShowDialog()
        except Exception as ex:
            MessageBox.Show("Apply dialog error:\n" + traceback.format_exc(),
                            "Error", MessageBoxButton.OK, MessageBoxImage.Error)

    def _show_pick_category_dialog(self):
        """Show dialog to pick a category. Returns (name, cat_id) or None."""
        try:
            win = Markup.XamlReader.Parse(PICK_CAT_XAML)
            win.Owner = self

            lb       = win.FindName("lb_cats")
            txt_s    = win.FindName("txt_cat_search")
            rb_model = win.FindName("rb_cat_model")
            rb_ann   = win.FindName("rb_cat_ann")
            btn_ok   = win.FindName("btn_cat_ok")
            btn_canc = win.FindName("btn_cat_cancel")

            result = [None]
            _all_model = [(n, cid) for n, cid in self._model_cats]
            _all_ann   = [(n, cid) for n, cid in self._ann_cats]

            def populate():
                search = (txt_s.Text or "").strip().lower()
                source = _all_model if rb_model.IsChecked else _all_ann
                lb.Items.Clear()
                for name, cat_id in source:
                    if search and search not in name.lower():
                        continue
                    item = ListBoxItem()
                    item.Content = name
                    item.Tag     = cat_id
                    lb.Items.Add(item)

            txt_s.TextChanged       += lambda s, e: populate()
            rb_model.Checked        += lambda s, e: populate()
            rb_ann.Checked          += lambda s, e: populate()

            def on_ok(s, e):
                sel = lb.SelectedItem
                if sel is None:
                    return
                result[0] = (sel.Content, sel.Tag)
                win.DialogResult = True
                win.Close()

            btn_ok.Click   += on_ok
            btn_canc.Click += lambda s, e: win.Close()
            lb.MouseDoubleClick += on_ok
            populate()
            win.ShowDialog()
            return result[0]
        except Exception as ex:
            MessageBox.Show("Category picker error:\n" + str(ex), "Error",
                            MessageBoxButton.OK, MessageBoxImage.Error)
            return None

    # ─────────────────────────────────────────────
    # HELPERS
    # ─────────────────────────────────────────────

    def _set_status(self, msg):
        self.lbl_status.Text = msg

    def ShowDialog(self):
        return super(ViewTemplateManagerWindow, self).ShowDialog()


