          </Grid>
          <!-- Type filter -->
          <ComboBox x:Name="cmb_type_filter" Width="140" Height="30"
                    Margin="0,0,16,0" ToolTip="Filter by view type"/>
          <!-- Divider -->
          <Separator Width="1" Height="22" Background="#E2E8F0" Margin="0,0,12,0"/>
          <!-- Action buttons -->
          <Button x:Name="btn_new"     Content="＋ New"          Style="{StaticResource SecondaryBtn}" Height="30" ToolTip="Create a new view template (copy of selected)"/>
          <Button x:Name="btn_rename"  Content="✎ Rename"        Style="{StaticResource SecondaryBtn}" Height="30" ToolTip="Rename selected template"/>
          <Button x:Name="btn_dup"     Content="⧉ Duplicate"     Style="{StaticResource SecondaryBtn}" Height="30" ToolTip="Duplicate selected template"/>
          <Button x:Name="btn_delete"  Content="🗑 Delete"        Style="{StaticResource DangerBtn}"    Height="30" ToolTip="Delete selected template(s)"/>
          <Separator Width="1" Height="22" Background="#E2E8F0" Margin="0,0,12,0"/>
          <Button x:Name="btn_apply"   Content="▶ Apply to Views" Style="{StaticResource PrimaryBtn}"  Height="30" ToolTip="Apply selected template to chosen views"/>
        </StackPanel>
        <!-- Right side: select all / none -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Center">
          <Button x:Name="btn_sel_all"  Content="Select All"  Style="{StaticResource SecondaryBtn}" Height="26" FontSize="11"/>
          <Button x:Name="btn_sel_none" Content="Select None" Style="{StaticResource SecondaryBtn}" Height="26" FontSize="11"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═══ MAIN CONTENT (two-panel) ═══ -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="380" MinWidth="260"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ── LEFT: Template List ── -->
      <Border Grid.Column="0" Background="White"
              BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
        <DataGrid x:Name="dg_templates"
                  SelectionMode="Single"
                  Background="White"
                  BorderThickness="0"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#F0F4F8"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True">
          <DataGrid.Columns>
            <!-- Checkbox column -->
            <DataGridTemplateColumn Header="" Width="34" CanUserResize="False" CanUserSort="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource RowCheck}" Cursor="Hand"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Name"  Binding="{Binding Name}"         Width="*"   IsReadOnly="True"/>
            <DataGridTextColumn Header="Type"  Binding="{Binding ViewTypeName}" Width="90"  IsReadOnly="True"/>
            <DataGridTextColumn Header="Scale" Binding="{Binding Scale}"        Width="60"  IsReadOnly="True"/>
            <DataGridTextColumn Header="Used"  Binding="{Binding UsedBy}"       Width="46"  IsReadOnly="True"/>
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <!-- Splitter -->
      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                    VerticalAlignment="Stretch" Background="#E2E8F0" Cursor="SizeWE"/>

      <!-- ── RIGHT: Detail / Edit Tabs ── -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>  <!-- selected template label -->
          <RowDefinition Height="*"/>     <!-- tab control -->
        </Grid.RowDefinitions>

        <!-- "Editing: [Name]" label strip -->
        <Border Grid.Row="0" Background="#EDF2F7"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,8">
          <TextBlock x:Name="lbl_selected_header"
                     Text="Select a template on the left to view or edit its settings."
                     Foreground="#4A5568" FontSize="12" VerticalAlignment="Center"/>
        </Border>

        <!-- Tab Control -->
        <TabControl Grid.Row="1" x:Name="tab_main"
                    Background="#F7FAFC" BorderThickness="0">
          <!-- ── PROPERTIES TAB ── -->
          <TabItem Header="Properties">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="20">
              <StackPanel x:Name="pnl_props" Margin="0,4,0,16">
                <TextBlock Text="Template Properties" Style="{StaticResource SectionHeader}"/>
                <!-- Name -->
                <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="txt_prop_name" Height="30" Grid.Column="0" Margin="0,0,8,0"/>
                  <Button x:Name="btn_prop_rename" Content="Rename" Grid.Column="1"
                          Style="{StaticResource SecondaryBtn}" Height="30"/>
                </Grid>
                <!-- View Type (read-only) -->
                <TextBlock Text="View Type" Style="{StaticResource FieldLabel}"/>
                <TextBlock x:Name="lbl_prop_type" Foreground="#4A5568" FontSize="12"/>
                <!-- Scale -->
                <TextBlock Text="View Scale" Style="{StaticResource FieldLabel}"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <ComboBox x:Name="cmb_prop_scale" Grid.Column="0"/>
                </Grid>
                <!-- Detail Level -->
                <TextBlock Text="Detail Level" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="cmb_prop_detail" Width="160" HorizontalAlignment="Left">
                  <ComboBoxItem Content="Coarse" Tag="1"/>
                  <ComboBoxItem Content="Medium" Tag="2"/>
                  <ComboBoxItem Content="Fine"   Tag="3"/>
                </ComboBox>
                <!-- Parts Visibility -->
                <TextBlock Text="Parts Visibility" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="cmb_prop_parts" Width="180" HorizontalAlignment="Left">
                  <ComboBoxItem Content="Show Original" Tag="0"/>
                  <ComboBoxItem Content="Show Parts"    Tag="1"/>
                  <ComboBoxItem Content="Show Both"     Tag="2"/>
                </ComboBox>
                <!-- Discipline -->
                <TextBlock Text="Discipline" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="cmb_prop_discipline" Width="180" HorizontalAlignment="Left">
                  <ComboBoxItem Content="Architectural"  Tag="0"/>
                  <ComboBoxItem Content="Structural"     Tag="1"/>
                  <ComboBoxItem Content="Mechanical"     Tag="2"/>
                  <ComboBoxItem Content="Electrical"     Tag="3"/>
                  <ComboBoxItem Content="Plumbing"       Tag="4"/>
                  <ComboBoxItem Content="Coordination"   Tag="255"/>
                </ComboBox>
                <!-- Save button -->
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                  <Button x:Name="btn_prop_save" Content="💾  Save Properties"
                          Style="{StaticResource PrimaryBtn}" Height="32"/>
                </StackPanel>
                <TextBlock x:Name="lbl_prop_status" Text="" Foreground="#48BB78"
                           FontSize="11" Margin="0,6,0,0"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- ── VG OVERRIDES TAB ── -->
          <TabItem Header="VG Overrides">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <!-- Sub-tab selector -->
              <Border Grid.Row="0" Background="White"
                      BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,6">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="rb_vg_model" Content="Model Categories"
                               IsChecked="True" GroupName="vg_type"
                               Margin="0,0,16,0" VerticalContentAlignment="Center"/>
                  <RadioButton x:Name="rb_vg_ann" Content="Annotation Categories"
                               GroupName="vg_type" Margin="0,0,16,0"
                               VerticalContentAlignment="Center"/>
                  <Button x:Name="btn_vg_reload" Content="↺ Reload"
                          Style="{StaticResource SecondaryBtn}" Height="24"
                          FontSize="11" Margin="16,0,0,0"/>
                  <TextBlock x:Name="lbl_vg_info" Text="  Click Reload to load categories for the selected template."
                             Foreground="#718096" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
              <!-- Category list -->
              <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="White"
                        BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,6">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="200" Grid.Column="0" HorizontalAlignment="Left">
                      <TextBox x:Name="txt_vg_search" Height="26"/>
                      <TextBlock Text="Filter categories…" Foreground="#A0AEC0"
                                 FontSize="11" IsHitTestVisible="False"
                                 VerticalAlignment="Center" Margin="8,0"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <Button x:Name="btn_vg_show_all"  Content="Show All"  Style="{StaticResource SecondaryBtn}" Height="26" FontSize="11"/>
                      <Button x:Name="btn_vg_hide_all"  Content="Hide All"  Style="{StaticResource SecondaryBtn}" Height="26" FontSize="11"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <DataGrid Grid.Row="1" x:Name="dg_vg_cats"
                          BorderThickness="0"
                          EnableRowVirtualization="True">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Visible" Width="60" CanUserResize="False">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource RowCheck}" Cursor="Hand"
                                    x:Name="chk_vis"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Category" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </Grid>
          </TabItem>

          <!-- ── REVIT LINKS TAB ── -->
          <TabItem Header="Revit Links">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Background="#EDF2F7"
                      BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,10">
                <TextBlock Style="{StaticResource HelperText}">
                  Shows the display setting for each linked Revit model in the selected template.
                  Setting a link to <Run FontWeight="SemiBold">By Host View</Run> makes it inherit all
                  visibility/graphics settings (including category visibility) from this template.
                  This is the recommended approach for hiding annotation categories from linked models.
                </TextBlock>
              </Border>
              <DataGrid Grid.Row="1" x:Name="dg_links" BorderThickness="0">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Linked Model"    Binding="{Binding LinkName}"    Width="*"   IsReadOnly="True"/>
                  <DataGridTextColumn Header="Display Setting" Binding="{Binding DisplayType}" Width="160" IsReadOnly="True"/>
                </DataGrid.Columns>
              </DataGrid>
              <Border Grid.Row="2" Background="White"
                      BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="btn_link_set_host" Content="Set Selected → By Host View"
                          Style="{StaticResource PrimaryBtn}" Height="30"
                          ToolTip="Set the selected link to By Host View for this template"/>
                  <Button x:Name="btn_links_reload"  Content="↺ Reload"
                          Style="{StaticResource SecondaryBtn}" Height="30"/>
                  <TextBlock x:Name="lbl_links_status" Text=""
                             Foreground="#48BB78" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
            </Grid>
          </TabItem>

          <!-- ── BULK EDIT TAB ── -->
          <TabItem Header="⚡ Bulk Edit">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- Header strip -->
              <Border Grid.Row="0" Background="#FEFCBF"
                      BorderBrush="#F6E05E" BorderThickness="0,0,0,1" Padding="16,10">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="⚡ " FontSize="16" VerticalAlignment="Center"/>
                  <StackPanel>
                    <TextBlock x:Name="lbl_bulk_header"
                               Text="Configure settings below, then click Apply to push changes to ALL checked templates."
                               Foreground="#744210" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock x:Name="lbl_bulk_count"
                               Text="No templates selected — use the checkboxes on the left to choose which templates to modify."
                               Foreground="#975A16" FontSize="11"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- Scrollable settings area -->
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled" Padding="16,8">
                <StackPanel>

                  <!-- ─ Section 1: Basic Properties ─ -->
                  <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                          CornerRadius="4" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                      <TextBlock Text="Basic Properties" Style="{StaticResource SectionHeader}"/>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="160"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="chk_bulk_scale" Content="View Scale:"
                                  Grid.Row="0" Grid.Column="0" Margin="0,0,10,8" VerticalAlignment="Center"/>
                        <ComboBox x:Name="cmb_bulk_scale" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"/>
                        <CheckBox x:Name="chk_bulk_detail" Content="Detail Level:"
                                  Grid.Row="1" Grid.Column="0" Margin="0,0,10,8" VerticalAlignment="Center"/>
                        <ComboBox x:Name="cmb_bulk_detail" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                          <ComboBoxItem Content="Coarse" Tag="1"/>
                          <ComboBoxItem Content="Medium" Tag="2"/>
                          <ComboBoxItem Content="Fine"   Tag="3"/>
                        </ComboBox>
                        <CheckBox x:Name="chk_bulk_parts" Content="Parts Visibility:"
                                  Grid.Row="2" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="cmb_bulk_parts" Grid.Row="2" Grid.Column="1">
                          <ComboBoxItem Content="Show Original" Tag="0"/>
                          <ComboBoxItem Content="Show Parts"    Tag="1"/>
                          <ComboBoxItem Content="Show Both"     Tag="2"/>
                        </ComboBox>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <!-- ─ Section 2: Category Visibility ─ -->
                  <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                          CornerRadius="4" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                      <TextBlock Text="Category Visibility" Style="{StaticResource SectionHeader}"/>
                      <TextBlock Style="{StaticResource HelperText}" Margin="0,0,0,8">
                        Add categories to hide or show across all selected templates.
                        This applies to the host model. Links set to <Run FontWeight="SemiBold">By Host View</Run>
                        will also inherit these changes.
                      </TextBlock>
                      <!-- Category override list -->
                      <DataGrid x:Name="dg_bulk_cats"
                                MaxHeight="180" BorderThickness="1"
                                BorderBrush="#E2E8F0"
                                EnableRowVirtualization="True">
                        <DataGrid.Columns>
                          <DataGridTextColumn Header="Category" Binding="{Binding Name}"        Width="*"   IsReadOnly="True"/>
                          <DataGridTextColumn Header="Action"   Binding="{Binding ActionLabel}" Width="70"  IsReadOnly="True"/>
                        </DataGrid.Columns>
                      </DataGrid>
                      <!-- Add / remove buttons -->
                      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="btn_bulk_add_hide_cat"   Content="＋ Add Category to Hide"
                                Style="{StaticResource SecondaryBtn}" Height="28" FontSize="11"/>
                        <Button x:Name="btn_bulk_add_show_cat"   Content="＋ Add Category to Show"
                                Style="{StaticResource SecondaryBtn}" Height="28" FontSize="11"/>
                        <Button x:Name="btn_bulk_remove_cat"     Content="✕ Remove"
                                Style="{StaticResource DangerBtn}"    Height="28" FontSize="11"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <!-- ─ Section 3: Revit Link Display ─ -->
                  <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                          CornerRadius="4" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                      <TextBlock Text="Revit Link Display" Style="{StaticResource SectionHeader}"/>
                      <TextBlock Style="{StaticResource HelperText}" Margin="0,0,0,8">
                        Check the links you want to set to <Run FontWeight="SemiBold">By Host View</Run>
                        in all selected templates. This ensures linked models inherit the host template's
                        visibility settings — the most efficient way to hide annotation categories
                        from linked models across multiple templates at once.
                      </TextBlock>
                      <DataGrid x:Name="dg_bulk_links"
                                MaxHeight="180" BorderThickness="1"
                                BorderBrush="#E2E8F0">
                        <DataGrid.Columns>
                          <DataGridTemplateColumn Header="Apply" Width="50" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                              <DataTemplate>
                                <CheckBox IsChecked="{Binding Apply, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource RowCheck}" Cursor="Hand"/>
                              </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                          </DataGridTemplateColumn>
                          <DataGridTextColumn Header="Linked Model" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                      </DataGrid>
                    </StackPanel>
                  </Border>

                </StackPanel>
              </ScrollViewer>

              <!-- Apply button bar -->
              <Border Grid.Row="2" Background="White"
                      BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,12">
                <Grid>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="btn_bulk_apply"
                            Content="⚡  Apply to Selected Templates"
                            Style="{StaticResource PrimaryBtn}" Height="34" FontSize="13"/>
                    <TextBlock x:Name="lbl_bulk_status" Text=""
                               Foreground="#48BB78" FontSize="11"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
          </TabItem>

          <!-- ── USAGE TAB ── -->
          <TabItem Header="Usage">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Background="#EDF2F7"
                      BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,10">
                <TextBlock x:Name="lbl_usage_header" Style="{StaticResource HelperText}"
                           Text="Select a template to see which views use it."/>
              </Border>
              <DataGrid Grid.Row="1" x:Name="dg_usage" BorderThickness="0">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="View Name"  Binding="{Binding ViewName}"  Width="*"   IsReadOnly="True"/>
                  <DataGridTextColumn Header="View Type"  Binding="{Binding ViewType}"  Width="110" IsReadOnly="True"/>
                  <DataGridTextColumn Header="On Sheet"   Binding="{Binding SheetRef}"  Width="130" IsReadOnly="True"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </TabItem>
        </TabControl>
      </Grid>
    </Grid>

    <!-- ═══ STATUS BAR ═══ -->
    <Border Grid.Row="3" Background="White"
            BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,8">
      <Grid>
        <TextBlock x:Name="lbl_status" Text="" Foreground="#4A5568"
                   VerticalAlignment="Center" FontSize="11"/>
        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                   Text="dbHMS Tools — View Templates Manager"
                   Foreground="#A0AEC0" FontSize="10"/>
      </Grid>
    </Border>
  </Grid>
</Window>
"""

# ═══════════════════════════════════════════════════════════════
# RENAME DIALOG XAML
# ═══════════════════════════════════════════════════════════════

RENAME_XAML = """
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename Template" Width="400" Height="170"
        WindowStartupLocation="CenterOwner"
        Background="#F7FAFC" FontFamily="Segoe UI" FontSize="12"
        ResizeMode="NoResize">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="New template name:" Foreground="#4A5568"
               FontWeight="SemiBold" Margin="0,0,0,6"/>
    <TextBox Grid.Row="1" x:Name="txt_new_name" Height="30"
             BorderBrush="#CBD5E0" Padding="8,4"/>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,10,0,0">
      <Button x:Name="btn_ok"     Content="Rename" Width="80" Height="30" Margin="0,0,8,0"
              Background="#2B6CB0" Foreground="White" FontWeight="SemiBold"
              BorderThickness="0"/>
      <Button x:Name="btn_cancel" Content="Cancel"  Width="70" Height="30"
              Background="#EDF2F7" Foreground="#2D3748" BorderBrush="#CBD5E0" BorderThickness="1"/>
    </StackPanel>
  </Grid>
</Window>
"""

# ═══════════════════════════════════════════════════════════════
# APPLY TO VIEWS DIALOG XAML
# ═══════════════════════════════════════════════════════════════

APPLY_VIEWS_XAML = """
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apply Template to Views" Width="600" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="#F7FAFC" FontFamily="Segoe UI" FontSize="12"
        ResizeMode="CanResizeWithGrip">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#2D3748" Padding="16,12">
      <TextBlock x:Name="lbl_title" Text="Apply Template to Views"
                 Foreground="White" FontSize="16" FontWeight="Bold"/>
    </Border>
    <Border Grid.Row="1" Background="White"
            BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid Width="220" HorizontalAlignment="Left">
          <TextBox x:Name="txt_av_search" Height="28"/>
          <TextBlock Text="Filter views…" Foreground="#A0AEC0" FontSize="11"
                     IsHitTestVisible="False" VerticalAlignment="Center" Margin="8,0"/>
        </Grid>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="btn_av_all"  Content="All"  Width="50" Height="28" Margin="0,0,6,0"
                  Background="#EDF2F7" BorderBrush="#CBD5E0" BorderThickness="1"/>
          <Button x:Name="btn_av_none" Content="None" Width="50" Height="28"
                  Background="#EDF2F7" BorderBrush="#CBD5E0" BorderThickness="1"/>
        </StackPanel>
      </Grid>
    </Border>
    <DataGrid Grid.Row="2" x:Name="dg_av_views"
              Background="White" BorderThickness="0"
              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F4F8"
              RowHeight="26" CanUserAddRows="False" CanUserDeleteRows="False"
              AutoGenerateColumns="False" SelectionMode="Single"
              EnableRowVirtualization="True">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="" Width="34" CanUserResize="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="View Name"  Binding="{Binding ViewName}"  Width="*"  IsReadOnly="True"/>
        <DataGridTextColumn Header="Type"       Binding="{Binding TypeLabel}" Width="100" IsReadOnly="True"/>
        <DataGridTextColumn Header="Current Template" Binding="{Binding CurrentTemplate}" Width="160" IsReadOnly="True"/>
      </DataGrid.Columns>
    </DataGrid>
    <Border Grid.Row="3" Background="White"
            BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
      <Grid>
        <TextBlock x:Name="lbl_av_status" Text="" Foreground="#4A5568"
                   VerticalAlignment="Center" FontSize="11"/>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <Button x:Name="btn_av_apply"  Content="Apply Template" Width="120" Height="30" Margin="0,0,8,0"
                  Background="#2B6CB0" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
          <Button x:Name="btn_av_cancel" Content="Cancel"          Width="70"  Height="30"
                  Background="#EDF2F7" BorderBrush="#CBD5E0" BorderThickness="1"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
"""

# ═══════════════════════════════════════════════════════════════
# PICK CATEGORY DIALOG  (for Bulk Edit → Add Category)
