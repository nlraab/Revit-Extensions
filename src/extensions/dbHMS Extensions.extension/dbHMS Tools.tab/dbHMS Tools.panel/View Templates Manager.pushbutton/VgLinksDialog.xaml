<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="V/G Overrides &#x2014; RVT Link Display Settings"
        Height="720" Width="900"
        MinHeight="560" MinWidth="780"
        WindowStartupLocation="CenterOwner"
        Background="#F7FAFC"
        FontFamily="Segoe UI" FontSize="12"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A202C"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A5568"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style x:Key="HelperText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#718096"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="26"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#1A202C"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse x:Name="outer" Width="14" Height="14"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Stroke="#A0AEC0" StrokeThickness="1.5" Fill="White"/>
                                <Ellipse x:Name="dot" Width="7" Height="7"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Fill="#2B6CB0" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="outer" Property="Stroke" Value="#2B6CB0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="outer" Property="Stroke" Value="#2B6CB0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="outer" Property="Stroke" Value="#CBD5E0"/>
                                <Setter Property="Foreground" Value="#A0AEC0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2B6CB0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="WarnButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="#FEFCBF"/>
            <Setter Property="BorderBrush" Value="#D69E2E"/>
            <Setter Property="Foreground" Value="#744210"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2D3748" Padding="20,12">
            <StackPanel>
                <TextBlock Text="V/G Overrides &#x2014; RVT Link Display Settings"
                           Foreground="White" FontSize="16" FontWeight="Bold"/>
                <TextBlock Foreground="#CBD5E0" FontSize="11" Margin="0,2,0,0"
                           Text="Per-link visibility and display options &#x2014; mirrors Revit's RVT Link Display Settings dialog."/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="txt_lnk_status"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Foreground="#4A5568" FontStyle="Italic"
                           Margin="0,0,12,0" TextTrimming="CharacterEllipsis"
                           Text=""/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btn_lnk_cancel" Content="Close" Style="{StaticResource SecondaryButton}"
                            ToolTip="Close the dialog. Each OK click ran its own Revit Transaction so anything you've already applied is saved."/>
                    <Button x:Name="btn_lnk_ok" Content="OK" Style="{StaticResource PrimaryButton}"
                           />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Top: link picker + Custom escape hatch -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Margin="16,16,16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="RVT link:" VerticalAlignment="Center"
                           Style="{StaticResource FieldLabel}" Margin="0,0,8,0"/>
                <ComboBox  Grid.Column="1" x:Name="cmb_link_picker" Margin="0,0,12,0"/>
                <Button    Grid.Column="2" x:Name="btn_open_native" Content="Open in Revit's native dialog"
                           Style="{StaticResource WarnButton}"
                           ToolTip="Use Revit's built-in dialog for this link &#x2014; only way to set Custom mode."/>
            </Grid>
        </Border>

        <!-- Heads-up — two plain-English limitations -->
        <Border x:Name="bnr_custom" DockPanel.Dock="Top" Background="#FFFBEA"
                BorderBrush="#D69E2E" BorderThickness="1" CornerRadius="3"
                Padding="14,10" Margin="16,0,16,8">
            <StackPanel>
                <TextBlock Foreground="#744210" FontSize="12" FontWeight="SemiBold"
                           Text="Heads up — two things this dialog can't do (Revit API limits):"/>
                <TextBlock Foreground="#744210" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap">
                    <Run FontWeight="SemiBold" Text="1."/>
                    <Run Text="Switch a link to Custom mode. You have to do that yourself in Revit's V/G Overrides dialog &#x2014; click the &quot;Open in Revit's native dialog&quot; button above and Revit will take you there."/>
                </TextBlock>
                <TextBlock Foreground="#744210" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap">
                    <Run FontWeight="SemiBold" Text="2."/>
                    <Run Text="Edit per-category checklists for the linked file (Model / Annotation / Analytical / Import categories). Same fix &#x2014; open Revit's native dialog and tick what you want there."/>
                </TextBlock>
                <TextBlock Foreground="#744210" FontSize="11" Margin="0,4,0,0" FontStyle="Italic"
                           Text="Everything below this banner you CAN change from here, across however many templates you've selected on the main form."/>
            </StackPanel>
        </Border>

        <!-- Single-page layout (no more tabs — the per-link-category tabs were
             only placeholders for things the API can't reach anyway) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16,0,16,16">
            <StackPanel>
                <!-- Visibility mode card -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Visibility mode" Style="{StaticResource SectionHeader}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <RadioButton x:Name="rb_link_byhost"  GroupName="LinkMode" IsChecked="True"
                                         Content="By host view" Margin="0,0,24,0"/>
                            <RadioButton x:Name="rb_link_bylinked" GroupName="LinkMode"
                                         Content="By linked view" Margin="0,0,24,0"/>
                            <RadioButton x:Name="rb_link_custom"  GroupName="LinkMode"
                                         Content="Custom (read-only — set in Revit)"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource HelperText}" Margin="0,10,0,0">
                            <Run FontWeight="SemiBold" Text="By host view —"/>
                            <Run Text="link inherits everything from this template (including any V/G Overrides Model edits you make)."/>
                            <LineBreak/>
                            <Run FontWeight="SemiBold" Text="By linked view —"/>
                            <Run Text="link uses a specific view from inside the linked file, so the host's V/G stops bleeding into the link."/>
                            <LineBreak/>
                            <Run FontWeight="SemiBold" Text="Custom —"/>
                            <Run Text="per-category overrides; configure via Revit's native dialog (see banner above)."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Per-aspect overrides card -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Per-aspect overrides" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Style="{StaticResource HelperText}" TextWrapping="Wrap"
                                   Text="Each aspect can independently follow the host view, follow the linked view, or take a specific value. Phase / Phase filter / Linked view options come from the linked file."/>
                        <Border x:Name="bnr_aspects_custom" Background="#FFFBEA"
                                BorderBrush="#D69E2E" BorderThickness="1" CornerRadius="3"
                                Padding="10,8" Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBlock Foreground="#744210" FontSize="11" TextWrapping="Wrap">
                                <Run FontWeight="SemiBold" Text="Per-aspect editing is unavailable for this link."/>
                                <Run Text=" The link is in Custom mode and the Revit API doesn't allow writing to a Custom-mode link's settings. Switch to By host view or By linked view above (and OK) to enable these fields, or edit them in Revit's native V/G Overrides RVT Links dialog."/>
                            </TextBlock>
                        </Border>

                        <!-- Each row gets its own grid + bottom margin so the
                             list breathes. Labels are right-aligned so the
                             dropdowns line up cleanly. -->
                        <StackPanel Margin="0,14,0,0">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Linked view"
                                           Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Margin="0,0,12,0"/>
                                <ComboBox  Grid.Column="1" x:Name="cmb_lnk_linkedview"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="View filters"
                                           Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Margin="0,0,12,0"/>
                                <ComboBox  Grid.Column="1" x:Name="cmb_lnk_filters"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="View range"
                                           Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Margin="0,0,12,0"/>
                                <ComboBox  Grid.Column="1" x:Name="cmb_lnk_viewrange"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Phase"
                                           Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Margin="0,0,12,0"/>
                                <ComboBox  Grid.Column="1" x:Name="cmb_lnk_phase"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Phase filter"
                                           Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Margin="0,0,12,0"/>
                                <ComboBox  Grid.Column="1" x:Name="cmb_lnk_phasefilter"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Detail level"
                                           Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Margin="0,0,12,0"/>
                                <ComboBox  Grid.Column="1" x:Name="cmb_lnk_detail"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Discipline"
                                           Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Margin="0,0,12,0"/>
                                <ComboBox  Grid.Column="1" x:Name="cmb_lnk_discipline"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Color fill"
                                           Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Margin="0,0,12,0"/>
                                <ComboBox  Grid.Column="1" x:Name="cmb_lnk_colorfill"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Object styles"
                                           Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Margin="0,0,12,0"/>
                                <ComboBox  Grid.Column="1" x:Name="cmb_lnk_objstyles"/>
                            </Grid>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Nested links"
                                           Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Margin="0,0,12,0"/>
                                <ComboBox  Grid.Column="1" x:Name="cmb_lnk_nested"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
