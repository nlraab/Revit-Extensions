<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="V/G Overrides &#x2014; RVT Link Display Settings"
        Height="720" Width="900"
        MinHeight="560" MinWidth="780"
        WindowStartupLocation="CenterOwner"
        Background="#F7FAFC"
        FontFamily="Segoe UI" FontSize="12"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A202C"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A5568"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style x:Key="HelperText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#718096"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="26"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#1A202C"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse x:Name="outer" Width="14" Height="14"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Stroke="#A0AEC0" StrokeThickness="1.5" Fill="White"/>
                                <Ellipse x:Name="dot" Width="7" Height="7"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Fill="#2B6CB0" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="outer" Property="Stroke" Value="#2B6CB0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="outer" Property="Stroke" Value="#2B6CB0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="outer" Property="Stroke" Value="#CBD5E0"/>
                                <Setter Property="Foreground" Value="#A0AEC0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2B6CB0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="WarnButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="#FEFCBF"/>
            <Setter Property="BorderBrush" Value="#D69E2E"/>
            <Setter Property="Foreground" Value="#744210"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2D3748" Padding="20,12">
            <StackPanel>
                <TextBlock Text="V/G Overrides &#x2014; RVT Link Display Settings"
                           Foreground="White" FontSize="16" FontWeight="Bold"/>
                <TextBlock Foreground="#CBD5E0" FontSize="11" Margin="0,2,0,0"
                           Text="Per-link visibility and display options &#x2014; mirrors Revit's RVT Link Display Settings dialog."/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <TextBlock x:Name="txt_lnk_status" HorizontalAlignment="Left" VerticalAlignment="Center"
                           Foreground="#4A5568" FontStyle="Italic"
                           Text="Iter 1: layout preview &#x2014; OK is disabled until iter 4."/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btn_lnk_cancel" Content="Cancel" Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="btn_lnk_ok" Content="OK" Style="{StaticResource PrimaryButton}"
                            IsEnabled="False" ToolTip="Wiring coming in iteration 4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Top: link picker + Custom escape hatch -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Margin="16,16,16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="RVT link:" VerticalAlignment="Center"
                           Style="{StaticResource FieldLabel}" Margin="0,0,8,0"/>
                <ComboBox  Grid.Column="1" x:Name="cmb_link_picker" Margin="0,0,12,0"/>
                <Button    Grid.Column="2" x:Name="btn_open_native" Content="Open in Revit's native dialog"
                           Style="{StaticResource WarnButton}"
                           ToolTip="Use Revit's built-in dialog for this link &#x2014; only way to set Custom mode."/>
            </Grid>
        </Border>

        <!-- Custom-mode notice -->
        <Border x:Name="bnr_custom" DockPanel.Dock="Top" Background="#FFFBEA"
                BorderBrush="#D69E2E" BorderThickness="1" CornerRadius="3"
                Padding="12,8" Margin="16,0,16,8" Visibility="Visible">
            <TextBlock Foreground="#744210" FontSize="11" TextWrapping="Wrap">
                <Run FontWeight="SemiBold" Text="Heads up &#x2014; Custom mode is read-only."/>
                <Run Text=" The Revit API does not allow setting LinkVisibility.Custom. If a link needs Custom (per-category checklists in the tabs below), use the &quot;Open in Revit's native dialog&quot; button above."/>
            </TextBlock>
        </Border>

        <!-- Tabs: Basics + 4 category tabs -->
        <TabControl x:Name="tab_link_settings" Margin="16,0,16,16" Background="White"
                    BorderBrush="#E2E8F0" BorderThickness="1">

            <!-- ============= BASICS TAB ============= -->
            <TabItem Header="Basics">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <!-- Mode radio buttons -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Visibility mode" Style="{StaticResource SectionHeader}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <RadioButton x:Name="rb_link_byhost"  GroupName="LinkMode" IsChecked="True"
                                                 Content="By host view" Margin="0,0,20,0"/>
                                    <RadioButton x:Name="rb_link_bylinked" GroupName="LinkMode"
                                                 Content="By linked view" Margin="0,0,20,0"/>
                                    <RadioButton x:Name="rb_link_custom"  GroupName="LinkMode"
                                                 Content="Custom (read-only via API)" IsEnabled="False"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource HelperText}" Margin="0,8,0,0">
                                    <Run Text="By host view: link inherits all settings from this template."/>
                                    <LineBreak/>
                                    <Run Text="By linked view: link uses a specific view from inside the linked file."/>
                                    <LineBreak/>
                                    <Run Text="Custom: per-category overrides &#x2014; configure via Revit's native dialog."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Per-aspect overrides (only relevant when not ByHostView) -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Per-aspect overrides" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Style="{StaticResource HelperText}"
                                           Text="Each aspect can independently follow the host view, follow the linked view, or use a custom value (where API allows)."/>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Linked view:"
                                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="cmb_lnk_linkedview"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="View filters:"
                                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="cmb_lnk_filters"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="View range:"
                                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <ComboBox  Grid.Row="2" Grid.Column="1" x:Name="cmb_lnk_viewrange"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Phase:"
                                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <ComboBox  Grid.Row="3" Grid.Column="1" x:Name="cmb_lnk_phase"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Phase filter:"
                                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <ComboBox  Grid.Row="4" Grid.Column="1" x:Name="cmb_lnk_phasefilter"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Detail level:"
                                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <ComboBox  Grid.Row="5" Grid.Column="1" x:Name="cmb_lnk_detail"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Discipline:"
                                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <ComboBox  Grid.Row="6" Grid.Column="1" x:Name="cmb_lnk_discipline"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Color fill:"
                                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <ComboBox  Grid.Row="7" Grid.Column="1" x:Name="cmb_lnk_colorfill"/>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Object styles:"
                                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <ComboBox  Grid.Row="8" Grid.Column="1" x:Name="cmb_lnk_objstyles"/>

                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Nested links:"
                                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <ComboBox  Grid.Row="9" Grid.Column="1" x:Name="cmb_lnk_nested"/>
                                </Grid>

                                <CheckBox x:Name="chk_lnk_halftone" Content="Halftone the entire link"
                                          Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============= MODEL CATEGORIES TAB ============= -->
            <TabItem Header="Model Categories">
                <Border Padding="14">
                    <StackPanel>
                        <TextBlock Text="Model Categories (Custom mode only)" Style="{StaticResource SectionHeader}"/>
                        <Border Background="#FFFBEA" BorderBrush="#D69E2E" BorderThickness="1"
                                CornerRadius="3" Padding="10" Margin="0,0,0,10">
                            <TextBlock Foreground="#744210" FontSize="11" TextWrapping="Wrap">
                                <Run Text="The Revit API doesn't expose per-category checklists for linked files. Use "/>
                                <Run FontWeight="SemiBold" Text="Open in Revit's native dialog"/>
                                <Run Text=" above to edit these directly."/>
                            </TextBlock>
                        </Border>
                        <Border Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="3" Padding="14">
                            <TextBlock Style="{StaticResource HelperText}"
                                       Text="When a link is in Custom mode, this tab will show a category checklist mirroring Revit's native UI &#x2014; for visual reference only."/>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- ============= ANNOTATION CATEGORIES TAB ============= -->
            <TabItem Header="Annotation Categories">
                <Border Padding="14">
                    <StackPanel>
                        <TextBlock Text="Annotation Categories (Custom mode only)" Style="{StaticResource SectionHeader}"/>
                        <Border Background="#FFFBEA" BorderBrush="#D69E2E" BorderThickness="1"
                                CornerRadius="3" Padding="10">
                            <TextBlock Foreground="#744210" FontSize="11" TextWrapping="Wrap"
                                       Text="API-only: per-category Annotation overrides for linked files require Revit's native dialog."/>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- ============= ANALYTICAL MODEL CATEGORIES TAB ============= -->
            <TabItem Header="Analytical Model Categories">
                <Border Padding="14">
                    <StackPanel>
                        <TextBlock Text="Analytical Model Categories (Custom mode only)" Style="{StaticResource SectionHeader}"/>
                        <Border Background="#FFFBEA" BorderBrush="#D69E2E" BorderThickness="1"
                                CornerRadius="3" Padding="10">
                            <TextBlock Foreground="#744210" FontSize="11" TextWrapping="Wrap"
                                       Text="API-only: per-category Analytical overrides for linked files require Revit's native dialog."/>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- ============= IMPORT CATEGORIES TAB ============= -->
            <TabItem Header="Import Categories">
                <Border Padding="14">
                    <StackPanel>
                        <TextBlock Text="Import Categories (Custom mode only)" Style="{StaticResource SectionHeader}"/>
                        <Border Background="#FFFBEA" BorderBrush="#D69E2E" BorderThickness="1"
                                CornerRadius="3" Padding="10">
                            <TextBlock Foreground="#744210" FontSize="11" TextWrapping="Wrap"
                                       Text="API-only: per-category Import overrides for linked files require Revit's native dialog."/>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
