<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bulk PDF Sheets"
        Height="780" Width="920"
        MinHeight="560" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="#F7FAFC"
        FontFamily="Segoe UI" FontSize="12"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A202C"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A5568"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>

        <Style x:Key="HelperText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#718096"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="26"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2B6CB0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>

        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- dbHMS branding bar -->
        <Border DockPanel.Dock="Top" Background="#2D3748" Padding="20,14">
            <Grid>
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="Bulk PDF Sheets" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Create one sheet per PDF page and drop the page, centered, on each sheet."
                               Foreground="#CBD5E0" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Opacity="0.85">
                    <TextBlock Text="db" Foreground="#00BFFF" FontSize="32"
                               FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <TextBlock Text=" | " Foreground="#7A8FA6" FontSize="32"
                               FontWeight="Light" VerticalAlignment="Center"/>
                    <TextBlock Text="HMS" Foreground="#00BFFF" FontSize="32"
                               FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock x:Name="txt_status" Text="" Foreground="#4A5568"
                               VerticalAlignment="Center" FontStyle="Italic"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btn_cancel" Content="Cancel" Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="btn_run"    Content="Create Sheets" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body: scrolls if window is short -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="20,16,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" MinWidth="280"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: PDF, title block, numbering, options -->
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="PDF File" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="One sheet will be created per page in this PDF."
                                       Style="{StaticResource HelperText}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txt_pdf_path" Grid.Column="0" IsReadOnly="True"/>
                                <Button  x:Name="btn_browse"   Grid.Column="1" Content="Browse&#x2026;"
                                         Style="{StaticResource SecondaryButton}" MinWidth="90"/>
                            </Grid>
                            <TextBlock x:Name="txt_pdf_info" Style="{StaticResource HelperText}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Title Block" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="Every new sheet will be created with this title block."
                                       Style="{StaticResource HelperText}"/>
                            <ComboBox x:Name="cmb_titleblock" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Numbering" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="Enter the first sheet number. The tool increments the trailing digits (e.g. FA-001 &#x2192; FA-002 &#x2192; FA-003)."
                                       Style="{StaticResource HelperText}"/>
                            <TextBlock Text="First sheet number" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txt_first_number" Text="FA-001"/>
                            <TextBlock x:Name="txt_numbering_preview" Style="{StaticResource HelperText}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="PDF Import" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="Pages are imported at 300 DPI and placed centered on each sheet at 100% scale."
                                       Style="{StaticResource HelperText}"/>
                            <CheckBox x:Name="chk_link" Content="Link the PDF (don't embed)"
                                      Margin="0,8,0,0" IsChecked="False"/>
                            <TextBlock Style="{StaticResource HelperText}" Margin="0,4,0,0"
                                       Text="Linked PDFs keep the .rvt smaller but break if the file moves. Off = embed (default)."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT: Names -->
                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Text="Sheet Names" Style="{StaticResource SectionHeader}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="txt_names_count" Style="{StaticResource HelperText}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource HelperText}"
                                   Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="One name per line. Line 1 becomes the first sheet, line 2 the second, and so on. The number of names determines how many sheets are created."/>
                        <TextBox x:Name="txt_names"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 AcceptsTab="False"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 Height="Auto"
                                 MinHeight="380"
                                 Padding="6,4"
                                 VerticalContentAlignment="Top"/>
                    </DockPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
