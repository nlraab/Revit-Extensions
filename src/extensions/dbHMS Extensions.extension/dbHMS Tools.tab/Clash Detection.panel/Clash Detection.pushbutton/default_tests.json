{
  "$schema_version": 1,
  "$comment": "Firm-wide default clash test library. Option B (broad tests with auto-derived trade tagging). Each clash gets its assignee trade computed from the primary element's category at detection time, so 4 broad tests cover what 17 narrow tests previously did. Add per-project overrides via Test Library if you need project-specific tests (e.g. medical gas piping, MRI clearances, etc.).",
  "tests": [
    {
      "id": "default-mep-internal",
      "name": "MEP Internal Coordination",
      "kind": "hard",
      "tolerance_inches": 0.0,
      "set_a": {
        "source": "host",
        "categories": [
          "OST_DuctCurves", "OST_DuctFitting", "OST_DuctAccessory", "OST_FlexDuctCurves", "OST_DuctTerminal",
          "OST_MechanicalEquipment",
          "OST_PipeCurves", "OST_PipeFitting", "OST_PipeAccessory", "OST_FlexPipeCurves",
          "OST_PlumbingFixtures",
          "OST_Sprinklers",
          "OST_Conduit", "OST_ConduitFitting", "OST_CableTray", "OST_CableTrayFitting",
          "OST_ElectricalEquipment", "OST_ElectricalFixtures", "OST_LightingFixtures",
          "OST_DataDevices", "OST_CommunicationDevices", "OST_TelephoneDevices", "OST_NurseCallDevices", "OST_SecurityDevices"
        ]
      },
      "set_b": {
        "source": "host",
        "categories": [
          "OST_DuctCurves", "OST_DuctFitting", "OST_DuctAccessory", "OST_FlexDuctCurves", "OST_DuctTerminal",
          "OST_MechanicalEquipment",
          "OST_PipeCurves", "OST_PipeFitting", "OST_PipeAccessory", "OST_FlexPipeCurves",
          "OST_PlumbingFixtures",
          "OST_Sprinklers",
          "OST_Conduit", "OST_ConduitFitting", "OST_CableTray", "OST_CableTrayFitting",
          "OST_ElectricalEquipment", "OST_ElectricalFixtures", "OST_LightingFixtures",
          "OST_DataDevices", "OST_CommunicationDevices", "OST_TelephoneDevices", "OST_NurseCallDevices", "OST_SecurityDevices"
        ]
      },
      "default_assignee": "Mechanical"
    },
    {
      "id": "default-mep-vs-architecture",
      "name": "MEP vs Architecture",
      "kind": "hard",
      "tolerance_inches": 0.0,
      "set_a": {
        "source": "host",
        "categories": [
          "OST_DuctCurves", "OST_DuctFitting", "OST_DuctAccessory", "OST_FlexDuctCurves", "OST_DuctTerminal",
          "OST_MechanicalEquipment",
          "OST_PipeCurves", "OST_PipeFitting", "OST_PipeAccessory", "OST_FlexPipeCurves",
          "OST_PlumbingFixtures",
          "OST_Sprinklers",
          "OST_Conduit", "OST_ConduitFitting", "OST_CableTray", "OST_CableTrayFitting",
          "OST_ElectricalEquipment", "OST_ElectricalFixtures", "OST_LightingFixtures",
          "OST_DataDevices", "OST_CommunicationDevices", "OST_TelephoneDevices", "OST_NurseCallDevices", "OST_SecurityDevices"
        ]
      },
      "set_b": {
        "source": ["host", "link:Architectural"],
        "categories": [
          "OST_Walls", "OST_Floors", "OST_Ceilings", "OST_Doors", "OST_Windows", "OST_Roofs", "OST_Stairs"
        ]
      },
      "default_assignee": "Mechanical"
    },
    {
      "id": "default-mep-vs-structure",
      "name": "MEP vs Structure",
      "kind": "hard",
      "tolerance_inches": 0.0,
      "set_a": {
        "source": "host",
        "categories": [
          "OST_DuctCurves", "OST_DuctFitting", "OST_DuctAccessory", "OST_FlexDuctCurves", "OST_DuctTerminal",
          "OST_MechanicalEquipment",
          "OST_PipeCurves", "OST_PipeFitting", "OST_PipeAccessory", "OST_FlexPipeCurves",
          "OST_PlumbingFixtures",
          "OST_Sprinklers",
          "OST_Conduit", "OST_ConduitFitting", "OST_CableTray", "OST_CableTrayFitting",
          "OST_ElectricalEquipment", "OST_ElectricalFixtures", "OST_LightingFixtures",
          "OST_DataDevices", "OST_CommunicationDevices", "OST_TelephoneDevices", "OST_NurseCallDevices", "OST_SecurityDevices"
