<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="780" Width="820"
        MinHeight="640" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Background="#F7FAFC"
        FontFamily="Segoe UI" FontSize="12"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A202C"/><Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A5568"/><Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style x:Key="HelperText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#718096"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="MonoText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#2D3748"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/><Setter Property="Height" Value="26"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,3"/><Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2B6CB0"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="120"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/><Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="Padding" Value="12,6"/><Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/><Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="Padding" Value="8,2"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,0,3"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2D3748" Padding="20,14">
            <Grid>
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="Settings" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Per-machine and per-project configuration for the Clash Detection toolkit."
                               Foreground="#CBD5E0" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.85">
                    <TextBlock Text="db" Foreground="#00BFFF" FontSize="32" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=" | " Foreground="#7A8FA6" FontSize="32" FontWeight="Light" VerticalAlignment="Center"/>
                    <TextBlock Text="HMS" Foreground="#00BFFF" FontSize="32" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <TextBlock x:Name="txt_status" Text="Settings load on first launch; changes here apply immediately."
                           Foreground="#4A5568" VerticalAlignment="Center" FontStyle="Italic"
                           HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btn_close" Content="Close" Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="btn_save" Content="Save Settings" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16,20,16">

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Per-Machine Settings" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Saved to %APPDATA%\dbHMS_clash\config.json on this machine. Set once per machine, used by every Clash Detection tool."
                                   Style="{StaticResource HelperText}"/>

                        <TextBlock Text="Shared clash-data folder" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txt_shared_folder" Grid.Column="0"
                                     Text="T:\_clash_data\"/>
                            <Button x:Name="btn_browse_shared" Grid.Column="1" Content="Browse..."
                                    Style="{StaticResource MiniButton}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            <Button x:Name="btn_open_shared" Grid.Column="2" Content="Open"
                                    Style="{StaticResource MiniButton}" Margin="0,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="One-time setup. The tool creates a per-project subfolder here automatically (named from a hash of the central-model path) so engineers never set anything per project."
                                   Style="{StaticResource HelperText}" Margin="0,4,0,0"/>

                        <TextBlock Text="Display name override (optional)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txt_display_name"/>
                        <TextBlock Text="Defaults to your Autodesk username. Override if you'd rather see &quot;Nathan R.&quot; than the full account name in comments."
                                   Style="{StaticResource HelperText}" Margin="0,2,0,0"/>

                        <TextBlock Text="Warn before loading more than" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="txt_warn_threshold" Text="2000" Width="100"/>
                            <TextBlock Text="  clashes  (Browser asks first if a project has more than this)"
                                       VerticalAlignment="Center" Foreground="#4A5568"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Per-Project Settings" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Saved to the active project's project.json under the shared folder. Visible to everyone on the team."
                                   Style="{StaticResource HelperText}"/>

                        <TextBlock Text="Project display name" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txt_project_name" Text="Sample Project"/>

                        <TextBlock Text="Disciplines used on this project" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="Uncheck any trades that aren't part of this project. Affects the trade pickers in Clash Browser, Test Library, and Reports."
                                   Style="{StaticResource HelperText}" Margin="0,0,0,4"/>
                        <WrapPanel x:Name="wp_disciplines">
                            <CheckBox Content="Mechanical" IsChecked="True" Margin="0,3,12,3"/>
                            <CheckBox Content="Electrical" IsChecked="True" Margin="0,3,12,3"/>
                            <CheckBox Content="Plumbing" IsChecked="True" Margin="0,3,12,3"/>
                            <CheckBox Content="Fire Protection" IsChecked="True" Margin="0,3,12,3"/>
                            <CheckBox Content="Technology" IsChecked="True" Margin="0,3,12,3"/>
                            <CheckBox Content="Architectural" IsChecked="True" Margin="0,3,12,3"/>
                            <CheckBox Content="Structural" IsChecked="True" Margin="0,3,12,3"/>
                        </WrapPanel>

                        <TextBlock Text="Linked model role mapping" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="Tell the tool which linked .rvt file plays which role. Other Clash Detection screens use these roles (Architectural, Structural) so you don't have to remember filenames. Multiple links can share a role (e.g. one architectural link per building); links set to (ignore) are excluded from clash tests entirely."
                                   Style="{StaticResource HelperText}" Margin="0,0,0,4"/>
                        <Border Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="3" Padding="10">
                            <!-- Rows are built at runtime from clash_detect.linked.find_unique_link_titles() -->
                            <StackPanel x:Name="sp_link_map_rows"/>
                        </Border>
                        <TextBlock Text="The list refreshes automatically when you load or unload links in Revit. New links default to (ignore) until you assign a role."
                                   Style="{StaticResource HelperText}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="This Project's Storage" Style="{StaticResource SectionHeader}"/>
                        <Border Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="3" Padding="8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Central model: " Style="{StaticResource HelperText}"/>
                                    <TextBlock Text="T:\Projects\Sample\Sample-Central.rvt" Style="{StaticResource MonoText}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Project hash: " Style="{StaticResource HelperText}"/>
                                    <TextBlock Text="9c1f3a8b2e0d" Style="{StaticResource MonoText}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Storage folder: " Style="{StaticResource HelperText}"/>
                                    <TextBlock Text="T:\_clash_data\9c1f3a8b2e0d\" Style="{StaticResource MonoText}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Button x:Name="btn_open_project_folder" Content="Open project folder"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                Margin="0,8,0,0" MinWidth="0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="About" Style="{StaticResource SectionHeader}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="dbHMS Clash Detection " Foreground="#2D3748" FontWeight="SemiBold"/>
                            <TextBlock Text="v0.1 (UI mockup)" Foreground="#718096"/>
                        </StackPanel>
                        <TextBlock Text="Architecture and feature roadmap: see dbHMS Tools.tab/Clash Detection.panel/README.md in the deployed extension folder."
                                   Style="{StaticResource HelperText}" Margin="0,4,0,0"/>
                        <Button x:Name="btn_open_readme" Content="Open README"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left" Margin="0,8,0,0" MinWidth="0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
