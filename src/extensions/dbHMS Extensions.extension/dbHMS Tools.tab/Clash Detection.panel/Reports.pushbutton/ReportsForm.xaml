<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reports"
        Height="720" Width="820"
        MinHeight="600" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Background="#F7FAFC"
        FontFamily="Segoe UI" FontSize="12"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A202C"/><Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A5568"/><Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style x:Key="HelperText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#718096"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="MonoText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#2D3748"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/><Setter Property="Height" Value="26"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,3"/><Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2B6CB0"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="120"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/><Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="Padding" Value="12,6"/><Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/><Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="Padding" Value="8,2"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,0,3"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2D3748" Padding="20,14">
            <Grid>
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="Reports" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Export the active project's clashes as a BCF 2.1 file for sharing with consultants."
                               Foreground="#CBD5E0" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.85">
                    <TextBlock Text="db" Foreground="#00BFFF" FontSize="32" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=" | " Foreground="#7A8FA6" FontSize="32" FontWeight="Light" VerticalAlignment="Center"/>
                    <TextBlock Text="HMS" Foreground="#00BFFF" FontSize="32" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <TextBlock x:Name="txt_status" Text="Ready - 48 clashes match the current filters."
                           Foreground="#4A5568" VerticalAlignment="Center" FontStyle="Italic"
                           HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btn_close" Content="Close" Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="btn_export" Content="Export" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16,20,16">

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="What to Export" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Filter the clash set being exported. Same filters as the Clash Browser."
                                   Style="{StaticResource HelperText}" Margin="0,0,0,4"/>

                        <TextBlock Text="Trade" Style="{StaticResource FieldLabel}"/>
                        <WrapPanel x:Name="wp_trade_filter">
                            <CheckBox Content="Mechanical" IsChecked="True" Margin="0,3,8,3"/>
                            <CheckBox Content="Electrical" IsChecked="True" Margin="0,3,8,3"/>
                            <CheckBox Content="Plumbing" IsChecked="True" Margin="0,3,8,3"/>
                            <CheckBox Content="Fire Protection" IsChecked="True" Margin="0,3,8,3"/>
                            <CheckBox Content="Technology" IsChecked="True" Margin="0,3,8,3"/>
                            <CheckBox Content="Architectural" IsChecked="True" Margin="0,3,8,3"/>
                            <CheckBox Content="Structural" IsChecked="True" Margin="0,3,8,3"/>
                        </WrapPanel>

                        <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                        <WrapPanel x:Name="wp_status_filter">
                            <CheckBox Content="Open" IsChecked="True" Margin="0,3,8,3"/>
                            <CheckBox Content="Reviewed" IsChecked="True" Margin="0,3,8,3"/>
                            <CheckBox Content="Approved" IsChecked="False" Margin="0,3,8,3"/>
                            <CheckBox Content="Resolved" IsChecked="False" Margin="0,3,8,3"/>
                        </WrapPanel>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Test" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmb_test_filter">
                                    <ComboBoxItem Content="(All tests)" IsSelected="True"/>
                                    <ComboBoxItem Content="Mechanical Ducts vs Plumbing Pipes"/>
                                    <ComboBoxItem Content="Mechanical Ducts vs Electrical Conduit"/>
                                    <ComboBoxItem Content="Plumbing Pipes vs Structural Framing"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Level" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmb_level_filter">
                                    <ComboBoxItem Content="(All levels)" IsSelected="True"/>
                                    <ComboBoxItem Content="Level 1"/>
                                    <ComboBoxItem Content="Level 2"/>
                                    <ComboBoxItem Content="Level 3"/>
                                    <ComboBoxItem Content="Roof"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Date range" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmb_date_filter">
                            <ComboBoxItem Content="All time" IsSelected="True"/>
                            <ComboBoxItem Content="Opened in the last 7 days"/>
                            <ComboBoxItem Content="Opened in the last 30 days"/>
                            <ComboBoxItem Content="Custom range..."/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Output" Style="{StaticResource SectionHeader}"/>

                        <TextBlock Text="Format" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmb_format">
                            <ComboBoxItem Content="BCF 2.1 (.bcfzip — for coordination tools)" IsSelected="True"/>
                            <ComboBoxItem Content="Excel (.xlsx — for internal review / save-as-PDF)"/>
                            <ComboBoxItem Content="HTML summary (.html — for sharing / save-as-PDF in browser)"/>
                        </ComboBox>

                        <TextBlock Text="Output folder" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txt_output_folder" Grid.Column="0"
                                     Text="T:\_clash_data\9c1f3a8b2e0d\reports\"/>
                            <Button x:Name="btn_browse_folder" Grid.Column="1" Content="Browse..."
                                    Style="{StaticResource MiniButton}" Margin="6,0,0,0"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="Filename template" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txt_filename" Text="Sample-Project_clashes_{date}_{filter}.bcf"/>
                        <TextBlock Text="Tokens: {date} = today's date, {filter} = active trade filter, {project} = project name."
                                   Style="{StaticResource HelperText}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Background="#F7FAFC">
                    <StackPanel>
                        <TextBlock Text="Preview" Style="{StaticResource SectionHeader}"/>
                        <TextBlock x:Name="txt_preview" Text="48 clashes will be exported." Foreground="#2D3748"/>
                        <TextBlock Text="Sample-Project_clashes_2026-05-05_All-Trades.bcf"
                                   Style="{StaticResource MonoText}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
