<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Subcategories"
        Height="640" Width="540"
        MinHeight="440" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        Background="#F7FAFC"
        FontFamily="Segoe UI" FontSize="12"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A202C"/><Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style x:Key="HelperText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#718096"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2B6CB0"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="120"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/><Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="Padding" Value="12,6"/><Setter Property="MinWidth" Value="100"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/><Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="Padding" Value="8,2"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/><Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,0,3"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2D3748" Padding="20,12">
            <StackPanel>
                <TextBlock Text="Choose Subcategories to Export" Foreground="White"
                           FontSize="16" FontWeight="Bold"/>
                <TextBlock Text="Uncheck anything you don't want in the walkthrough, then Export."
                           Foreground="#CBD5E0" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <TextBlock x:Name="txt_footer" VerticalAlignment="Center" Foreground="#4A5568"
                           FontStyle="Italic" FontSize="11"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btn_cancel" Content="Cancel" Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="btn_export" Content="Export" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="16,12,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <TextBox x:Name="txt_search" Height="26" Padding="6,3" VerticalContentAlignment="Center"
                         HorizontalAlignment="Stretch" Margin="0,0,150,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btn_all"  Content="Check all"   Style="{StaticResource MiniButton}"/>
                    <Button x:Name="btn_none" Content="Uncheck all" Style="{StaticResource MiniButton}"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="sp_list"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
