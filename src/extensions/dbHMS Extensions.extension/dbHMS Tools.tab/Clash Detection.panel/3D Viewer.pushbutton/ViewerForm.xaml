<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dbHMS 3D Viewer"
        Height="820" Width="1200"
        MinHeight="640" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        Background="#F7FAFC"
        FontFamily="Segoe UI" FontSize="12"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A202C"/><Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A5568"/><Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style x:Key="HelperText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#718096"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="MonoText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#2D3748"/>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2B6CB0"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="120"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/><Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="Padding" Value="12,6"/><Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,0,3"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/><Setter Property="Height" Value="26"/>
        </Style>
        <!-- Collapsible section: a card with an Expander whose header is the section title.
             Custom template so the arrow points RIGHT when open and DOWN when closed. -->
        <Style x:Key="SectionExpander" TargetType="Expander">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Foreground" Value="#1A202C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel LastChildFill="True">
                            <ToggleButton DockPanel.Dock="Top" Focusable="False" Cursor="Hand"
                                          OverridesDefaultStyle="True"
                                          IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="arrow" Text="&#x25B6;" FontSize="11" Foreground="#4A5568"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter TargetName="arrow" Property="Text" Value="&#x25BC;"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter ContentSource="Header"/>
                            </ToggleButton>
                            <ContentPresenter x:Name="body" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="0,2,0,0"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="body" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- dbHMS branding header -->
        <Border DockPanel.Dock="Top" Background="#2D3748" Padding="20,14">
            <Grid>
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="3D Viewer" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Fly through the model and review clashes — no Enscape, no leaving the toolkit."
                               Foreground="#CBD5E0" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.85">
                    <TextBlock Text="db" Foreground="#00BFFF" FontSize="32" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=" | " Foreground="#7A8FA6" FontSize="32" FontWeight="Light" VerticalAlignment="Center"/>
                    <TextBlock Text="HMS" Foreground="#00BFFF" FontSize="32" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer: status + presentation actions -->
        <Border DockPanel.Dock="Bottom" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <TextBlock x:Name="txt_status" Text="Open a 3D view, then Export &amp; Load Model."
                           Foreground="#4A5568" VerticalAlignment="Center" FontStyle="Italic"
                           HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btn_open_browser" Content="Open in Browser"
                            Style="{StaticResource SecondaryButton}"
                            ToolTip="Save a self-contained copy of this model + its clashes that opens in any web browser, so PMs can review without Revit. Export the model first."/>
                    <Button x:Name="btn_popout" Content="Pop Out Render"
                            Style="{StaticResource SecondaryButton}"
                            ToolTip="Move the 3D view into its own window for a second screen."/>
                    <Button x:Name="btn_fullscreen" Content="Full Screen"
                            Style="{StaticResource SecondaryButton}" IsEnabled="False"
                            ToolTip="Make the popped-out render fill the screen for sharing."/>
                    <Button x:Name="btn_close" Content="Close" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body: settings (left) + render host (right) -->
        <Grid Margin="20,16,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="240"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="160"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Model & export (top box, kept first) -->
                    <Border Style="{StaticResource CardBorder}">
                        <Expander Style="{StaticResource SectionExpander}">
                            <Expander.Header><TextBlock Text="Model" Style="{StaticResource SectionHeader}" Margin="0"/></Expander.Header>
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="Export the Revit model once, then fly through it here."
                                           Style="{StaticResource HelperText}" Margin="0,0,0,8"/>
                                <CheckBox x:Name="chk_pick_subcats" Content="Choose subcategories to hide"
                                          Margin="0,0,0,2"/>
                                <TextBlock Text="When on, Export first lets you hide things like equipment Clearances. Off = export everything."
                                           Style="{StaticResource HelperText}" Margin="0,0,0,8"/>
                                <Button x:Name="btn_export" Content="Export &amp; Load Model"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        MinWidth="0" Margin="0,0,0,6" Padding="14,8"/>
                                <Button x:Name="btn_load_last" Content="Load Last Export"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        MinWidth="0" Margin="0,0,0,8" Padding="12,6"/>
                                <TextBlock x:Name="txt_stats" Text="No model loaded yet."
                                           Style="{StaticResource HelperText}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- Navigation -->
                    <Border Style="{StaticResource CardBorder}">
                        <Expander Style="{StaticResource SectionExpander}">
                            <Expander.Header><TextBlock Text="Navigation" Style="{StaticResource SectionHeader}" Margin="0"/></Expander.Header>
                            <StackPanel Margin="0,6,0,0">
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Speed" VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Margin="0"/>
                                    <Slider Grid.Column="1" x:Name="sl_speed" Minimum="0.3" Maximum="30" Value="4"
                                            TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" x:Name="txt_speed_val" Text="4.0 m/s"
                                               VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource MonoText}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Look" VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Margin="0"/>
                                    <Slider Grid.Column="1" x:Name="sl_look" Minimum="0.02" Maximum="0.40" Value="0.10"
                                            TickFrequency="0.01" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" x:Name="txt_look_val" Text="0.10"
                                               VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource MonoText}"/>
                                </Grid>
                                <CheckBox x:Name="chk_invert_look" Content="Invert look (Y)" IsEnabled="False" Margin="0,6,0,0"/>
                                <Border Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                        CornerRadius="3" Padding="8" Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource HelperText}">
                                        <Run Text="Right-drag" FontWeight="Bold"/><Run Text=" look · "/><Run Text="Middle-drag" FontWeight="Bold"/><Run Text=" pan · "/><Run Text="Scroll" FontWeight="Bold"/><Run Text=" zoom · "/><Run Text="F" FontWeight="Bold"/><Run Text=" mouselook · "/><Run Text="WASD" FontWeight="Bold"/><Run Text=" fly · "/><Run Text="Q/E" FontWeight="Bold"/><Run Text=" down/up · "/><Run Text="Shift" FontWeight="Bold"/><Run Text=" faster · "/><Run Text="Left-click" FontWeight="Bold"/><Run Text=" select"/><LineBreak/><Run Text="Xbox controller:" FontWeight="Bold"/><Run Text=" left stick fly, right stick look, LB/RB down/up, RT faster"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- Saved views -->
                    <Border Style="{StaticResource CardBorder}">
                        <Expander Style="{StaticResource SectionExpander}">
                            <Expander.Header><TextBlock Text="Saved Views" Style="{StaticResource SectionHeader}" Margin="0"/></Expander.Header>
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="Save the current view to jump back to it later. Click a saved view to fly there. (Pop Out / Full Screen are in the footer.)"
                                           Style="{StaticResource HelperText}" Margin="0,0,0,6"/>
                                <Button x:Name="btn_saved_views" Content="Save Current View"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        MinWidth="0" Margin="0,0,0,6" Padding="12,6"/>
                                <Border x:Name="brd_viewpoints" Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                        CornerRadius="3" Padding="8" Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource HelperText}" Text="Saved viewpoints list here."/>
                                </Border>
                                <Button x:Name="btn_screenshot" Content="Save Screenshot"
                                        Style="{StaticResource SecondaryButton}" IsEnabled="False"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        MinWidth="0" Margin="0,0,0,6" Padding="12,6"/>
                                <CheckBox x:Name="chk_minimap" Content="Floor-plan minimap" IsChecked="True"/>
                                <TextBlock Style="{StaticResource HelperText}" Margin="0,2,0,0"
                                           Text="Live plan of the floor you're on, with a marker for where you are and which way you're looking. Drag the grip to enlarge it."/>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- Appearance (render quality + environment) -->
                    <Border Style="{StaticResource CardBorder}">
                        <Expander Style="{StaticResource SectionExpander}">
                            <Expander.Header><TextBlock Text="Appearance" Style="{StaticResource SectionHeader}" Margin="0"/></Expander.Header>
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="Render quality" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmb_quality">
                                    <ComboBoxItem Content="Draft"/>
                                    <ComboBoxItem Content="Shaded" IsSelected="True"/>
                                    <ComboBoxItem Content="Realistic"/>
                                </ComboBox>
                                <TextBlock Style="{StaticResource HelperText}" Margin="0,2,0,0"
                                           Text="Draft = fast flat fly-through. Shaded = lit, real material colors. Realistic adds sky lighting, shadows and reflections."/>
                                <CheckBox x:Name="chk_edges" Content="Show edges" Margin="0,8,0,0"/>
                                <CheckBox x:Name="chk_section_box" Content="Section box" IsEnabled="False"/>
                                <CheckBox x:Name="chk_perf" Content="Performance mode (smoother)" Margin="0,3,0,0"/>
                                <TextBlock Style="{StaticResource HelperText}" Margin="0,2,0,0"
                                           Text="Renders a touch below native for a higher frame rate. Best for the popped-out, full-screen view."/>
                                <TextBlock Text="Environment" Style="{StaticResource SectionHeader}" Margin="0,12,0,4"/>
                                <StackPanel>
                                    <TextBlock Text="Time of day" Style="{StaticResource HelperText}"/>
                                    <Slider x:Name="sl_time_of_day" Minimum="0" Maximum="24" Value="12"/>
                                    <TextBlock Text="Sun strength" Style="{StaticResource HelperText}" Margin="0,4,0,0"/>
                                    <Slider x:Name="sl_sun_strength" Minimum="0" Maximum="100" Value="70"/>
                                    <TextBlock Text="Sun direction" Style="{StaticResource HelperText}" Margin="0,4,0,0"/>
                                    <Slider x:Name="sl_sun_direction" Minimum="0" Maximum="360" Value="135"/>
                                    <CheckBox x:Name="chk_ground" Content="Show ground" IsChecked="True" Margin="0,8,0,0"/>
                                    <TextBlock Text="Sits below the whole model, so it never hides underground plumbing." Style="{StaticResource HelperText}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- Visibility (model on/off) -->
                    <Border Style="{StaticResource CardBorder}">
                        <Expander Style="{StaticResource SectionExpander}">
                            <Expander.Header><TextBlock Text="Visibility" Style="{StaticResource SectionHeader}" Margin="0"/></Expander.Header>
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="Turn whole models off, or individual categories within each model. Instant — nothing re-exports."
                                           Style="{StaticResource HelperText}" Margin="0,0,0,6"/>
                                <Border x:Name="brd_models" Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                        CornerRadius="3" Padding="8">
                                    <TextBlock Style="{StaticResource HelperText}" Text="Your model and each linked model — with their categories — list here after a model loads."/>
                                </Border>
                                <TextBlock Text="Worksets &amp; Levels (coming)" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Style="{StaticResource HelperText}"
                                           Text="Per-model workset and level toggles are the next step in this phase."/>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- Clashes -->
                    <Border Style="{StaticResource CardBorder}">
                        <Expander Style="{StaticResource SectionExpander}">
                            <Expander.Header><TextBlock Text="Clashes" Style="{StaticResource SectionHeader}" Margin="0"/></Expander.Header>
                            <StackPanel Margin="0,6,0,0">
                                <CheckBox x:Name="chk_clash_markers" Content="Show clash markers" IsChecked="False"/>
                                <TextBlock Text="Filter the list, then click a clash to fly to it. Turn on markers to drop dots in the view for the filtered clashes."
                                           Style="{StaticResource HelperText}" Margin="0,4,0,6"/>

                                <!-- Filters: built from this project's clashes; hidden until a model loads -->
                                <StackPanel x:Name="sp_clash_filters" Visibility="Collapsed">
                                    <TextBlock Text="Trade" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel x:Name="sp_clash_trades"/>
                                    <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel x:Name="sp_clash_status"/>
                                    <TextBlock Text="Type" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel x:Name="sp_clash_kind"/>
                                    <TextBlock Text="Search" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txt_clash_search"/>
                                    <TextBlock x:Name="lbl_clash_count" Style="{StaticResource HelperText}" Margin="0,6,0,2"/>
                                </StackPanel>

                                <Border x:Name="brd_clashes" Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                        CornerRadius="3" Padding="8" Margin="0,4,0,0">
                                    <TextBlock Style="{StaticResource HelperText}" Text="Clashes list here after a model loads."/>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- Selection -->
                    <Border Style="{StaticResource CardBorder}">
                        <Expander Style="{StaticResource SectionExpander}">
                            <Expander.Header><TextBlock Text="Selection" Style="{StaticResource SectionHeader}" Margin="0"/></Expander.Header>
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="Click an element (when not in F mouselook) to highlight it and see its details — category, name, model, level, workset — right in the view. Full parameter list and pick-what-to-show come later."
                                           Style="{StaticResource HelperText}"/>
                            </StackPanel>
                        </Expander>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Drag to resize the settings panel (wider when the render is undocked). -->
            <GridSplitter Grid.Column="1" Width="8" VerticalAlignment="Stretch" HorizontalAlignment="Center"
                          Background="#E2E8F0" Cursor="SizeWE"
                          ToolTip="Drag to resize — widen the panel when the render is on another screen"/>

            <!-- Render host: WebView2 attaches here. Kept clean for sharing. -->
            <Border Grid.Column="2" x:Name="brd_viewport"
                    Background="#1A202C" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                <TextBlock Text="Loading 3D engine..." Foreground="#A0AEC0"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
