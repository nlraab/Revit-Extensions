<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dbHMS 3D Viewer"
        Height="820" Width="1200"
        MinHeight="640" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        Background="#1A202C"
        FontFamily="Segoe UI" FontSize="12"
        ResizeMode="CanResizeWithGrip">

    <!-- Bare chrome. The entire tool UI (header, tabs, panels, toolbar, inspector)
         now lives in the web page (web/viewer3.html); this window is just a host
         for the WebView2 control, which attaches to brd_viewport and fills the
         whole window. Keeping the canvas full-window (no WPF sidebar reflow) also
         keeps the WebView2 surface path simple for the high-DPI fix (Track D). -->
    <Border x:Name="brd_viewport" Background="#1A202C">
        <TextBlock Text="Loading 3D engine…" Foreground="#A0AEC0"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
</Window>
