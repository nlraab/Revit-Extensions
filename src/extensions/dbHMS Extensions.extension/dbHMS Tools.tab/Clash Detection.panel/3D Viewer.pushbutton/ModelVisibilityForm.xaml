<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Model Visibility"
        Height="620" Width="600"
        MinHeight="420" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="#F7FAFC"
        FontFamily="Segoe UI" FontSize="12"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A202C"/><Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="HelperText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#718096"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2B6CB0"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="110"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/><Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="Padding" Value="12,6"/><Setter Property="MinWidth" Value="90"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/><Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="Padding" Value="8,2"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/><Setter Property="FontSize" Value="11"/>
        </Style>
        <!-- blue checkbox: filled brand-blue box + white check when on -->
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="16" Height="16" CornerRadius="4"
                                    BorderBrush="#CBD5E0" BorderThickness="1.5" Background="White"
                                    VerticalAlignment="Center" SnapsToDevicePixels="True">
                                <Viewbox x:Name="chk" Width="10" Height="10" Visibility="Collapsed"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M0,5 L3.8,9 L10,0.5" Stroke="White" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Viewbox>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#2B6CB0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="#2B6CB0"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="#2B6CB0"/>
                                <Setter TargetName="chk" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2D3748" Padding="20,12">
            <StackPanel>
                <TextBlock x:Name="txt_title" Text="Model Visibility" Foreground="White"
                           FontSize="16" FontWeight="Bold"/>
                <TextBlock Text="Turn categories and worksets on or off, then Apply."
                           Foreground="#CBD5E0" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btn_cancel" Content="Cancel" Style="{StaticResource SecondaryButton}"/>
                <Button x:Name="btn_apply" Content="Apply" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Border>

        <Grid Margin="16,14,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Categories -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <TextBlock Text="Model Categories" Style="{StaticResource SectionHeader}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="btn_cats_all"  Content="All"  Style="{StaticResource MiniButton}"/>
                            <Button x:Name="btn_cats_none" Content="None" Style="{StaticResource MiniButton}"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="sp_cats"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Worksets -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <TextBlock Text="Worksets" Style="{StaticResource SectionHeader}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="btn_ws_all"  Content="All"  Style="{StaticResource MiniButton}"/>
                            <Button x:Name="btn_ws_none" Content="None" Style="{StaticResource MiniButton}"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="sp_ws"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
