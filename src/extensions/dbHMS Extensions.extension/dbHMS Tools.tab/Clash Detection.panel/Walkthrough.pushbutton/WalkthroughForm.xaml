<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dbHMS Walkthrough"
        Height="780" Width="980"
        MinHeight="640" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="#F7FAFC"
        FontFamily="Segoe UI" FontSize="12"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        Focusable="True">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A202C"/><Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A5568"/><Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style x:Key="HelperText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#718096"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="MonoText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#2D3748"/>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2B6CB0"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="120"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/><Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="Padding" Value="12,6"/><Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,0,3"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- dbHMS branding header with active-mode indicator on the right -->
        <Border DockPanel.Dock="Top" Background="#2D3748" Padding="20,14">
            <Grid>
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="Walkthrough" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Free-fly through the building. WASD + mouse-look. Click into the look pad to capture."
                               Foreground="#CBD5E0" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="brd_active_indicator"
                            Background="#48BB78" CornerRadius="3" Padding="10,4"
                            Margin="0,0,16,0" Visibility="Collapsed">
                        <TextBlock Text="● ACTIVE" Foreground="White"
                                   FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Opacity="0.85">
                        <TextBlock Text="db" Foreground="#00BFFF" FontSize="32" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text=" | " Foreground="#7A8FA6" FontSize="32" FontWeight="Light" VerticalAlignment="Center"/>
                        <TextBlock Text="HMS" Foreground="#00BFFF" FontSize="32" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer: status + Render + Close -->
        <Border DockPanel.Dock="Bottom" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <TextBlock x:Name="txt_status" Text="Click Open Walkthrough View to begin."
                           Foreground="#4A5568" VerticalAlignment="Center" FontStyle="Italic"
                           HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btn_render" Content="📷 Render" Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="btn_close"  Content="Close"     Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body: visibility + bookmarks (left), look pad + controls (right) -->
        <Grid Margin="20,16,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="280"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- Left column -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Visibility -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Visibility" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="Toggle disciplines on/off as you walk through. Hide architectural to expose all the MEP."
                                       Style="{StaticResource HelperText}" Margin="0,0,0,6"/>
                            <CheckBox x:Name="chk_vis_mechanical"      Content="Mechanical"      IsChecked="True"/>
                            <CheckBox x:Name="chk_vis_electrical"      Content="Electrical"      IsChecked="True"/>
                            <CheckBox x:Name="chk_vis_plumbing"        Content="Plumbing"        IsChecked="True"/>
                            <CheckBox x:Name="chk_vis_fireprotection"  Content="Fire Protection" IsChecked="True"/>
                            <CheckBox x:Name="chk_vis_architectural"   Content="Architectural"   IsChecked="True"/>
                            <CheckBox x:Name="chk_vis_structural"      Content="Structural"      IsChecked="True"/>
                        </StackPanel>
                    </Border>

                    <!-- Bookmarks -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Bookmarks" Style="{StaticResource SectionHeader}"/>
                                <Button Grid.Column="1" x:Name="btn_save_bookmark"
                                        Content="+ Save current view"
                                        Style="{StaticResource MiniButton}"/>
                            </Grid>
                            <TextBlock Text="Saved per-project on the shared root — the team sees the same set."
                                       Style="{StaticResource HelperText}" Margin="0,0,0,6"/>
                            <ListBox x:Name="lb_bookmarks" Height="240"
                                     BorderBrush="#E2E8F0" BorderThickness="1"/>
                            <TextBlock x:Name="txt_bookmark_hint"
                                       Text="Double-click to jump. Right-click to delete."
                                       Style="{StaticResource HelperText}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Right column: speed + look-sensitivity sliders, Open button,
                 controls cheatsheet with small click-to-rotate look pad. -->
            <DockPanel Grid.Column="2">

                <!-- Movement + look sensitivity sliders -->
                <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Movement" Style="{StaticResource SectionHeader}"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Move speed" VerticalAlignment="Center"
                                       Style="{StaticResource FieldLabel}" Margin="0"/>
                            <Slider Grid.Column="1" x:Name="sl_speed"
                                    Minimum="2" Maximum="60" Value="10"
                                    TickFrequency="2" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="txt_speed_value"
                                       Text="10 ft/s" VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       Style="{StaticResource MonoText}"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Look speed" VerticalAlignment="Center"
                                       Style="{StaticResource FieldLabel}" Margin="0"/>
                            <Slider Grid.Column="1" x:Name="sl_look_sensitivity"
                                    Minimum="0.02" Maximum="0.30" Value="0.06"
                                    TickFrequency="0.01" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="txt_look_sensitivity_value"
                                       Text="0.06" VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       Style="{StaticResource MonoText}"/>
                        </Grid>

                        <TextBlock Style="{StaticResource HelperText}" Margin="0,8,0,0">
                            <Run Text="Hold "/><Run Text="Shift" FontWeight="SemiBold"/><Run Text=" to fly faster, "/><Run Text="Ctrl" FontWeight="SemiBold"/><Run Text=" to slow down."/>
                        </TextBlock>

                        <Border Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="3" Padding="8" Margin="0,10,0,0">
                            <StackPanel>
                                <CheckBox x:Name="chk_continuous_fly" Content="Smooth fly mode (stay simplified)"
                                          FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource HelperText}" Margin="0,4,0,0">
                                    <Run Text="Keeps the view in a lighter style the whole time you walk, so flying stays smooth and stopping is instant — never pausing to re-render."/>
                                    <LineBreak/>
                                    <Run Text="Tradeoff: the model looks simpler (Shaded) while this is on. Best on heavy models. Turn off for full-quality stills."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Open Walkthrough View button -->
                <Button DockPanel.Dock="Top" x:Name="btn_open_view"
                        Content="Open Walkthrough View"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch" Margin="0,0,0,10"
                        HorizontalContentAlignment="Center" MinWidth="0"
                        Padding="14,8"/>

                <!-- Controls cheatsheet on the left, small click-to-rotate
                     look pad on the right. -->
                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Controls" Style="{StaticResource SectionHeader}"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="F" Style="{StaticResource MonoText}" FontWeight="Bold" Foreground="#2B6CB0"/>
                                <TextBlock Grid.Column="1" Text="Toggle mouselook (mouse only looks; can't click in Revit)" Style="{StaticResource HelperText}"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="W A S D" Style="{StaticResource MonoText}" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="Walk where you're looking; A/D strafe horizontally" Style="{StaticResource HelperText}"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Q / E" Style="{StaticResource MonoText}" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="Move down / up (always world-vertical)" Style="{StaticResource HelperText}"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Shift / Ctrl" Style="{StaticResource MonoText}" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="Speed up (3×) / slow down (¼×)" Style="{StaticResource HelperText}"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Esc" Style="{StaticResource MonoText}" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="Exit mouselook" Style="{StaticResource HelperText}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Click+drag →" Style="{StaticResource MonoText}" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="Quick rotate without entering mouselook" Style="{StaticResource HelperText}"/>
                            </Grid>
                        </StackPanel>

                        <!-- Small look pad — click and drag inside for quick rotates. -->
                        <Border Grid.Column="1" x:Name="brd_lookpad"
                                Background="#1A202C" Cursor="Hand"
                                Focusable="True"
                                Width="120" Height="100"
                                VerticalAlignment="Top" Margin="8,0,0,0"
                                CornerRadius="3">
                            <Grid>
                                <StackPanel x:Name="sp_lookpad_hint"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="◎" Foreground="#A0AEC0" FontSize="22"
                                               FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="click+drag" Foreground="#A0AEC0"
                                               FontSize="10" HorizontalAlignment="Center"
                                               Margin="0,2,0,0"/>
                                    <TextBlock Text="to rotate" Foreground="#A0AEC0"
                                               FontSize="10" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="txt_lookpad_active"
                                           Text="● LOOKING"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Foreground="#48BB78" FontWeight="Bold" FontSize="11"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
