<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Project Parameter"
        Height="640" Width="560"
        MinHeight="520" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="#F7FAFC"
        FontFamily="Segoe UI" FontSize="12"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A202C"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A5568"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style x:Key="HelperText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#718096"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#1A202C"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse x:Name="outer" Width="14" Height="14"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Stroke="#A0AEC0" StrokeThickness="1.5" Fill="White"/>
                                <Ellipse x:Name="dot" Width="7" Height="7"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Fill="#2B6CB0" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="outer" Property="Stroke" Value="#2B6CB0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="outer" Property="Stroke" Value="#2B6CB0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2B6CB0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- HEADER (sub-dialog: no wordmark, smaller title) -->
        <Border DockPanel.Dock="Top" Background="#2D3748" Padding="20,12">
            <StackPanel>
                <TextBlock Text="New Project Parameter" Foreground="White"
                           FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Define a parameter and bind it to one or more categories in this project."
                           Foreground="#CBD5E0" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- FOOTER -->
        <Border DockPanel.Dock="Bottom" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource HelperText}"
                           VerticalAlignment="Center"
                           Text="Iteration 1: layout only. Create is disabled."/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btn_np_cancel" Content="Cancel"
                            Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="btn_np_create" Content="Create"
                            Style="{StaticResource PrimaryButton}" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BODY -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16,12">
            <StackPanel>

                <!-- Source -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Source" Style="{StaticResource SectionHeader}"/>
                        <RadioButton x:Name="rb_src_existing"
                                     Content="Existing shared parameter (from firm .txt)"
                                     GroupName="src" IsChecked="True" Margin="0,2,0,2"/>
                        <RadioButton x:Name="rb_src_new_shared"
                                     Content="New shared parameter (writes to .txt)"
                                     GroupName="src" IsEnabled="False" Margin="0,2,0,2"/>
                        <RadioButton x:Name="rb_src_project_only"
                                     Content="Project-only parameter (not shareable)"
                                     GroupName="src" Margin="0,2,0,2"/>

                        <!-- Existing-shared sub-fields -->
                        <Border x:Name="panel_src_existing" Background="#F7FAFC"
                                BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="3" Padding="8" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Shared parameter file" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txt_sp_file"
                                         Text="(firm shared parameters file path)"
                                         IsReadOnly="True"/>
                                <TextBlock Text="Group" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmb_sp_group">
                                    <ComboBoxItem Content="dbHMS_Sheets" IsSelected="True"/>
                                    <ComboBoxItem Content="dbHMS_Equipment"/>
                                    <ComboBoxItem Content="dbHMS_Rooms"/>
                                </ComboBox>
                                <TextBlock Text="Parameter" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmb_sp_param">
                                    <ComboBoxItem Content="Permit Set" IsSelected="True"/>
                                    <ComboBoxItem Content="Bid Set"/>
                                    <ComboBoxItem Content="Issue 50% CD"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- Project-only sub-fields -->
                        <Border x:Name="panel_src_project" Background="#F7FAFC"
                                BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="3" Padding="8" Margin="0,8,0,0"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txt_proj_name"/>
                                <TextBlock Text="Data type" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmb_proj_type">
                                    <ComboBoxItem Content="Text" IsSelected="True"/>
                                    <ComboBoxItem Content="Yes/No"/>
                                    <ComboBoxItem Content="Integer"/>
                                    <ComboBoxItem Content="Number"/>
                                    <ComboBoxItem Content="Length"/>
                                    <ComboBoxItem Content="Area"/>
                                    <ComboBoxItem Content="Volume"/>
                                    <ComboBoxItem Content="URL"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Bindings -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Bindings" Style="{StaticResource SectionHeader}"/>

                        <TextBlock Text="Parameter group (where it appears in the properties palette)"
                                   Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmb_np_group">
                            <ComboBoxItem Content="Identity Data" IsSelected="True"/>
                            <ComboBoxItem Content="Text"/>
                            <ComboBoxItem Content="Other"/>
                            <ComboBoxItem Content="Graphics"/>
                            <ComboBoxItem Content="Constraints"/>
                            <ComboBoxItem Content="Dimensions"/>
                            <ComboBoxItem Content="Electrical"/>
                            <ComboBoxItem Content="Mechanical"/>
                            <ComboBoxItem Content="Plumbing"/>
                        </ComboBox>

                        <TextBlock Text="Instance or type" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Vertical" Margin="0,2,0,0">
                            <RadioButton x:Name="rb_inst" Content="Instance" GroupName="instType"
                                         IsChecked="True" Margin="0,2,0,2"/>
                            <RadioButton x:Name="rb_type" Content="Type" GroupName="instType" Margin="0,2,0,2"/>
                        </StackPanel>

                        <TextBlock Text="Categories" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Style="{StaticResource HelperText}" Margin="0,0,0,4"
                                   Text="Pick the categories the new parameter will be bound to."/>
                        <TextBox x:Name="txt_cat_search" Margin="0,0,0,4"/>
                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3"
                                Padding="6" Height="160">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="np_category_list"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Limitation note -->
                <Border Background="#FFFBEA" BorderBrush="#D69E2E" BorderThickness="1"
                        CornerRadius="3" Padding="10">
                    <StackPanel>
                        <TextBlock Foreground="#744210" FontWeight="SemiBold"
                                   Text="Heads up"/>
                        <TextBlock Foreground="#744210" Margin="0,4,0,0" TextWrapping="Wrap"
                                   FontSize="11"
                                   Text="Revit doesn't let you change Instance/Type or the parameter group after a parameter is created. The Parameters Management tool offers a recreate flow that preserves existing values - this will be available in a later iteration."/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
