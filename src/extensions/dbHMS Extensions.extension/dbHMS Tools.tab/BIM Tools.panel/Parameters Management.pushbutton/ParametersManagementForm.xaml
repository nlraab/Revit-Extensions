<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parameters Management"
        Height="820" Width="1180"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#F7FAFC"
        FontFamily="Segoe UI" FontSize="12"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- ===== Typography ===== -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A365D"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- section tick accents: blue by default, orange where it matters -->
        <Style x:Key="Tick" TargetType="Border">
            <Setter Property="Width" Value="3"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Background" Value="#2B6CB0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="TickOrange" TargetType="Border" BasedOn="{StaticResource Tick}">
            <Setter Property="Background" Value="#EE8A34"/>
        </Style>

        <!-- orange count pill: hugs the live count of what will actually be written -->
        <Style x:Key="CountPill" TargetType="Border">
            <Setter Property="Background" Value="#FBEEDD"/>
            <Setter Property="BorderBrush" Value="#E7B183"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="9,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A5568"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style x:Key="HelperText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#718096"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="MonoText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#2D3748"/>
        </Style>
        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="VariesText" TargetType="TextBlock">
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="#A0AEC0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ===== Inputs ===== -->
        <!-- ===== dbHMS standard dropdown (canonical) =====================
             Flat, rounded, custom chevron, hover + focus states. Mirrors the
             clash web <select>. Keep ComboToggle above the ComboBox style (it
             is referenced by StaticResource) and keep the ComboBoxItem style
             with it. Copy this whole block verbatim into every tool. -->
        <Style x:Key="ComboToggle" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="White" BorderBrush="#CBD5E0"
                                BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
                            <Path x:Name="arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,10,0" Data="M0,0 L4,4 L8,0" Stroke="#718096"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#A0AEC0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2B6CB0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Style="{StaticResource ComboToggle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,26,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Focusable="True"
                                     IsReadOnly="{TemplateBinding IsReadOnly}" Margin="7,0,26,0"
                                     VerticalAlignment="Center" Background="Transparent" BorderThickness="0"/>
                            <Popup x:Name="Popup" Placement="Bottom" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="White" BorderBrush="#CBD5E0"
                                            BorderThickness="1" CornerRadius="6" Margin="0,3,0,0"/>
                                    <ScrollViewer Margin="4,7,4,4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="34"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#A0AEC0"/>
                            </Trigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter Property="IsTabStop" Value="False"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ib" Background="Transparent" CornerRadius="4"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ib" Property="Background" Value="#EBF3FB"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ib" Property="Background" Value="#EBF8FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- Native checkbox on purpose: this tool uses three-state (mixed-value)
             checkboxes, which the blue templated checkbox cannot render, so it keeps
             the native control so the indeterminate "mixed" state stays visible. -->
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Properly-sized centered radio bullet (firm standard) -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#1A202C"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse x:Name="outer" Width="14" Height="14"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Stroke="#A0AEC0" StrokeThickness="1.5" Fill="White"/>
                                <Ellipse x:Name="dot" Width="7" Height="7"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Fill="#2B6CB0" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="outer" Property="Stroke" Value="#2B6CB0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="outer" Property="Stroke" Value="#2B6CB0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Cards ===== -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- ===== Buttons ===== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2B6CB0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <!-- Pill-shaped toggle button used for filter chips (matches Sheet Manager) -->
        <Style x:Key="ChipToggle" TargetType="ToggleButton">
            <Setter Property="Background"      Value="#EDF2F7"/>
            <Setter Property="Foreground"      Value="#2D3748"/>
            <Setter Property="BorderBrush"     Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="10,3"/>
            <Setter Property="Margin"          Value="0,0,6,4"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked"   Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </MultiTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background"  Value="#2B6CB0"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2B6CB0"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The Filter toggle button (compact pill with a triangle, matches Sheet Manager) -->
        <Style x:Key="FilterToggle" TargetType="ToggleButton">
            <Setter Property="Background"      Value="#EDF2F7"/>
            <Setter Property="Foreground"      Value="#2D3748"/>
            <Setter Property="BorderBrush"     Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="12,4"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background"  Value="#2B6CB0"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2B6CB0"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== TabControl chrome ===== -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#F7FAFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#4A5568"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder" Padding="16,10"
                                BorderBrush="#E2E8F0" BorderThickness="0,0,0,2"
                                Background="Transparent">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#2B6CB0"/>
                                <Setter Property="Foreground" Value="#2B6CB0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#2B6CB0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- dbHMS header: deep-blue dotted ground, solid orange baseline, brand logo -->
        <Border DockPanel.Dock="Top" BorderBrush="#EE8A34" BorderThickness="0,0,0,3">
            <Grid>
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#143257" Offset="0"/>
                        <GradientStop Color="#0F2748" Offset="0.55"/>
                        <GradientStop Color="#0B1D34" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>

                <!-- faint light dot texture, faded out toward the orange baseline -->
                <Rectangle>
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
                            <GradientStop Color="#FFFFFFFF" Offset="0.5"/>
                            <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile" Stretch="None"
                                      Viewport="0,0,16,16" ViewportUnits="Absolute"
                                      Viewbox="0,0,16,16" ViewboxUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing Brush="#26D6ECFF">
                                    <GeometryDrawing.Geometry>
                                        <EllipseGeometry Center="8,8" RadiusX="1.1" RadiusY="1.1"/>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- title (left) + brand logo (right) -->
                <Grid Margin="24,16">
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="Parameters Management" Foreground="#F2F7FC" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Bulk-edit, administer, transform and exchange parameters across the project."
                                   Foreground="#A9C2D8" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Image x:Name="img_logo" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Height="38" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== FOOTER ===== -->
        <Border DockPanel.Dock="Bottom" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="footer_status"
                           Text="Iteration 2: Bulk Edit wired end-to-end. Project Parameters / Transform / Export still preview only."
                           Foreground="#4A5568" FontStyle="Italic"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btn_close" Content="Close"
                            Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== TAB CONTROL ===== -->
        <TabControl Margin="16,12,16,8">

            <!-- =========================================================== -->
            <!-- TAB 1: BULK EDIT                                            -->
            <!-- =========================================================== -->
            <TabItem Header="Bulk Edit">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top strip: category picker + selection count -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Category:" Style="{StaticResource FieldLabel}"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="cmb_category">
                                <ComboBoxItem Content="Sheets" IsSelected="True"/>
                                <ComboBoxItem Content="Views (coming soon)" IsEnabled="False"/>
                                <ComboBoxItem Content="Mechanical Equipment (coming soon)" IsEnabled="False"/>
                                <ComboBoxItem Content="Electrical Equipment (coming soon)" IsEnabled="False"/>
                                <ComboBoxItem Content="Plumbing Fixtures (coming soon)" IsEnabled="False"/>
                                <ComboBoxItem Content="Rooms (coming soon)" IsEnabled="False"/>
                                <ComboBoxItem Content="Spaces (coming soon)" IsEnabled="False"/>
                            </ComboBox>
                            <TextBlock Grid.Column="2"/>
                            <TextBlock Grid.Column="3" x:Name="lbl_selection_count"
                                       Text="0 of 0 selected"
                                       Style="{StaticResource HelperText}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Main 2-column work area -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="420" MinWidth="320"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*" MinWidth="380"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: element list (sheets) -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header row -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource Tick}"/>
                                        <TextBlock Text="Sheets in project"
                                                   Style="{StaticResource SectionHeader}" Margin="0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="btn_select_all" Content="All"
                                                Style="{StaticResource MiniButton}"/>
                                        <Button x:Name="btn_select_none" Content="None"
                                                Style="{StaticResource MiniButton}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Search box + Filter toggle (matches Sheet Manager layout) -->
                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Search with magnifying-glass placeholder -->
                                    <Grid Grid.Column="0" Margin="0,0,6,0">
                                        <TextBox x:Name="txt_sheet_search" Height="28"
                                                 VerticalContentAlignment="Center" Padding="8,0"/>
                                        <TextBlock x:Name="txt_sheet_search_hint"
                                                   Text="&#x1F50D;  Search sheets..."
                                                   Foreground="#A0AEC0"
                                                   IsHitTestVisible="False"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"/>
                                    </Grid>

                                    <!-- Filter toggle -->
                                    <ToggleButton Grid.Column="1" x:Name="btn_filter_toggle"
                                                  Style="{StaticResource FilterToggle}"
                                                  Height="28"
                                                  ToolTip="Show / hide filter chips">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#x25BD;" FontSize="13" Margin="0,0,6,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="Filter" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ToggleButton>
                                </Grid>

                                <!-- Filter pane (collapsible) -->
                                <Border Grid.Row="2" x:Name="filter_panel"
                                        Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                        CornerRadius="3" Padding="8" Margin="0,0,0,8"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Prefix:" FontWeight="SemiBold"
                                                       Foreground="#4A5568" FontSize="11"
                                                       VerticalAlignment="Center"/>
                                            <WrapPanel x:Name="pnl_filter_prefixes" Grid.Column="1"/>
                                        </Grid>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Series:" FontWeight="SemiBold"
                                                       Foreground="#4A5568" FontSize="11"
                                                       VerticalAlignment="Center"/>
                                            <WrapPanel x:Name="pnl_filter_series" Grid.Column="1"/>
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="lbl_filter_summary" Grid.Column="0"
                                                       Foreground="#718096" FontSize="11"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" x:Name="btn_filter_reset"
                                                    Content="Reset Filters"
                                                    Style="{StaticResource MiniButton}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Sheet list -->
                                <ScrollViewer Grid.Row="3"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="sheet_list"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- RIGHT: parameter editor. Orange rail marks the operation
                             payload: these are the values that get written on Apply. -->
                        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="0" Padding="0">
                          <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#EE8A34" CornerRadius="4,0,0,4"/>
                            <Grid Grid.Column="1" Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Style="{StaticResource TickOrange}"/>
                                    <TextBlock Text="Parameters"
                                               Style="{StaticResource SectionHeader}" Margin="0"/>
                                </StackPanel>

                                <!-- Legend -->
                                <Border Grid.Row="1" Background="#F7FAFC"
                                        BorderBrush="#E2E8F0" BorderThickness="1"
                                        CornerRadius="3" Padding="8" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Legend: " Style="{StaticResource HelperText}"
                                                   VerticalAlignment="Center"/>
                                        <CheckBox IsChecked="True" IsHitTestVisible="False" Focusable="False"
                                                  VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="on every selected sheet"
                                                   Style="{StaticResource HelperText}"
                                                   VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        <CheckBox IsChecked="False" IsHitTestVisible="False" Focusable="False"
                                                  VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="on none"
                                                   Style="{StaticResource HelperText}"
                                                   VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        <CheckBox x:Name="chk_legend_mixed" IsThreeState="True"
                                                  IsHitTestVisible="False" Focusable="False"
                                                  VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="mixed (some but not all)"
                                                   Style="{StaticResource HelperText}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Search / filter for parameters -->
                                <Grid Grid.Row="2" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="txt_param_search"/>
                                    <Button Grid.Column="1" x:Name="btn_reset_changes"
                                            Content="Reset Changes"
                                            Style="{StaticResource SecondaryButton}"
                                            IsEnabled="False"/>
                                </Grid>

                                <!-- Parameter rows, grouped -->
                                <ScrollViewer Grid.Row="3"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="param_list"/>
                                </ScrollViewer>
                            </Grid>
                          </Grid>
                        </Border>
                    </Grid>

                    <!-- Apply strip -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- orange pill: live count of parameter changes that will be written -->
                            <Border x:Name="pill_pending_changes" Style="{StaticResource CountPill}"
                                    Margin="0,0,8,0" Visibility="Collapsed">
                                <TextBlock x:Name="lbl_pending_count" Text="0"
                                           Foreground="#9C4221" FontWeight="Bold" FontSize="11"/>
                            </Border>
                            <TextBlock x:Name="lbl_pending_changes"
                                       Text="No pending changes."
                                       Style="{StaticResource HelperText}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="btn_apply_bulk"
                                Content="Apply changes"
                                Style="{StaticResource PrimaryButton}"
                                IsEnabled="False"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- =========================================================== -->
            <!-- TAB 2: PROJECT PARAMETERS                                   -->
            <!-- =========================================================== -->
            <TabItem Header="Project Parameters">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header strip with action buttons -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Style="{StaticResource Tick}"/>
                                <TextBlock Text="All parameters bound to this project"
                                           Style="{StaticResource SectionHeader}" Margin="0"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource HelperText}">
                                <Run Text="Includes both shared and project-only parameters. "/><Run Text="In-use count" FontWeight="SemiBold"/><Run Text=" is the number of elements with a non-empty value (loaded on demand)."/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="btn_new_param" Content="New parameter..."
                                    Style="{StaticResource PrimaryButton}"/>
                            <Button x:Name="btn_bind_categories" Content="Bind to categories..."
                                    Style="{StaticResource SecondaryButton}"
                                    IsEnabled="False"/>
                            <Button x:Name="btn_delete_param" Content="Delete"
                                    Style="{StaticResource SecondaryButton}"
                                    IsEnabled="False"/>
                        </StackPanel>
                    </Grid>

                    <!-- Filter -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="txt_admin_search"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                            <Button x:Name="btn_admin_refresh" Content="Refresh"
                                    Style="{StaticResource MiniButton}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Table card -->
                    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Column headers -->
                            <Border Grid.Row="0" Background="#EDF2F7"
                                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                                    Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.5*" MinWidth="180"/>
                                        <ColumnDefinition Width="1.2*" MinWidth="110"/>
                                        <ColumnDefinition Width="0.9*" MinWidth="80"/>
                                        <ColumnDefinition Width="0.8*" MinWidth="70"/>
                                        <ColumnDefinition Width="2.5*" MinWidth="180"/>
                                        <ColumnDefinition Width="0.7*" MinWidth="60"/>
                                        <ColumnDefinition Width="0.7*" MinWidth="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Name" FontWeight="SemiBold" Foreground="#2D3748"/>
                                    <TextBlock Grid.Column="1" Text="Group" FontWeight="SemiBold" Foreground="#2D3748"/>
                                    <TextBlock Grid.Column="2" Text="Type" FontWeight="SemiBold" Foreground="#2D3748"/>
                                    <TextBlock Grid.Column="3" Text="Inst / Type" FontWeight="SemiBold" Foreground="#2D3748"/>
                                    <TextBlock Grid.Column="4" Text="Categories" FontWeight="SemiBold" Foreground="#2D3748"/>
                                    <TextBlock Grid.Column="5" Text="Shared" FontWeight="SemiBold" Foreground="#2D3748"/>
                                    <TextBlock Grid.Column="6" Text="In use" FontWeight="SemiBold" Foreground="#2D3748"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <StackPanel x:Name="admin_param_list"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Footer note + export -->
                    <Grid Grid.Row="3" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource HelperText}"
                                   VerticalAlignment="Center">
                            <Run Text="Note: changing Instance/Type or the parameter group after creation requires recreating the parameter. Values are preserved during recreate."/>
                        </TextBlock>
                        <Button Grid.Column="1" x:Name="btn_export_selected"
                                Content="Export selected..."
                                Style="{StaticResource SecondaryButton}"
                                IsEnabled="False"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- =========================================================== -->
            <!-- TAB 3: TRANSFORM VALUES                                     -->
            <!-- =========================================================== -->
            <TabItem Header="Transform Values">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" MinWidth="320"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*" MinWidth="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: operation config -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Style="{StaticResource Tick}"/>
                                        <TextBlock Text="Operation" Style="{StaticResource SectionHeader}" Margin="0"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource HelperText}" Margin="0,0,0,8"
                                               Text="Pick what you want to do. The form below adapts to the selected operation."/>
                                    <ComboBox x:Name="cmb_transform_op">
                                        <ComboBoxItem Content="Copy values: A to B" IsSelected="True"/>
                                        <ComboBoxItem Content="Find and replace"/>
                                        <ComboBoxItem Content="Concatenate from pattern"/>
                                        <ComboBoxItem Content="Math: A op B to C"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <!-- Copy panel -->
                            <Border x:Name="panel_copy" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Style="{StaticResource Tick}"/>
                                        <TextBlock Text="Copy A to B" Style="{StaticResource SectionHeader}" Margin="0"/>
                                    </StackPanel>
                                    <TextBlock Text="Source parameter" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cmb_copy_src">
                                        <ComboBoxItem Content="Sheet Number" IsSelected="True"/>
                                        <ComboBoxItem Content="Sheet Name"/>
                                        <ComboBoxItem Content="Drawn By"/>
                                        <ComboBoxItem Content="Permit Set"/>
                                    </ComboBox>
                                    <TextBlock Text="Destination parameter" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cmb_copy_dst">
                                        <ComboBoxItem Content="Original Sheet Number" IsSelected="True"/>
                                        <ComboBoxItem Content="Sheet Number Archive"/>
                                        <ComboBoxItem Content="Old Sheet Name"/>
                                    </ComboBox>
                                    <TextBlock Text="If destination is non-empty:" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Orientation="Vertical" Margin="0,2,0,0">
                                        <RadioButton x:Name="rb_copy_skip" Content="Skip" GroupName="copy_strategy" Margin="0,2,0,2" IsChecked="True"/>
                                        <RadioButton x:Name="rb_copy_overwrite" Content="Overwrite" GroupName="copy_strategy" Margin="0,2,0,2"/>
                                        <RadioButton x:Name="rb_copy_append" Content="Append" GroupName="copy_strategy" Margin="0,2,0,2"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Find/Replace panel -->
                            <Border x:Name="panel_replace" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Style="{StaticResource Tick}"/>
                                        <TextBlock Text="Find and replace" Style="{StaticResource SectionHeader}" Margin="0"/>
                                    </StackPanel>
                                    <TextBlock Text="Target parameter" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cmb_replace_target">
                                        <ComboBoxItem Content="Sheet Name" IsSelected="True"/>
                                        <ComboBoxItem Content="Drawn By"/>
                                        <ComboBoxItem Content="Designed By"/>
                                    </ComboBox>
                                    <TextBlock Text="Find" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txt_replace_find"/>
                                    <TextBlock Text="Replace with" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txt_replace_with"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <CheckBox x:Name="chk_replace_case" Content="Match case" Margin="0,0,12,0"/>
                                        <CheckBox x:Name="chk_replace_word" Content="Whole word" Margin="0,0,12,0"/>
                                        <CheckBox x:Name="chk_replace_regex" Content="Regex"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Concat panel -->
                            <Border x:Name="panel_concat" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Style="{StaticResource Tick}"/>
                                        <TextBlock Text="Concatenate from pattern" Style="{StaticResource SectionHeader}" Margin="0"/>
                                    </StackPanel>
                                    <TextBlock Text="Destination parameter" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cmb_concat_dst">
                                        <ComboBoxItem Content="Sheet Title Block Text" IsSelected="True"/>
                                        <ComboBoxItem Content="Sheet Reference"/>
                                    </ComboBox>
                                    <TextBlock Text="Pattern" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txt_concat_pattern"/>
                                    <Border Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                            CornerRadius="3" Padding="8" Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource HelperText}" FontWeight="SemiBold"
                                                       Text="Available tokens"/>
                                            <TextBlock Style="{StaticResource MonoText}" Margin="0,4,0,0"
                                                       TextWrapping="Wrap"
                                                       xml:space="preserve">{Sheet Number}  {Sheet Name}  {Discipline}  {Sequence}  {Drawn By}  {Checked By}  {Sheet Issue Date}</TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Math panel -->
                            <Border x:Name="panel_math" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Style="{StaticResource Tick}"/>
                                        <TextBlock Text="Math: A op B to C" Style="{StaticResource SectionHeader}" Margin="0"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource HelperText}" Margin="0,0,0,8"
                                               Text="Works on numeric/length/volume parameters. B can be another parameter or a literal."/>
                                    <TextBlock Text="Operand A" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cmb_math_a">
                                        <ComboBoxItem Content="Length" IsSelected="True"/>
                                        <ComboBoxItem Content="Width"/>
                                        <ComboBoxItem Content="Area"/>
                                    </ComboBox>
                                    <TextBlock Text="Operator" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cmb_math_op">
                                        <ComboBoxItem Content="+ (add)" IsSelected="True"/>
                                        <ComboBoxItem Content="- (subtract)"/>
                                        <ComboBoxItem Content="x (multiply)"/>
                                        <ComboBoxItem Content="/ (divide)"/>
                                    </ComboBox>
                                    <TextBlock Text="Operand B (parameter or literal)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txt_math_b" Text="0"/>
                                    <TextBlock Text="Destination C" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cmb_math_c">
                                        <ComboBoxItem Content="Computed Total" IsSelected="True"/>
                                        <ComboBoxItem Content="Effective Area"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <!-- Scope -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Style="{StaticResource Tick}"/>
                                        <TextBlock Text="Scope" Style="{StaticResource SectionHeader}" Margin="0"/>
                                    </StackPanel>
                                    <TextBlock Text="Apply transform to:" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Orientation="Vertical" Margin="0,2,0,0">
                                        <RadioButton x:Name="rb_scope_selection" Content="Selection from Bulk Edit tab"
                                                     GroupName="scope" Margin="0,2,0,2" IsChecked="True"/>
                                        <RadioButton x:Name="rb_scope_all" Content="All sheets in the project"
                                                     GroupName="scope" Margin="0,2,0,2"/>
                                        <RadioButton x:Name="rb_scope_filter" Content="Sheets matching filter..."
                                                     GroupName="scope" Margin="0,2,0,2"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- RIGHT: preview -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource Tick}"/>
                                    <TextBlock Text="Preview" Style="{StaticResource SectionHeader}" Margin="0"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="btn_transform_preview"
                                        Content="Refresh preview"
                                        Style="{StaticResource SecondaryButton}"
                                        IsEnabled="False"/>
                            </Grid>

                            <TextBlock Grid.Row="1" Style="{StaticResource HelperText}" Margin="0,0,0,8"
                                       Text="Shows what each element's value would become. Nothing is written until you click Apply."/>

                            <!-- Preview table -->
                            <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#EDF2F7" Padding="8,6"
                                            BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="120"/>
                                                <ColumnDefinition Width="*" MinWidth="120"/>
                                                <ColumnDefinition Width="*" MinWidth="120"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Element" FontWeight="SemiBold" Foreground="#2D3748"/>
                                            <TextBlock Grid.Column="1" Text="Before" FontWeight="SemiBold" Foreground="#2D3748"/>
                                            <TextBlock Grid.Column="2" Text="After" FontWeight="SemiBold" Foreground="#2D3748"/>
                                        </Grid>
                                    </Border>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="transform_preview_list"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="3" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="lbl_transform_status"
                                           Text="Preview shows 0 elements."
                                           Style="{StaticResource HelperText}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" x:Name="btn_transform_apply"
                                        Content="Apply transform"
                                        Style="{StaticResource PrimaryButton}"
                                        IsEnabled="False"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- =========================================================== -->
            <!-- TAB 4: EXPORT / IMPORT                                      -->
            <!-- =========================================================== -->
            <TabItem Header="Export / Import">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="380"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*" MinWidth="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- EXPORT -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Style="{StaticResource Tick}"/>
                                <TextBlock Text="Export parameter definitions"
                                           Style="{StaticResource SectionHeader}" Margin="0"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource HelperText}" Margin="0,0,0,8"
                                       Text="Pick which project parameters to snapshot. The JSON includes name, type, group, instance/type, category bindings and shared-parameter GUID where applicable. Values are not exported."/>

                            <Grid Grid.Row="2" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="txt_export_search"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                    <Button x:Name="btn_export_all" Content="All" Style="{StaticResource MiniButton}"/>
                                    <Button x:Name="btn_export_none" Content="None" Style="{StaticResource MiniButton}"/>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="export_param_list"/>
                            </ScrollViewer>

                            <Grid Grid.Row="4" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="lbl_export_count"
                                           Text="0 parameters selected" Style="{StaticResource HelperText}"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1" x:Name="btn_export_to_file"
                                        Content="Export to JSON..."
                                        Style="{StaticResource PrimaryButton}"
                                        IsEnabled="False"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- IMPORT -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Style="{StaticResource Tick}"/>
                                <TextBlock Text="Import parameter definitions"
                                           Style="{StaticResource SectionHeader}" Margin="0"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource HelperText}" Margin="0,0,0,8"
                                       Text="Load a JSON snapshot. Each row's status shows whether the parameter is New, already exists, or conflicts (type mismatch). Pick which to import."/>

                            <Grid Grid.Row="2" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="txt_import_path"
                                         IsReadOnly="True"
                                         Text="No file loaded."/>
                                <Button Grid.Column="1" x:Name="btn_import_choose"
                                        Content="Choose JSON..."
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="6,0,0,0"/>
                            </Grid>

                            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="import_param_list"/>
                            </ScrollViewer>

                            <Grid Grid.Row="4" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="lbl_import_count"
                                           Text="No file loaded." Style="{StaticResource HelperText}"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1" x:Name="btn_import_apply"
                                        Content="Import selected"
                                        Style="{StaticResource PrimaryButton}"
                                        IsEnabled="False"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
