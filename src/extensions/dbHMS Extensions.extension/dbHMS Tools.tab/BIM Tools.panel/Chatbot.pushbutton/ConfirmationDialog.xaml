<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm action"
        Height="540" Width="720"
        MinHeight="320" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        Background="#F7FAFC"
        FontFamily="Segoe UI" FontSize="12"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Standard styles, copied per the firm's "self-contained pushbutton" rule. -->
        <Style x:Key="HelperText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#718096"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2B6CB0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Slate header bar -->
        <Border DockPanel.Dock="Top" Background="#2D3748" Padding="20,12">
            <StackPanel>
                <TextBlock x:Name="txt_title" Text="Confirm action"
                           Foreground="White" FontSize="16" FontWeight="Bold"/>
                <TextBlock x:Name="txt_subtitle"
                           Foreground="#CBD5E0" FontSize="12"
                           Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Footer (Cancel | Confirm) -->
        <Border DockPanel.Dock="Bottom" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btn_cancel" Content="Cancel"
                        Style="{StaticResource SecondaryButton}"/>
                <Button x:Name="btn_confirm" Content="Confirm"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Border>

        <!-- Body: optional intro text + preview table + optional footnote.
             HorizontalScrollBarVisibility MUST be Disabled - if it's Auto,
             the ScrollViewer gives inner content unlimited horizontal width,
             which collapses the table's Star-sized columns down to the
             RichTextBox minimum width and makes text wrap at every
             character. Disabled forces the body to fit the viewport so
             Star sizing actually distributes width proportionally. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="20,16,20,16">
            <StackPanel HorizontalAlignment="Stretch">
                <TextBlock x:Name="txt_intro"
                           Style="{StaticResource HelperText}"
                           Margin="0,0,0,10" Text="" Visibility="Collapsed"/>
                <StackPanel x:Name="pnl_grid" HorizontalAlignment="Stretch"/>
                <Border x:Name="bnr_footnote"
                        Background="#FFFBEA" BorderBrush="#D69E2E"
                        BorderThickness="1" CornerRadius="3"
                        Padding="10" Margin="0,12,0,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="txt_footnote"
                               Foreground="#744210" FontSize="11"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
