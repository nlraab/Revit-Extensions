<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="View Templates Manager"
        Height="820" Width="1180"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#F7FAFC"
        FontFamily="Segoe UI" FontSize="12"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- ===== Typography ===== -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A202C"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A5568"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style x:Key="HelperText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#718096"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ColumnHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="VariesText" TargetType="TextBlock">
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="#A0AEC0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ===== Inputs ===== -->
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Properly-sized centered radio bullet (firm standard) -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#1A202C"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse x:Name="outer" Width="14" Height="14"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Stroke="#A0AEC0" StrokeThickness="1.5" Fill="White"/>
                                <Ellipse x:Name="dot" Width="7" Height="7"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Fill="#2B6CB0" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="outer" Property="Stroke" Value="#2B6CB0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="outer" Property="Stroke" Value="#2B6CB0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Cards ===== -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- ===== Buttons ===== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2B6CB0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <Style x:Key="EditButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2B6CB0"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- ===== Expander (sections) =====
             Full custom Template so we can:
               - replace the default chevron with a disclosure arrow that
                 points right (&#x25B8;) when collapsed and down (&#x25BE;) when expanded
               - keep the gray-bar / blue-stripe header, but at a more
                 reasonable 13pt instead of the loud 15pt -->
        <Style x:Key="SectionExpander" TargetType="Expander">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Top" Cursor="Hand"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="Transparent" BorderThickness="0" Padding="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#EDF2F7" BorderBrush="#CBD5E0"
                                                BorderThickness="0,0,0,2" Padding="6,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="arrow" Text="&#x25B8;" Width="14"
                                                           FontSize="12" VerticalAlignment="Center"
                                                           Foreground="#4A5568" Margin="0,0,4,0"/>
                                                <Border Width="3" Height="20" Background="#2B6CB0"
                                                        CornerRadius="2" Margin="0,0,10,0"/>
                                                <ContentPresenter VerticalAlignment="Center"
                                                                  TextBlock.FontSize="15"
                                                                  TextBlock.FontWeight="ExtraBold"
                                                                  TextBlock.Foreground="#1A202C"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="arrow" Property="Text" Value="&#x25BE;"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter ContentSource="Header"/>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Parameter row layout (shared via control template idea — using a simple Border) ===== -->
        <Style x:Key="ParamRow" TargetType="Border">
            <Setter Property="Padding" Value="0,3"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#F1F5F9"/>
        </Style>

        <!-- ===== Type chips on left ===== -->
        <Style x:Key="ChipButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="#EDF2F7"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ============= HEADER (dbHMS branding) ============= -->
        <Border DockPanel.Dock="Top" Background="#2D3748" Padding="20,14">
            <Grid>
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="View Templates Manager" Foreground="White"
                               FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Edit and bulk-modify view templates &#x2014; mirrors Revit's native template editor."
                               Foreground="#CBD5E0" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Opacity="0.85">
                    <TextBlock Text="db" Foreground="#00BFFF" FontSize="32"
                               FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <TextBlock Text=" | " Foreground="#7A8FA6" FontSize="32"
                               FontWeight="Light" VerticalAlignment="Center"/>
                    <TextBlock Text="HMS" Foreground="#00BFFF" FontSize="32"
                               FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============= BULK BANNER (yellow when 2+ selected) =============
             Visibility="Hidden" reserves layout space so the form does not
             jump when bulk mode toggles on/off. Only the bnr_bulk Border
             gets toggled in code; the slot height stays constant. -->
        <Border x:Name="bnr_bulk" DockPanel.Dock="Top" Visibility="Hidden"
                Background="#FFFBEA" BorderBrush="#D69E2E" BorderThickness="0,0,0,1"
                Padding="20,8" Height="56">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="txt_bulk_banner" Foreground="#744210" FontWeight="SemiBold"
                           FontSize="12"
                           Text="Bulk mode: editing 0 templates &#x2014; rows whose Value reads (varies) are skipped on Apply."/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="Include checkbox: " Foreground="#744210" FontSize="11"
                               VerticalAlignment="Center"/>
                    <CheckBox IsChecked="True" IsHitTestVisible="False" Focusable="False"
                              VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="controlled on every selected template" Foreground="#744210"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <CheckBox IsChecked="False" IsHitTestVisible="False" Focusable="False"
                              VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="not controlled" Foreground="#744210" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <CheckBox x:Name="chk_legend_mixed" IsThreeState="True"
                              IsHitTestVisible="False" Focusable="False"
                              VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="mixed (some but not all)" Foreground="#744210" FontSize="11"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ============= FOOTER ============= -->
        <Border DockPanel.Dock="Bottom" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock x:Name="txt_status" Text="" Foreground="#4A5568"
                               VerticalAlignment="Center" FontStyle="Italic"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btn_close" Content="Done" Style="{StaticResource SecondaryButton}"
                            ToolTip="Close the window. Every Apply Changes / OK click during this session ran its own Revit Transaction, so all your edits are already saved in the project."/>
                    <Button x:Name="btn_apply" Content="Apply Changes" Style="{StaticResource PrimaryButton}"
                            IsEnabled="False"
                            ToolTip="Write the spec'd parameter rows back to the checked template(s). Disabled when no template is selected."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============= MAIN CONTENT ============= -->
        <Grid Margin="20,16,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="280"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="540"/>
            </Grid.ColumnDefinitions>

            <!-- =========== LEFT COLUMN: TEMPLATE LIST =========== -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Templates" Style="{StaticResource SectionHeader}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="btn_tpl_refresh" Content="&#x21BB;"
                                    Style="{StaticResource MiniButton}" ToolTip="Reload templates from project"/>
                            <Button x:Name="btn_tpl_all"  Content="All"   Style="{StaticResource MiniButton}"/>
                            <Button x:Name="btn_tpl_none" Content="None"  Style="{StaticResource MiniButton}"/>
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="txt_tpl_search" DockPanel.Dock="Top" Margin="0,0,0,8"
                             ToolTip="Filter templates by name"/>
                    <WrapPanel x:Name="pnl_tpl_chips" DockPanel.Dock="Top" Margin="0,0,0,4"
                               Orientation="Horizontal"/>
                    <TextBlock x:Name="txt_tpl_summary" DockPanel.Dock="Bottom"
                               Style="{StaticResource HelperText}" Margin="0,8,0,0"
                               Text="0 templates &#x2014; load to populate."/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="pnl_tpl_list"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- =========== RIGHT COLUMN: PARAMETER TABLE =========== -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0">
                <DockPanel>
                    <!-- Header above table: template name + view count -->
                    <Border DockPanel.Dock="Top" Background="White" Padding="14,14,14,16"
                            BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock x:Name="txt_right_title" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#1A202C" Text="Select a template on the left"/>
                                <TextBlock x:Name="txt_right_subtitle" FontSize="11" Foreground="#718096"
                                           Margin="0,2,0,0"
                                           Text="Edit one template, or check 2+ to bulk-edit."/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="txt_views_using" FontSize="11" Foreground="#4A5568"
                                           VerticalAlignment="Center" Margin="0,0,12,0"
                                           Text="Number of views with this template assigned: 0"/>
                                <CheckBox x:Name="chk_show_analytical" Content="Show Analytical"
                                          ToolTip="Show the V/G Overrides Analytical Model row (hidden by default for MEP)."
                                          FontSize="11" Foreground="#4A5568" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Column headers (sticky above scroller) -->
                    <Border DockPanel.Dock="Top" Background="#EDF2F7" Padding="14,8"
                            BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*" MinWidth="180"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition x:Name="col_apply_hdr" Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Parameter" Style="{StaticResource ColumnHeader}"/>
                            <TextBlock Grid.Column="1" Text="Value"     Style="{StaticResource ColumnHeader}"/>
                            <TextBlock Grid.Column="2" Text="Include"   Style="{StaticResource ColumnHeader}"
                                       HorizontalAlignment="Center"
                                       ToolTip="When unchecked, the template ignores this parameter on views it's applied to."/>
                            <TextBlock Grid.Column="3" x:Name="hdr_apply" Text="Apply"
                                       Style="{StaticResource ColumnHeader}"
                                       HorizontalAlignment="Center"
                                       ToolTip="Bulk mode: check rows you want to propagate to all selected templates."/>
                        </Grid>
                    </Border>

                    <!-- Scrollable parameter sections -->
                    <ScrollViewer x:Name="scr_params" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="14,8,14,12">
                        <StackPanel x:Name="pnl_param_sections">

                            <!-- =========== SECTION: VIEW (basic) =========== -->
                            <Expander x:Name="exp_view" Header="View" Style="{StaticResource SectionExpander}">
                                <StackPanel Margin="2,4,0,8">
                                    <!-- View Scale -->
                                    <Border Style="{StaticResource ParamRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="*" MinWidth="180"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="View Scale" Style="{StaticResource ParamLabel}"/>
                                            <ComboBox  Grid.Column="1" x:Name="cmb_scale" Margin="0,2,8,2"/>
                                            <CheckBox  Grid.Column="2" x:Name="chk_inc_scale"/>
                                            <CheckBox  Grid.Column="3" x:Name="chk_app_scale"/>
                                        </Grid>
                                    </Border>
                                    <!-- Scale Value 1: -->
                                    <Border Style="{StaticResource ParamRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="*" MinWidth="180"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Scale Value 1:" Style="{StaticResource ParamLabel}"
                                                       Foreground="#A0AEC0"/>
                                            <TextBlock Grid.Column="1" x:Name="txt_scale_value" Margin="0,0,8,0"
                                                       VerticalAlignment="Center" Foreground="#A0AEC0" Text="-"/>
                                        </Grid>
                                    </Border>
                                    <!-- Display Model -->
                                    <Border Style="{StaticResource ParamRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="*" MinWidth="180"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Display Model" Style="{StaticResource ParamLabel}"/>
                                            <ComboBox  Grid.Column="1" x:Name="cmb_display_model" Margin="0,2,8,2"/>
                                            <CheckBox  Grid.Column="2" x:Name="chk_inc_display_model"/>
                                            <CheckBox  Grid.Column="3" x:Name="chk_app_display_model"/>
                                        </Grid>
                                    </Border>
                                    <!-- Detail Level -->
                                    <Border Style="{StaticResource ParamRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="*" MinWidth="180"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Detail Level" Style="{StaticResource ParamLabel}"/>
                                            <ComboBox  Grid.Column="1" x:Name="cmb_detail" Margin="0,2,8,2"/>
                                            <CheckBox  Grid.Column="2" x:Name="chk_inc_detail"/>
                                            <CheckBox  Grid.Column="3" x:Name="chk_app_detail"/>
                                        </Grid>
                                    </Border>
                                    <!-- Parts Visibility -->
                                    <Border Style="{StaticResource ParamRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="*" MinWidth="180"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Parts Visibility" Style="{StaticResource ParamLabel}"/>
                                            <ComboBox  Grid.Column="1" x:Name="cmb_parts" Margin="0,2,8,2"/>
                                            <CheckBox  Grid.Column="2" x:Name="chk_inc_parts"/>
                                            <CheckBox  Grid.Column="3" x:Name="chk_app_parts"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Expander>

                            <!-- =========== SECTION: VISIBILITY / GRAPHICS OVERRIDES =========== -->
                            <Expander x:Name="exp_vg" Header="Visibility / Graphics Overrides"
                                      Style="{StaticResource SectionExpander}">
                                <StackPanel Margin="2,4,0,8">
                                    <!-- Model -->
                                    <Border Style="{StaticResource ParamRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="*" MinWidth="180"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="V/G Overrides Model" Style="{StaticResource ParamLabel}"/>
                                            <Button    Grid.Column="1" x:Name="btn_vg_model"     Content="Edit&#x2026;"
                                                       Style="{StaticResource EditButton}" Margin="0,0,8,0"/>
                                            <CheckBox  Grid.Column="2" x:Name="chk_inc_vg_model"/>
                                            <CheckBox  Grid.Column="3" x:Name="chk_app_vg_model"/>
                                        </Grid>
                                    </Border>
                                    <!-- Annotation -->
                                    <Border Style="{StaticResource ParamRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="*" MinWidth="180"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="V/G Overrides Annotation" Style="{StaticResource ParamLabel}"/>
                                            <Button    Grid.Column="1" x:Name="btn_vg_annotation" Content="Edit&#x2026;"
                                                       Style="{StaticResource EditButton}" Margin="0,0,8,0"/>
                                            <CheckBox  Grid.Column="2" x:Name="chk_inc_vg_annotation"/>
                                            <CheckBox  Grid.Column="3" x:Name="chk_app_vg_annotation"/>
                                        </Grid>
                                    </Border>
                                    <!-- Analytical Model (hidden by default) -->
                                    <Border x:Name="row_vg_analytical" Style="{StaticResource ParamRow}" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="*" MinWidth="180"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="V/G Overrides Analytical Model" Style="{StaticResource ParamLabel}"/>
                                            <Button    Grid.Column="1" x:Name="btn_vg_analytical" Content="Edit&#x2026;"
                                                       Style="{StaticResource EditButton}" Margin="0,0,8,0"/>
                                            <CheckBox  Grid.Column="2" x:Name="chk_inc_vg_analytical"/>
                                            <CheckBox  Grid.Column="3" x:Name="chk_app_vg_analytical"/>
                                        </Grid>
                                    </Border>
                                    <!-- Import (CAD) -->
                                    <Border Style="{StaticResource ParamRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="*" MinWidth="180"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="V/G Overrides Import" Style="{StaticResource ParamLabel}"/>
                                            <Button    Grid.Column="1" x:Name="btn_vg_import" Content="Edit&#x2026;"
                                                       Style="{StaticResource EditButton}" Margin="0,0,8,0"
                                                       ToolTip="Edit imported categories &#x2014; expand each CAD link to toggle individual layers."/>
                                            <CheckBox  Grid.Column="2" x:Name="chk_inc_vg_import"/>
                                            <CheckBox  Grid.Column="3" x:Name="chk_app_vg_import"/>
                                        </Grid>
                                    </Border>
                                    <!-- Filters -->
                                    <Border Style="{StaticResource ParamRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="*" MinWidth="180"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="V/G Overrides Filters" Style="{StaticResource ParamLabel}"/>
                                            <Button    Grid.Column="1" x:Name="btn_vg_filters" Content="Edit&#x2026;"
                                                       Style="{StaticResource EditButton}" Margin="0,0,8,0"/>
                                            <CheckBox  Grid.Column="2" x:Name="chk_inc_vg_filters"/>
