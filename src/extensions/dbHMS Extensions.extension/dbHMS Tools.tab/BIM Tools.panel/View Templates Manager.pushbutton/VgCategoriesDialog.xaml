<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="V/G Overrides &#x2014; Categories"
        Height="700" Width="980"
        MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        Background="#F7FAFC"
        FontFamily="Segoe UI" FontSize="12"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A202C"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A5568"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style x:Key="HelperText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#718096"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- ===== dbHMS standard dropdown (canonical) =====================
             Flat, rounded, custom chevron, hover + focus states. Mirrors the
             clash web <select>. Keep ComboToggle above the ComboBox style (it
             is referenced by StaticResource) and keep the ComboBoxItem style
             with it. Copy this whole block verbatim into every tool. -->
        <Style x:Key="ComboToggle" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="White" BorderBrush="#CBD5E0"
                                BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
                            <Path x:Name="arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,10,0" Data="M0,0 L4,4 L8,0" Stroke="#718096"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#A0AEC0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2B6CB0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Style="{StaticResource ComboToggle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,26,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Focusable="True"
                                     IsReadOnly="{TemplateBinding IsReadOnly}" Margin="7,0,26,0"
                                     VerticalAlignment="Center" Background="Transparent" BorderThickness="0"/>
                            <Popup x:Name="Popup" Placement="Bottom" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="White" BorderBrush="#CBD5E0"
                                            BorderThickness="1" CornerRadius="6" Margin="0,3,0,0"/>
                                    <ScrollViewer Margin="4,7,4,4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="34"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#A0AEC0"/>
                            </Trigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter Property="IsTabStop" Value="False"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ib" Background="Transparent" CornerRadius="4"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ib" Property="Background" Value="#EBF3FB"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ib" Property="Background" Value="#EBF8FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2B6CB0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="ColorSwatch" TargetType="Border">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="BorderBrush" Value="#A0AEC0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- HEADER -->
        <Border DockPanel.Dock="Top" Background="#2D3748" Padding="20,12">
            <StackPanel>
                <TextBlock x:Name="txt_dialog_title" Text="V/G Overrides &#x2014; Model Categories"
                           Foreground="White" FontSize="16" FontWeight="Bold"/>
                <TextBlock x:Name="txt_dialog_sub" Foreground="#CBD5E0" FontSize="11"
                           Margin="0,2,0,0"
                           Text="Toggle visibility and override graphics for each category &#x2014; same as Revit's V/G dialog."/>
            </StackPanel>
        </Border>

        <!-- FOOTER -->
        <Border DockPanel.Dock="Bottom" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="txt_dialog_status"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Foreground="#4A5568" FontStyle="Italic"
                           Margin="0,0,12,0" TextTrimming="CharacterEllipsis"
                           Text=""/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btn_dlg_cancel" Content="Close" Style="{StaticResource SecondaryButton}"
                            ToolTip="Close the dialog. Each OK click ran its own Revit Transaction so anything you've already applied is saved."/>
                    <Button x:Name="btn_dlg_ok" Content="OK" Style="{StaticResource PrimaryButton}"
                            IsEnabled="False" ToolTip="Wiring coming in iteration 3"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="320"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: category list -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Categories" Style="{StaticResource SectionHeader}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="btn_cat_all"    Content="All"    Style="{StaticResource MiniButton}"/>
                            <Button x:Name="btn_cat_none"   Content="None"   Style="{StaticResource MiniButton}"/>
                            <Button x:Name="btn_cat_invert" Content="Invert" Style="{StaticResource MiniButton}"/>
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="txt_cat_search" DockPanel.Dock="Top" Margin="0,0,0,8"
                             ToolTip="Filter categories by name"/>
                    <Border DockPanel.Dock="Top" Background="#F7FAFC" BorderBrush="#E2E8F0"
                            BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Legend: " Style="{StaticResource HelperText}"
                                       VerticalAlignment="Center"/>
                            <CheckBox IsChecked="True" IsHitTestVisible="False" Focusable="False"
                                      VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="on every selected template" Style="{StaticResource HelperText}"
                                       VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <CheckBox IsChecked="False" IsHitTestVisible="False" Focusable="False"
                                      VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="on none" Style="{StaticResource HelperText}"
                                       VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <CheckBox x:Name="chk_legend_mixed" IsThreeState="True"
                                      IsHitTestVisible="False" Focusable="False"
                                      VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="mixed (some but not all)" Style="{StaticResource HelperText}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Grid DockPanel.Dock="Top" Background="#EDF2F7" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Show" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#2D3748" Padding="6,4" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Category" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#2D3748" Padding="6,4"/>
                        <TextBlock Grid.Column="2" Text="HT" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#2D3748" Padding="6,4" HorizontalAlignment="Center"
                                   ToolTip="Halftone"/>
                        <TextBlock Grid.Column="3" Text="OR" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#2D3748" Padding="6,4" HorizontalAlignment="Center"
                                   ToolTip="Has graphic override"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="pnl_categories"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- RIGHT: override editor -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="txt_selected_cat" Text="No category selected" Style="{StaticResource SectionHeader}"
                                   TextWrapping="Wrap"/>
                        <StackPanel x:Name="pnl_selected_names" Margin="0,2,0,0"/>
                        <TextBlock Style="{StaticResource HelperText}"
                                   Text="Click a category on the left to scope edits to that one. Shift- or ctrl-click to multi-select. With nothing selected, OK applies the override to ALL categories in this dialog."/>

                        <Border Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="3" Padding="10" Margin="0,10,0,12">
                            <StackPanel>
                                <CheckBox x:Name="chk_cat_visible"  Content="Visible"  IsChecked="True"/>
                                <CheckBox x:Name="chk_cat_halftone" Content="Halftone"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Transparency"
                                               Style="{StaticResource FieldLabel}" Margin="0,0,0,0"
                                               VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" x:Name="sld_transparency" Minimum="0" Maximum="100"
                                                Value="0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="txt_transparency_val" Text="0%"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Detail Level"
                                               Style="{StaticResource FieldLabel}" Margin="0,0,0,0"
                                               VerticalAlignment="Center"/>
                                    <ComboBox  Grid.Column="1" x:Name="cmb_detail_level"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Projection / Surface lines -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Projection / Surface &#x2014; Lines" Style="{StaticResource SectionHeader}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Weight"
                                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="cmb_proj_weight"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Color"
                                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <Button    Grid.Row="1" Grid.Column="1" x:Name="btn_proj_color" Height="26"
                                               HorizontalContentAlignment="Left" Padding="6,2">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="sw_proj_color" Style="{StaticResource ColorSwatch}"
                                                    Background="Black"/>
                                            <TextBlock x:Name="txt_proj_color" Text="Black" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Pattern"
                                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <ComboBox  Grid.Row="2" Grid.Column="1" x:Name="cmb_proj_pattern"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Cut lines -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Cut &#x2014; Lines" Style="{StaticResource SectionHeader}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Weight"
                                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="cmb_cut_weight"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Color"
                                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <Button    Grid.Row="1" Grid.Column="1" x:Name="btn_cut_color" Height="26"
                                               HorizontalContentAlignment="Left" Padding="6,2">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="sw_cut_color" Style="{StaticResource ColorSwatch}"
                                                    Background="Black"/>
                                            <TextBlock x:Name="txt_cut_color" Text="Black" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Pattern"
                                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                    <ComboBox  Grid.Row="2" Grid.Column="1" x:Name="cmb_cut_pattern"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Surface patterns -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Surface Patterns" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="Foreground" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" x:Name="cmb_surf_fg_pattern" Margin="0,0,8,0"/>
                                    <Button   Grid.Column="1" x:Name="btn_surf_fg_color" Height="26"
                                              HorizontalContentAlignment="Left" Padding="6,2">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource ColorSwatch}" Background="#888"/>
                                            <TextBlock Text="Color" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="Background" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" x:Name="cmb_surf_bg_pattern" Margin="0,0,8,0"/>
                                    <Button   Grid.Column="1" x:Name="btn_surf_bg_color" Height="26"
                                              HorizontalContentAlignment="Left" Padding="6,2">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource ColorSwatch}" Background="#888"/>
                                            <TextBlock Text="Color" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Cut patterns -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Cut Patterns" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="Foreground" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" x:Name="cmb_cut_fg_pattern" Margin="0,0,8,0"/>
                                    <Button   Grid.Column="1" x:Name="btn_cut_fg_color" Height="26"
                                              HorizontalContentAlignment="Left" Padding="6,2">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource ColorSwatch}" Background="#888"/>
                                            <TextBlock Text="Color" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="Background" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" x:Name="cmb_cut_bg_pattern" Margin="0,0,8,0"/>
                                    <Button   Grid.Column="1" x:Name="btn_cut_bg_color" Height="26"
                                              HorizontalContentAlignment="Left" Padding="6,2">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource ColorSwatch}" Background="#888"/>
                                            <TextBlock Text="Color" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="3" Padding="8" Margin="0,4,0,0">
                            <StackPanel>
                                <Button x:Name="btn_cat_reset" Content="Reset Overrides"
                                        Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                        Margin="0,0,0,0" MinWidth="160"/>
                                <TextBlock Style="{StaticResource HelperText}" Margin="0,6,0,0"
                                           Text="Clears all graphic overrides on this category but keeps visibility."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
