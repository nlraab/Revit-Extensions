<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Run Clash Test"
        Height="780" Width="1180"
        MinHeight="640" MinWidth="1124"
        WindowStartupLocation="CenterScreen"
        Background="#F7FAFC"
        FontFamily="Segoe UI" FontSize="12"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A202C"/><Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A5568"/><Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style x:Key="HelperText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#718096"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="MonoText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#2D3748"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/><Setter Property="Height" Value="26"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,3"/><Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2B6CB0"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="120"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/><Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="Padding" Value="12,6"/><Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/><Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="Padding" Value="8,2"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,0,3"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="EllipsisCellStyle" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2D3748" Padding="20,14">
            <Grid>
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="Run Clash Test" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Pick saved tests, choose which linked models to include, and execute against the active project."
                               Foreground="#CBD5E0" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.85">
                    <TextBlock Text="db" Foreground="#00BFFF" FontSize="32" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=" | " Foreground="#7A8FA6" FontSize="32" FontWeight="Light" VerticalAlignment="Center"/>
                    <TextBlock Text="HMS" Foreground="#00BFFF" FontSize="32" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel LastChildFill="False">
                <ProgressBar x:Name="pb_run" Height="6" Width="180" Visibility="Collapsed"
                             VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,12,0"
                             IsIndeterminate="True"/>
                <TextBlock x:Name="txt_status" Text="Ready - check the tests you want to run."
                           Foreground="#4A5568" VerticalAlignment="Center" FontStyle="Italic" DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button x:Name="btn_close" Content="Close" Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="btn_run" Content="Run Selected" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="20,16,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="540"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="500" MinWidth="500"/>
            </Grid.ColumnDefinitions>

            <!-- COL 1: Tests checklist -->
            <Border Style="{StaticResource CardBorder}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                        <TextBlock x:Name="txt_tests_header" Text="Saved Clash Tests (14)"
                                   Style="{StaticResource SectionHeader}"
                                   DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button x:Name="btn_select_all" Content="Select All" Style="{StaticResource MiniButton}"/>
                            <Button x:Name="btn_select_none" Content="None" Style="{StaticResource MiniButton}"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="Pick the tests to run. Defaults come from the global Test Library; manage them via the Test Library button."
                               Style="{StaticResource HelperText}" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                    <DataGrid x:Name="dg_tests"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserResizeRows="False"
                              CanUserSortColumns="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF2F7"
                              RowHeight="30" AlternatingRowBackground="#F7FAFC"
                              SelectionMode="Extended" SelectionUnit="FullRow" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <!-- DataGridTemplateColumn (vs DataGridCheckBoxColumn) so the checkbox -->
                            <!-- toggles on a SINGLE click instead of the default two-click behavior -->
                            <!-- (first click selects the cell, second click toggles). -->
                            <DataGridTemplateColumn Header="Run" Width="48" MinWidth="48" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Test Name" Binding="{Binding Name}"
                                                Width="*" MinWidth="180" IsReadOnly="True"
                                                ElementStyle="{StaticResource EllipsisCellStyle}"/>
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="60" MinWidth="60" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Trade" Binding="{Binding Assignee}" Width="120" MinWidth="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Last Run" Binding="{Binding LastRun}" Width="100" MinWidth="100" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- COL 3: Run options + result -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Active Project" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="Sample-Central.rvt" Foreground="#2D3748" FontWeight="SemiBold"/>
                            <TextBlock Text="T:\Projects\Sample\Sample-Central.rvt" Style="{StaticResource MonoText}" Margin="0,2,0,0"/>
                            <Border Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                    CornerRadius="3" Padding="8" Margin="0,8,0,0">
                                <StackPanel>
                                    <!-- Single TextBlock with Runs so the Segoe UI label and
                                         Consolas value share a baseline (mixed fonts in a
                                         StackPanel align by top, which looks misaligned). -->
                                    <TextBlock Style="{StaticResource HelperText}">
                                        <Run Text="Project hash: "/><Run Text="9c1f3a8b2e0d" FontFamily="Consolas" Foreground="#2D3748"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource HelperText}">
                                        <Run Text="Storage: "/><Run Text="T:\_clash_data\9c1f3a8b2e0d\" FontFamily="Consolas" Foreground="#2D3748"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Linked Models" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="Linked .rvt files in this project. Uncheck any to exclude from this run. The role badge (Architectural / Structural) comes from the per-project role mapping configured in Settings - filenames vary by project."
                                       Style="{StaticResource HelperText}" Margin="0,0,0,8"/>

                            <!-- Rows are built at runtime from clash_detect.linked.merged_link_view() -->
                            <StackPanel x:Name="sp_run_link_rows"/>

                            <Button x:Name="btn_open_settings" Content="Manage role mapping in Settings  →"
                                    Style="{StaticResource MiniButton}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Trade Filter" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="Limit this run to clashes whose primary element belongs to a checked trade. Useful for quick &quot;just check what I changed&quot; runs."
                                       Style="{StaticResource HelperText}"/>
                            <WrapPanel x:Name="wp_trade_filter" Margin="0,4,0,0">
                                <CheckBox x:Name="chk_trade_mech"  Content="Mechanical"      IsChecked="True" Margin="0,3,12,3"/>
                                <CheckBox x:Name="chk_trade_elec"  Content="Electrical"      IsChecked="True" Margin="0,3,12,3"/>
                                <CheckBox x:Name="chk_trade_plumb" Content="Plumbing"        IsChecked="True" Margin="0,3,12,3"/>
                                <CheckBox x:Name="chk_trade_fp"    Content="Fire Protection" IsChecked="True" Margin="0,3,12,3"/>
                                <CheckBox x:Name="chk_trade_tech"  Content="Technology"      IsChecked="True" Margin="0,3,12,3"/>
                            </WrapPanel>
                            <TextBlock Text="All trades checked = no filter. Uncheck to skip clashes that don't involve those trades."
                                       Style="{StaticResource HelperText}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Run Options" Style="{StaticResource SectionHeader}"/>
                            <CheckBox x:Name="chk_compare" Content="Compare to previous run (mark new / persisting / resolved)" IsChecked="True"/>
                            <CheckBox x:Name="chk_preserve" Content="Preserve comments and history on persisting clashes" IsChecked="True"/>
                            <TextBlock Text="Warn before loading more than" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="txt_warn_threshold" Text="2000" Width="100"/>
                                <TextBlock Text="  clashes" VerticalAlignment="Center" Foreground="#4A5568"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="brd_result" Style="{StaticResource CardBorder}" Visibility="Collapsed"
                            Background="#F0FFF4" BorderBrush="#9AE6B4">
                        <StackPanel>
                            <TextBlock Text="Run Complete" Style="{StaticResource SectionHeader}" Foreground="#22543D"/>
                            <TextBlock x:Name="txt_result_summary" Text="" Foreground="#22543D" TextWrapping="Wrap"/>
                            <Button x:Name="btn_open_browser" Content="Open Clash Browser"
                                    Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0" MinWidth="0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
