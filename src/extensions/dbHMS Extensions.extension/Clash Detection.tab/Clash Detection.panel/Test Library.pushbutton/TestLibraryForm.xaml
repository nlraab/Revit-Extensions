<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Test Library"
        Height="860" Width="1300"
        MinHeight="740" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        Background="#F7FAFC"
        FontFamily="Segoe UI" FontSize="12"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A202C"/><Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A5568"/><Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style x:Key="HelperText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#718096"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/><Setter Property="Height" Value="26"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,3"/><Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2B6CB0"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="120"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/><Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="Padding" Value="12,6"/><Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/><Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="Padding" Value="8,2"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,0,3"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="EllipsisCellStyle" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2D3748" Padding="20,14">
            <Grid>
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="Test Library" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Edit firm-wide clash test definitions and the active project's overrides."
                               Foreground="#CBD5E0" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.85">
                    <TextBlock Text="db" Foreground="#00BFFF" FontSize="32" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=" | " Foreground="#7A8FA6" FontSize="32" FontWeight="Light" VerticalAlignment="Center"/>
                    <TextBlock Text="HMS" Foreground="#00BFFF" FontSize="32" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="btn_new_test" Content="+ New Test" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" MinWidth="100"/>
                    <Button x:Name="btn_delete_test" Content="Delete" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" MinWidth="100"/>
                    <Button x:Name="btn_reset_default" Content="Reset to firm default" Style="{StaticResource SecondaryButton}" MinWidth="0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button x:Name="btn_close" Content="Cancel" Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="btn_save" Content="Save Changes" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="280"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="380" MinHeight="380"/>
            </Grid.RowDefinitions>

            <!-- TOP: 2-pane libraries -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="500"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*" MinWidth="500"/>
                </Grid.ColumnDefinitions>

                <!-- Global Library -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                            <TextBlock Text="Global Library  (firm-wide defaults)"
                                       Style="{StaticResource SectionHeader}" DockPanel.Dock="Left"/>
                            <Border Background="#EBF8FF" BorderBrush="#90CDF4" BorderThickness="1"
                                    CornerRadius="3" Padding="6,2" DockPanel.Dock="Right">
                                <TextBlock x:Name="txt_global_count" Text="14 tests" FontSize="11"
                                           FontWeight="SemiBold" Foreground="#2A4365"/>
                            </Border>
                        </DockPanel>
                        <TextBlock Text="Shipped defaults editable to firm-wide standards. Used by every project unless overridden below."
                                   Style="{StaticResource HelperText}" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                        <DataGrid x:Name="dg_global"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" RowHeight="28"
                                  AlternatingRowBackground="#F7FAFC"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF2F7"
                                  SelectionMode="Single" BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Test Name" Binding="{Binding Name}"
                                                    Width="*" MinWidth="180" IsReadOnly="True"
                                                    ElementStyle="{StaticResource EllipsisCellStyle}"/>
                                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}"
                                                    Width="60" MinWidth="60" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Trade" Binding="{Binding Assignee}"
                                                    Width="120" MinWidth="120" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Project Overrides -->
                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                            <TextBlock Text="Project Overrides" Style="{StaticResource SectionHeader}" DockPanel.Dock="Left"/>
                            <Border Background="#FAF5FF" BorderBrush="#D6BCFA" BorderThickness="1"
                                    CornerRadius="3" Padding="6,2" DockPanel.Dock="Right">
                                <TextBlock x:Name="txt_override_count" Text="2 overrides" FontSize="11"
                                           FontWeight="SemiBold" Foreground="#553C9A"/>
                            </Border>
                        </DockPanel>
                        <TextBlock Text="Per-project additions, customizations, and disabled defaults. Apply only to the active project."
                                   Style="{StaticResource HelperText}" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                        <DataGrid x:Name="dg_overrides"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" RowHeight="28"
                                  AlternatingRowBackground="#F7FAFC"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF2F7"
                                  SelectionMode="Single" BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Test Name" Binding="{Binding Name}"
                                                    Width="*" MinWidth="180" IsReadOnly="True"
                                                    ElementStyle="{StaticResource EllipsisCellStyle}"/>
                                <DataGridTextColumn Header="Override" Binding="{Binding OverrideKind}"
                                                    Width="100" MinWidth="100" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Trade" Binding="{Binding Assignee}"
                                                    Width="120" MinWidth="120" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- BOTTOM: Editor -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock x:Name="txt_editor_header" Text="Editing: Mechanical Ducts vs Plumbing Pipes"
                                       Style="{StaticResource SectionHeader}" DockPanel.Dock="Left"/>
                            <Border x:Name="brd_source_badge" Background="#EBF8FF" BorderBrush="#90CDF4"
                                    BorderThickness="1" CornerRadius="3" Padding="6,2" DockPanel.Dock="Right">
                                <TextBlock x:Name="txt_source_badge" Text="Global default" FontSize="10"
                                           FontWeight="SemiBold" Foreground="#2A4365"/>
                            </Border>
                        </DockPanel>
                        <TextBlock Text="Pick a test on the left to edit it. Changes apply to whichever store it came from (Global / Override). Use New Project Override below to fork a global default into a per-project override."
                                   Style="{StaticResource HelperText}" Margin="0,0,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="240"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="160" MinWidth="160"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="180" MinWidth="180"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Test Name" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txt_test_name" Text="Mechanical Ducts vs Plumbing Pipes"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Kind" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmb_kind">
                                    <ComboBoxItem Content="Hard" IsSelected="True"/>
                                    <ComboBoxItem Content="Soft"/>
                                    <ComboBoxItem Content="Clearance (planned)" IsEnabled="False"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Tolerance (in)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txt_tolerance" Text="0.0" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#F7FAFC" BorderBrush="#E2E8F0"
                                    BorderThickness="1" CornerRadius="3" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Set A  (these elements clash against Set B)"
                                               Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Source" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cmb_source_a">
                                        <ComboBoxItem Content="Host (active project)" IsSelected="True"/>
                                        <ComboBoxItem Content="Linked Architectural"/>
                                        <ComboBoxItem Content="Linked Structural"/>
                                    </ComboBox>
                                    <TextBlock Text="Categories" Style="{StaticResource FieldLabel}"/>
                                    <Border Background="White" BorderBrush="#CBD5E0" BorderThickness="1"
                                            CornerRadius="3" Padding="6" Height="160">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <!-- Populated at runtime from clash_core.categories -->
                                            <StackPanel x:Name="sp_categories_a"/>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#F7FAFC" BorderBrush="#E2E8F0"
                                    BorderThickness="1" CornerRadius="3" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Set B" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Source" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cmb_source_b">
                                        <ComboBoxItem Content="Host (active project)" IsSelected="True"/>
                                        <ComboBoxItem Content="Linked Architectural"/>
                                        <ComboBoxItem Content="Linked Structural"/>
                                    </ComboBox>
                                    <TextBlock Text="Categories" Style="{StaticResource FieldLabel}"/>
                                    <Border Background="White" BorderBrush="#CBD5E0" BorderThickness="1"
                                            CornerRadius="3" Padding="6" Height="160">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <!-- Populated at runtime from clash_core.categories -->
                                            <StackPanel x:Name="sp_categories_b"/>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="220"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="220" MinWidth="220"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Default Assignee Trade" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmb_assignee">
                                    <ComboBoxItem Content="Mechanical" IsSelected="True"/>
                                    <ComboBoxItem Content="Electrical"/>
                                    <ComboBoxItem Content="Plumbing"/>
                                    <ComboBoxItem Content="Fire Protection"/>
                                    <ComboBoxItem Content="Technology"/>
                                    <ComboBoxItem Content="Architectural"/>
                                    <ComboBoxItem Content="Structural"/>
                                </ComboBox>
                            </StackPanel>
                            <Button x:Name="btn_add_override" Grid.Column="2"
                                    Content="+ Add Project Override"
                                    Style="{StaticResource SecondaryButton}"
                                    VerticalAlignment="Bottom" MinWidth="0"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
