<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clash Browser"
        Height="820" Width="1740"
        MinHeight="620" MinWidth="1580"
        WindowStartupLocation="CenterScreen"
        Background="#F7FAFC"
        FontFamily="Segoe UI" FontSize="12"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A202C"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A5568"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style x:Key="HelperText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#718096"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="MonoText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#2D3748"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="26"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2B6CB0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Cell text for the long-text DataGrid columns. Ellipsizes when the -->
        <!-- column is narrower than the text and shows a tooltip with the full -->
        <!-- value on hover, so nothing is silently hidden. -->
        <Style x:Key="EllipsisCellStyle" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- HEADER: dbHMS branding bar -->
        <Border DockPanel.Dock="Top" Background="#2D3748" Padding="20,14">
            <Grid>
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="Clash Browser" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Browse, filter, comment on, assign, and resolve every clash in the current project."
                               Foreground="#CBD5E0" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Opacity="0.85">
                    <TextBlock Text="db" Foreground="#00BFFF" FontSize="32"
                               FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <TextBlock Text=" | " Foreground="#7A8FA6" FontSize="32"
                               FontWeight="Light" VerticalAlignment="Center"/>
                    <TextBlock Text="HMS" Foreground="#00BFFF" FontSize="32"
                               FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FOOTER -->
        <Border DockPanel.Dock="Bottom" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock x:Name="txt_status" Text="" Foreground="#4A5568"
                               VerticalAlignment="Center" FontStyle="Italic"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btn_refresh" Content="Refresh" Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="btn_close" Content="Close" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN: 3-column grid -->
        <Grid Margin="20,16,20,16">
            <Grid.ColumnDefinitions>
                <!-- Side columns are rigid. Middle squishes via the DataGrid's long -->
                <!-- text columns ellipsizing (Test / Element A / Element B). All -->
                <!-- columns stay fully visible at every window size; only their text -->
                <!-- gets truncated with "..." (and tooltips reveal the full text). -->
                <ColumnDefinition Width="320" MinWidth="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="770"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="380" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- ============ COLUMN 1: FILTERS ============ -->
            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Filters" Style="{StaticResource SectionHeader}"
                                       DockPanel.Dock="Left" VerticalAlignment="Center"/>
                            <Button x:Name="btn_reset_filters" Content="Reset"
                                    Style="{StaticResource MiniButton}"
                                    DockPanel.Dock="Right"/>
                        </DockPanel>

                        <TextBlock Text="Trade" Style="{StaticResource FieldLabel}"/>
                        <WrapPanel x:Name="wp_trade_filter">
                            <CheckBox Content="Mechanical" IsChecked="True" Margin="0,3,8,3"/>
                            <CheckBox Content="Electrical" IsChecked="True" Margin="0,3,8,3"/>
                            <CheckBox Content="Plumbing" IsChecked="True" Margin="0,3,8,3"/>
                            <CheckBox Content="Fire Protection" IsChecked="True" Margin="0,3,8,3"/>
                            <CheckBox Content="Technology" IsChecked="True" Margin="0,3,8,3"/>
                            <CheckBox Content="Architectural" IsChecked="True" Margin="0,3,8,3"/>
                            <CheckBox Content="Structural" IsChecked="True" Margin="0,3,8,3"/>
                        </WrapPanel>

                        <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                        <WrapPanel>
                            <CheckBox Content="Open" IsChecked="True" Margin="0,3,8,3"/>
                            <CheckBox Content="Reviewed" IsChecked="True" Margin="0,3,8,3"/>
                            <CheckBox Content="Approved" IsChecked="False" Margin="0,3,8,3"/>
                            <CheckBox Content="Resolved" IsChecked="False" Margin="0,3,8,3"/>
                        </WrapPanel>

                        <TextBlock Text="Test" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmb_test_filter">
                            <ComboBoxItem Content="(All tests)" IsSelected="True"/>
                            <ComboBoxItem Content="Mechanical Ducts vs Plumbing Pipes"/>
                            <ComboBoxItem Content="Mechanical Ducts vs Electrical Conduit"/>
                            <ComboBoxItem Content="Plumbing Pipes vs Structural Framing"/>
                            <ComboBoxItem Content="Mechanical Equipment vs Architectural Walls"/>
                        </ComboBox>

                        <TextBlock Text="Level" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmb_level_filter">
                            <ComboBoxItem Content="(All levels)" IsSelected="True"/>
                            <ComboBoxItem Content="Level 1"/>
                            <ComboBoxItem Content="Level 2"/>
                            <ComboBoxItem Content="Level 3"/>
                            <ComboBoxItem Content="Roof"/>
                        </ComboBox>

                        <TextBlock Text="Search" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txt_search"/>
                        <TextBlock Text="Search element names, IDs, or comment text"
                                   Foreground="#A0AEC0" FontSize="10" Margin="0,2,0,0"/>

                        <Border Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="3" Padding="8" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Filter Presets" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <Button Content="My open clashes" Style="{StaticResource MiniButton}"
                                        HorizontalContentAlignment="Left" Margin="0,2"/>
                                <Button Content="Mechanical only" Style="{StaticResource MiniButton}"
                                        HorizontalContentAlignment="Left" Margin="0,2"/>
                                <Button Content="Resolved this week" Style="{StaticResource MiniButton}"
                                        HorizontalContentAlignment="Left" Margin="0,2"/>
                                <Button x:Name="btn_save_preset" Content="+ Save current as preset"
                                        Style="{StaticResource MiniButton}"
                                        HorizontalContentAlignment="Left" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </DockPanel>

            <!-- ============ COLUMN 2: CLASH LIST ============ -->
            <DockPanel Grid.Column="2">
                <Border Style="{StaticResource CardBorder}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                            <TextBlock x:Name="txt_grid_header" Text="Clashes (12 of 87)"
                                       Style="{StaticResource SectionHeader}"
                                       DockPanel.Dock="Left" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cmb_group_by" Width="160" DockPanel.Dock="Right"
                                      Margin="0,0,0,0">
                                <ComboBoxItem Content="No grouping" IsSelected="True"/>
                                <ComboBoxItem Content="Group by trade"/>
                                <ComboBoxItem Content="Group by test"/>
                                <ComboBoxItem Content="Group by level"/>
                                <ComboBoxItem Content="Group by status"/>
                            </ComboBox>
                            <TextBlock Text="Group:" DockPanel.Dock="Right" VerticalAlignment="Center"
                                       Margin="0,0,6,0" Foreground="#4A5568"/>
                        </DockPanel>

                        <!-- Bulk actions appear when more than one row is selected -->
                        <Border x:Name="brd_bulk_actions" DockPanel.Dock="Top"
                                Background="#FFFBEA" BorderBrush="#D69E2E" BorderThickness="1"
                                CornerRadius="3" Padding="8,4" Margin="0,8,0,0"
                                Visibility="Collapsed">
                            <DockPanel LastChildFill="False">
                                <TextBlock x:Name="txt_bulk_count" Text="0 selected:"
                                           Foreground="#744210" FontWeight="SemiBold"
                                           VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button x:Name="btn_bulk_status" Content="Change Status"
                                            Style="{StaticResource MiniButton}"/>
                                    <Button x:Name="btn_bulk_reassign" Content="Reassign"
                                            Style="{StaticResource MiniButton}"/>
                                    <Button x:Name="btn_bulk_group" Content="Group"
                                            Style="{StaticResource MiniButton}"/>
                                    <Button x:Name="btn_bulk_resolve" Content="Mark Resolved"
                                            Style="{StaticResource MiniButton}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <DataGrid x:Name="dg_clashes"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="True"
                                  CanUserResizeColumns="True"
                                  CanUserResizeRows="False"
                                  CanUserSortColumns="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EDF2F7"
                                  RowHeight="32"
                                  SelectionMode="Extended"
                                  Margin="0,8,0,0"
                                  BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  EnableRowVirtualization="False"
                                  EnableColumnVirtualization="False"
                                  VirtualizingPanel.IsVirtualizing="False"
                                  ScrollViewer.CanContentScroll="False">
                            <!-- Grouping support. -->
                            <!-- - GroupStyle.Panel forces a non-virtualizing StackPanel for the -->
                            <!--   group containers; without this the DataGrid still wraps them -->
                            <!--   in a VirtualizingStackPanel even when row virtualization is -->
                            <!--   off, which crashes WPF when GroupDescriptions change at runtime. -->
                            <!-- - The header template uses a single TextBlock with a one-way -->
                            <!--   binding to Name; ItemCount and similar non-string properties -->
                            <!--   are deliberately not bound here because Run.Text bindings to -->
                            <!--   non-string sources have proven flaky under IronPython. -->
                            <DataGrid.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.Panel>
                                        <ItemsPanelTemplate>
                                            <StackPanel/>
                                        </ItemsPanelTemplate>
                                    </GroupStyle.Panel>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border Background="#EDF2F7" BorderBrush="#CBD5E0"
                                                    BorderThickness="0,0,0,1" Padding="10,6">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1A202C"/>
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </DataGrid.GroupStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Id}"
                                                    Width="50" MinWidth="50" IsReadOnly="True"
                                                    ElementStyle="{StaticResource EllipsisCellStyle}"/>
                                <DataGridTextColumn Header="Test" Binding="{Binding TestName}"
                                                    Width="*" MinWidth="90" IsReadOnly="True"
                                                    ElementStyle="{StaticResource EllipsisCellStyle}"/>
                                <DataGridTextColumn Header="Element A" Binding="{Binding ElementA}"
                                                    Width="2*" MinWidth="120" IsReadOnly="True"
                                                    ElementStyle="{StaticResource EllipsisCellStyle}"/>
                                <DataGridTextColumn Header="Element B" Binding="{Binding ElementB}"
                                                    Width="2*" MinWidth="120" IsReadOnly="True"
                                                    ElementStyle="{StaticResource EllipsisCellStyle}"/>
                                <DataGridTextColumn Header="Level" Binding="{Binding Level}"
                                                    Width="70" MinWidth="70" IsReadOnly="True"
                                                    ElementStyle="{StaticResource EllipsisCellStyle}"/>
                                <DataGridTemplateColumn Header="Status" Width="90" MinWidth="90" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding StatusBrush}"
                                                    CornerRadius="3" Padding="6,2" Margin="2"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" Foreground="White"
                                                           FontSize="10" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Trade" Width="130" MinWidth="130" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding TradeBgBrush}"
                                                    CornerRadius="3" Padding="6,2" Margin="2"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Trade}"
                                                           Foreground="{Binding TradeFgBrush}"
                                                           FontSize="10" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Notes" Binding="{Binding CommentCountStr}"
                                                    Width="50" MinWidth="50" IsReadOnly="True"
                                                    ElementStyle="{StaticResource EllipsisCellStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </DockPanel>

            <!-- ============ COLUMN 3: DETAIL PANEL ============ -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="sp_detail_panel">

                    <!-- Header / element info card -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock x:Name="txt_clash_title" Text="Clash #1024"
                                           Style="{StaticResource SectionHeader}"
                                           DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                <Border x:Name="brd_clash_kind" Background="#FFF5F5" Padding="6,2"
                                        CornerRadius="3" DockPanel.Dock="Right">
                                    <TextBlock x:Name="txt_clash_kind" Text="HARD"
                                               Foreground="#742A2A" FontWeight="Bold" FontSize="10"/>
                                </Border>
                            </DockPanel>
                            <TextBlock x:Name="txt_clash_test" Text="Mech Ducts vs Plumbing"
                                       Style="{StaticResource HelperText}" Margin="0,0,0,10"/>

                            <Border Background="#F7FAFC" BorderBrush="#CBD5E0" BorderThickness="1"
                                    CornerRadius="3" Height="180">
                                <Grid>
                                    <TextBlock Text="[ Viewpoint thumbnail ]" Foreground="#A0AEC0"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontStyle="Italic"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="Element A" Style="{StaticResource FieldLabel}"/>
                            <Border Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                    CornerRadius="3" Padding="8">
                                <StackPanel>
                                    <TextBlock x:Name="txt_elem_a_name" Text="Round Duct - 12&quot; - Supply"/>
                                    <TextBlock x:Name="txt_elem_a_id" Text="ID 4582193 - host model"
                                               Style="{StaticResource MonoText}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Element B" Style="{StaticResource FieldLabel}"/>
                            <Border Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                    CornerRadius="3" Padding="8">
                                <StackPanel>
                                    <TextBlock x:Name="txt_elem_b_name" Text="PVC Pipe - 4&quot; - Sanitary"/>
                                    <TextBlock x:Name="txt_elem_b_id" Text="ID 7831205 - host model"
                                               Style="{StaticResource MonoText}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmb_detail_status">
                                <ComboBoxItem Content="Open" IsSelected="True"/>
                                <ComboBoxItem Content="Reviewed"/>
                                <ComboBoxItem Content="Approved"/>
                                <ComboBoxItem Content="Resolved"/>
                            </ComboBox>

                            <TextBlock Text="Assigned trade" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmb_detail_trade">
                                <ComboBoxItem Content="Mechanical" IsSelected="True"/>
                                <ComboBoxItem Content="Electrical"/>
                                <ComboBoxItem Content="Plumbing"/>
                                <ComboBoxItem Content="Fire Protection"/>
                                <ComboBoxItem Content="Technology"/>
                                <ComboBoxItem Content="Architectural"/>
                                <ComboBoxItem Content="Structural"/>
                            </ComboBox>

                            <UniformGrid Columns="2" Margin="0,12,0,0">
                                <Button x:Name="btn_show_3d" Content="Show in 3D"
                                        Style="{StaticResource SecondaryButton}"
                                        MinWidth="0" Margin="0,0,3,0"/>
                                <Button x:Name="btn_save_viewpoint" Content="Save Viewpoint"
                                        Style="{StaticResource SecondaryButton}"
                                        MinWidth="0" Margin="3,0,0,0"/>
                            </UniformGrid>
                            <UniformGrid Columns="2" Margin="0,6,0,0">
                                <Button x:Name="btn_walkthrough_here" Content="Walkthrough Here"
                                        Style="{StaticResource SecondaryButton}"
                                        MinWidth="0" Margin="0,0,3,0"/>
                                <Button x:Name="btn_history" Content="History"
                                        Style="{StaticResource SecondaryButton}"
                                        MinWidth="0" Margin="3,0,0,0"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Comments card -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock x:Name="txt_comments_header" Text="Comments (3)"
                                       Style="{StaticResource SectionHeader}"/>

                            <ItemsControl x:Name="ic_comments">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F7FAFC" BorderBrush="#E2E8F0"
                                                BorderThickness="1" CornerRadius="3"
                                                Padding="8" Margin="0,0,0,6">
                                            <StackPanel>
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock Text="{Binding Author}" FontWeight="SemiBold"
                                                               Foreground="#2D3748" DockPanel.Dock="Left"/>
                                                    <TextBlock Text="{Binding When}" Foreground="#A0AEC0"
                                                               FontSize="10" DockPanel.Dock="Right"
                                                               VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Body}" Foreground="#4A5568"
                                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Add comment" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txt_new_comment" Height="60" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                            <Button x:Name="btn_post_comment" Content="Post Comment"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Right" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </DockPanel>
</Window>
