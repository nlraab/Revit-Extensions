<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clash History"
        Height="540" Width="640"
        MinHeight="380" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        Background="#F7FAFC"
        FontFamily="Segoe UI" FontSize="12"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A202C"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="HelperText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#718096"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="MonoText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#2D3748"/>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2B6CB0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- HEADER: dbHMS branding bar (sub-dialog variant — no wordmark, smaller title) -->
        <Border DockPanel.Dock="Top" Background="#2D3748" Padding="20,14">
            <StackPanel>
                <TextBlock x:Name="txt_dialog_title" Text="Clash History"
                           Foreground="White" FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="txt_dialog_subtitle" Text="Audit trail for the selected clash."
                           Foreground="#CBD5E0" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- FOOTER -->
        <Border DockPanel.Dock="Bottom" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="txt_history_count" Text=""
                           Foreground="#4A5568" VerticalAlignment="Center"
                           FontStyle="Italic" DockPanel.Dock="Left"/>
                <Button x:Name="btn_close" Content="Close"
                        Style="{StaticResource PrimaryButton}"
                        DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>

        <!-- BODY: scrollable list of history entries -->
        <Border Margin="20,16,20,16" Style="{StaticResource CardBorder}">
            <DockPanel>
                <!-- Empty state, hidden when history is non-empty -->
                <TextBlock x:Name="txt_empty_state"
                           Text="No history yet. Status changes, comments, viewpoint saves, and other actions on this clash will appear here."
                           Style="{StaticResource HelperText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Margin="40,40"
                           Visibility="Collapsed"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ic_history">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- One row per history entry: timestamp + author on the
                                     left, action label on the right. Bordered card with a
                                     subtle hover-lift via background tint. -->
                                <Border Background="#F7FAFC"
                                        BorderBrush="#E2E8F0" BorderThickness="1"
                                        CornerRadius="3" Padding="10,8"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding When}"
                                                       Style="{StaticResource MonoText}"/>
                                            <TextBlock Text="{Binding Author}"
                                                       Foreground="#718096" FontSize="11"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Action}"
                                                   Foreground="#2D3748" FontSize="12"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
