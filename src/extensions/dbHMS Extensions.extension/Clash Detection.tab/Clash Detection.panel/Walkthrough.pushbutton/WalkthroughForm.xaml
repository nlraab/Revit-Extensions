<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Walkthrough"
        Height="700" Width="600"
        MinHeight="620" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Background="#F7FAFC"
        FontFamily="Segoe UI" FontSize="12"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A202C"/><Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A5568"/><Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style x:Key="HelperText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#718096"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="MonoText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#2D3748"/>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2B6CB0"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="120"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/><Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="Padding" Value="12,6"/><Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,0,3"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- RadioButton: properly-sized centered bullet (matches the existing dbHMS Tools convention). -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#1A202C"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse x:Name="outer" Width="14" Height="14"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Stroke="#A0AEC0" StrokeThickness="1.5" Fill="White"/>
                                <Ellipse x:Name="dot" Width="7" Height="7"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Fill="#2B6CB0" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="outer" Property="Stroke" Value="#2B6CB0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="outer" Property="Stroke" Value="#2B6CB0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2D3748" Padding="20,14">
            <Grid>
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="Walkthrough" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Full-screen, clash-aware navigation of the active 3D view."
                               Foreground="#CBD5E0" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.85">
                    <TextBlock Text="db" Foreground="#00BFFF" FontSize="32" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=" | " Foreground="#7A8FA6" FontSize="32" FontWeight="Light" VerticalAlignment="Center"/>
                    <TextBlock Text="HMS" Foreground="#00BFFF" FontSize="32" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <TextBlock x:Name="txt_status" Text="Press Esc inside the walkthrough to exit at any time."
                           Foreground="#4A5568" VerticalAlignment="Center" FontStyle="Italic"
                           HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btn_close" Content="Cancel" Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="btn_enter" Content="Enter Walkthrough" Style="{StaticResource PrimaryButton}" MinWidth="160"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16,20,16">

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Mode" Style="{StaticResource SectionHeader}"/>
                        <RadioButton x:Name="rb_navigator" GroupName="mode" IsChecked="True">
                            <StackPanel>
                                <TextBlock Text="Clash Navigator" FontWeight="SemiBold" Foreground="#2D3748"/>
                                <TextBlock Text="Step through every open clash one at a time. Each step zooms the 3D view, applies a section box, and isolates both elements. Best for working through a clash list with someone."
                                           Style="{StaticResource HelperText}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="rb_freefly" GroupName="mode">
                            <StackPanel>
                                <TextBlock Text="Free-Fly" FontWeight="SemiBold" Foreground="#2D3748"/>
                                <TextBlock Text="Walk or fly through the building with WASD + mouse-look or an Xbox controller. Clashes appear as colored spheres at each midpoint (red = open, yellow = reviewed, green = resolved)."
                                           Style="{StaticResource HelperText}"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Show clashes for these trades" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="In Free-Fly mode, only clash markers from these trades render. In Clash Navigator mode, the step-through is filtered to these trades."
                                   Style="{StaticResource HelperText}"/>
                        <WrapPanel Margin="0,4,0,0">
                            <CheckBox Content="Mechanical" IsChecked="True" Margin="0,3,12,3"/>
                            <CheckBox Content="Electrical" IsChecked="True" Margin="0,3,12,3"/>
                            <CheckBox Content="Plumbing" IsChecked="True" Margin="0,3,12,3"/>
                            <CheckBox Content="Fire Protection" IsChecked="True" Margin="0,3,12,3"/>
                            <CheckBox Content="Technology" IsChecked="False" Margin="0,3,12,3"/>
                            <CheckBox Content="Architectural" IsChecked="False" Margin="0,3,12,3"/>
                            <CheckBox Content="Structural" IsChecked="False" Margin="0,3,12,3"/>
                        </WrapPanel>
                        <TextBlock Text="And these statuses:" Style="{StaticResource FieldLabel}"/>
                        <WrapPanel>
                            <CheckBox Content="Open" IsChecked="True" Margin="0,3,12,3"/>
                            <CheckBox Content="Reviewed" IsChecked="True" Margin="0,3,12,3"/>
                            <CheckBox Content="Approved" IsChecked="False" Margin="0,3,12,3"/>
                            <CheckBox Content="Resolved" IsChecked="False" Margin="0,3,12,3"/>
                        </WrapPanel>
                        <TextBlock x:Name="txt_marker_count" Text="32 clash markers will be visible."
                                   Style="{StaticResource HelperText}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Controls" Style="{StaticResource SectionHeader}"/>

                        <TextBlock Text="Keyboard + mouse" Style="{StaticResource FieldLabel}"/>
                        <Border Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="8">
                            <StackPanel>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="W A S D" Style="{StaticResource MonoText}"/><TextBlock Grid.Column="1" Text="Walk forward / strafe / back" Style="{StaticResource HelperText}"/>
                                </Grid>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Q  /  E" Style="{StaticResource MonoText}"/><TextBlock Grid.Column="1" Text="Move down / up" Style="{StaticResource HelperText}"/>
                                </Grid>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Mouse drag" Style="{StaticResource MonoText}"/><TextBlock Grid.Column="1" Text="Look around (yaw + pitch)" Style="{StaticResource HelperText}"/>
                                </Grid>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Shift  /  Ctrl" Style="{StaticResource MonoText}"/><TextBlock Grid.Column="1" Text="Speed up / slow down movement" Style="{StaticResource HelperText}"/>
                                </Grid>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="N  /  P" Style="{StaticResource MonoText}"/><TextBlock Grid.Column="1" Text="Next / previous clash (Navigator), jump to next marker (Free-Fly)" Style="{StaticResource HelperText}"/>
                                </Grid>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="R  /  Enter" Style="{StaticResource MonoText}"/><TextBlock Grid.Column="1" Text="Mark Reviewed / Resolved on the current clash" Style="{StaticResource HelperText}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Tab" Style="{StaticResource MonoText}"/><TextBlock Grid.Column="1" Text="Toggle between Navigator and Free-Fly" Style="{StaticResource HelperText}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Esc" Style="{StaticResource MonoText}"/><TextBlock Grid.Column="1" Text="Exit walkthrough, restore Revit's UI" Style="{StaticResource HelperText}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Xbox controller" Style="{StaticResource FieldLabel}"/>
                        <Border Background="#F7FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="8">
                            <StackPanel>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Left stick" Style="{StaticResource MonoText}"/><TextBlock Grid.Column="1" Text="Walk forward / strafe" Style="{StaticResource HelperText}"/>
                                </Grid>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Right stick" Style="{StaticResource MonoText}"/><TextBlock Grid.Column="1" Text="Look around" Style="{StaticResource HelperText}"/>
                                </Grid>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="LB  /  RB" Style="{StaticResource MonoText}"/><TextBlock Grid.Column="1" Text="Move down / up" Style="{StaticResource HelperText}"/>
                                </Grid>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="LT  /  RT" Style="{StaticResource MonoText}"/><TextBlock Grid.Column="1" Text="Speed up / slow down" Style="{StaticResource HelperText}"/>
                                </Grid>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="A  /  B" Style="{StaticResource MonoText}"/><TextBlock Grid.Column="1" Text="Next / previous clash" Style="{StaticResource HelperText}"/>
                                </Grid>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="X  /  Y" Style="{StaticResource MonoText}"/><TextBlock Grid.Column="1" Text="Mark Reviewed / Resolved" Style="{StaticResource HelperText}"/>
                                </Grid>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Start" Style="{StaticResource MonoText}"/><TextBlock Grid.Column="1" Text="Toggle Navigator / Free-Fly" Style="{StaticResource HelperText}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Back" Style="{StaticResource MonoText}"/><TextBlock Grid.Column="1" Text="Exit walkthrough" Style="{StaticResource HelperText}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Wired and wireless Xbox controllers both work via XInput. No driver install required."
                                   Style="{StaticResource HelperText}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
