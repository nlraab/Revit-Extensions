<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dbHMS Walkthrough"
        Height="780" Width="980"
        MinHeight="640" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="#F7FAFC"
        FontFamily="Segoe UI" FontSize="12"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        Focusable="True">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A202C"/><Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A5568"/><Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style x:Key="HelperText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#718096"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="MonoText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#2D3748"/>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2B6CB0"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="120"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/><Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="Padding" Value="12,6"/><Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,0,3"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- dbHMS branding header with active-mode indicator on the right -->
        <Border DockPanel.Dock="Top" Background="#2D3748" Padding="20,14">
            <Grid>
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="Walkthrough" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Free-fly through the building. WASD + mouse-look. Click into the look pad to capture."
                               Foreground="#CBD5E0" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="brd_active_indicator"
                            Background="#48BB78" CornerRadius="3" Padding="10,4"
                            Margin="0,0,16,0" Visibility="Collapsed">
                        <TextBlock Text="● ACTIVE" Foreground="White"
                                   FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Opacity="0.85">
                        <TextBlock Text="db" Foreground="#00BFFF" FontSize="32" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text=" | " Foreground="#7A8FA6" FontSize="32" FontWeight="Light" VerticalAlignment="Center"/>
                        <TextBlock Text="HMS" Foreground="#00BFFF" FontSize="32" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer: status + Render + Close -->
        <Border DockPanel.Dock="Bottom" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <TextBlock x:Name="txt_status" Text="Click Open Walkthrough View to begin."
                           Foreground="#4A5568" VerticalAlignment="Center" FontStyle="Italic"
                           HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btn_render" Content="📷 Render" Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="btn_close"  Content="Close"     Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body: visibility + bookmarks (left), look pad + controls (right) -->
        <Grid Margin="20,16,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="280"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- Left column -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Visibility -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Visibility" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="Toggle disciplines on/off as you walk through. Hide architectural to expose all the MEP."
                                       Style="{StaticResource HelperText}" Margin="0,0,0,6"/>
                            <CheckBox x:Name="chk_vis_mechanical"      Content="Mechanical"      IsChecked="True"/>
                            <CheckBox x:Name="chk_vis_electrical"      Content="Electrical"      IsChecked="True"/>
                            <CheckBox x:Name="chk_vis_plumbing"        Content="Plumbing"        IsChecked="True"/>
                            <CheckBox x:Name="chk_vis_fireprotection"  Content="Fire Protection" IsChecked="True"/>
                            <CheckBox x:Name="chk_vis_architectural"   Content="Architectural"   IsChecked="True"/>
                            <CheckBox x:Name="chk_vis_structural"      Content="Structural"      IsChecked="True"/>
                        </StackPanel>
                    </Border>

                    <!-- Bookmarks -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Bookmarks" Style="{StaticResource SectionHeader}"/>
                                <Button Grid.Column="1" x:Name="btn_save_bookmark"
                                        Content="+ Save current view"
                                        Style="{StaticResource MiniButton}"/>
                            </Grid>
                            <TextBlock Text="Saved per-project on the shared root — the team sees the same set."
                                       Style="{StaticResource HelperText}" Margin="0,0,0,6"/>
                            <ListBox x:Name="lb_bookmarks" Height="240"
                                     BorderBrush="#E2E8F0" BorderThickness="1"/>
                            <TextBlock x:Name="txt_bookmark_hint"
                                       Text="Double-click to jump. Right-click to delete."
                                       Style="{StaticResource HelperText}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Right column: look pad + speed/movement -->
            <DockPanel Grid.Column="2">

                <!-- Speed / settings -->
                <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Movement" Style="{StaticResource SectionHeader}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Speed" VerticalAlignment="Center"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,0,8,0"/>
                            <Slider Grid.Column="1" x:Name="sl_speed"
                                    Minimum="2" Maximum="60" Value="15"
                                    TickFrequency="2" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="txt_speed_value"
                                       Text="15 ft/s" VerticalAlignment="Center"
                                       Margin="8,0,0,0" MinWidth="60"
                                       Style="{StaticResource MonoText}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource HelperText}" Margin="0,8,0,0">
                            <Run Text="Hold "/><Run Text="Shift" FontWeight="SemiBold"/><Run Text=" to fly faster, "/><Run Text="Ctrl" FontWeight="SemiBold"/><Run Text=" to slow down."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Open Walkthrough View button (disabled once view is open) -->
                <Button DockPanel.Dock="Top" x:Name="btn_open_view"
                        Content="Open Walkthrough View"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch" Margin="0,0,0,10"
                        HorizontalContentAlignment="Center" MinWidth="0"
                        Padding="14,8"/>

                <!-- Look pad — click and drag inside to look around. Captures
                     mouse + keyboard. -->
                <Border Style="{StaticResource CardBorder}" Padding="0">
                    <Grid>
                        <Border x:Name="brd_lookpad"
                                Background="#1A202C" Cursor="Hand"
                                Focusable="True">
                            <Grid>
                                <StackPanel x:Name="sp_lookpad_hint"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="◎ LOOK PAD"
                                               Foreground="#A0AEC0" FontSize="22"
                                               FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="WASD works any time the window has focus."
                                               Foreground="#CBD5E0" FontSize="12"
                                               HorizontalAlignment="Center" Margin="0,12,0,8"/>
                                    <TextBlock Foreground="#E2E8F0" FontFamily="Consolas"
                                               FontSize="13" HorizontalAlignment="Center">
                                        <Run Text="WASD"/><Run Text=" — walk forward / strafe"  Foreground="#A0AEC0"/>
                                    </TextBlock>
                                    <TextBlock Foreground="#E2E8F0" FontFamily="Consolas"
                                               FontSize="13" HorizontalAlignment="Center">
                                        <Run Text="Q / E"/><Run Text=" — down / up"  Foreground="#A0AEC0"/>
                                    </TextBlock>
                                    <TextBlock Foreground="#E2E8F0" FontFamily="Consolas"
                                               FontSize="13" HorizontalAlignment="Center">
                                        <Run Text="Click+drag here"/><Run Text=" — look around"  Foreground="#A0AEC0"/>
                                    </TextBlock>
                                    <TextBlock Foreground="#E2E8F0" FontFamily="Consolas"
                                               FontSize="13" HorizontalAlignment="Center">
                                        <Run Text="Shift / Ctrl"/><Run Text=" — speed up / slow down"  Foreground="#A0AEC0"/>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock x:Name="txt_lookpad_active" Text="● LOOKING — drag to rotate, release to stop"
                                           VerticalAlignment="Top" HorizontalAlignment="Center"
                                           Margin="0,12,0,0"
                                           Foreground="#48BB78" FontWeight="Bold" FontSize="12"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
